test doc more-colors/hex: OK applies
  open ../fixtures/basic.docx
  call menu-open {"target":{"ribbon":["Design","Page Background","Page Color"]}}
  call menu-click {"label":"More Colors..."}
  assert dialog is more-colors
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"hex"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"C00000"}
