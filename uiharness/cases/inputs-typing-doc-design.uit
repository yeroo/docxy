test doc watermark/color: Up and Down step
  open ../fixtures/basic.docx
  call menu-open {"target":{"ribbon":["Design","Page Background","Watermark"]}}
  call menu-click {"label":"Custom Watermark..."}
  assert dialog is watermark
  call dialog-catalog-check {}
  call real-key {"key":"tab","to-field":"kind"}
  call real-key {"key":"down","times":1}
  call real-key {"key":"tab","to-field":"color"}
  call field-read {"dialog-field":"color"}
  assert reply.focused is true
  call real-key {"key":"down"}
  call real-key {"key":"down"}
  call field-read {"dialog-field":"color"}
  assert reply.index is not 0
  assert reply.index is not null
  call real-key {"key":"up","times":100}
  call field-read {"dialog-field":"color"}
  assert reply.index is 0
  call real-key {"key":"down"}
  call field-read {"dialog-field":"color"}
  assert reply.index is 1
  call real-key {"key":"escape"}

