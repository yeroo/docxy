test project invalid prompts preserve the schedule
  open ../fixtures/gantt-summary.xml
  # Duration is a cell edit (#370): a bad one stays open with its text.
  key down right
  assert cell is Duration
  type banana
  key enter
  assert cell_edit is banana
  assert status is Invalid duration (try 3d, 4h, 2w, 1mo)
  assert dirty is false
  assert bar_2 is on-track 0-0
  key escape
  assert cell_edit is none
  key alt t p
  type 999
  key enter
  assert status is No other task with ID 999
  assert dirty is false
  assert bar_2 is on-track 0-0
  key alt t c
  assert dialog is task-information
  call dialog-tab {"tab":"Advanced"}
  call dialog-set {"control":"ctype","value":"Must Start On"}
  call-error dialog-click {"button":"OK"} => MSO needs a constraint date
  assert dialog is task-information
  assert dirty is false
  assert bar_2 is on-track 0-0
  key escape
  assert dialog is none
  key ctrl+alt+z alt+down ctrl+n
  assert selected_task is 1
  assert tasks is 3
  key alt t c
  call dialog-tab {"tab":"Advanced"}
  call dialog-set {"control":"ctype","value":"Must Start On"}
  key ctrl+alt+z alt+down ctrl+n f10
  assert dialog is task-information
  assert tasks is 3
  assert dirty is false
  shot window
  key escape
  assert dialog is none
