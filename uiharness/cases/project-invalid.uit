test project invalid prompts preserve the schedule
  open ../fixtures/gantt-summary.xml
  key down alt t d
  type banana
  key enter
  assert prompt is none
  assert status is Couldn't read duration 'banana' (try 3d, 4h, 2w)
  assert dirty is false
  assert bar_2 is on-track 0-0
  key alt t p
  type 999
  key enter
  assert status is No other task with ID 999
  assert dirty is false
  assert bar_2 is on-track 0-0
  key alt t c
  key backspace backspace backspace backspace
  type mso
  key enter
  assert status is MSO needs a date, e.g. mso 2026-03-05
  assert dirty is false
  assert bar_2 is on-track 0-0
  key ctrl+alt+z alt+down ctrl+n
  assert selected_task is 1
  assert tasks is 3
  key alt t d
  type 3d
  key ctrl+enter alt+escape ctrl+backspace tab shift+tab f10
  assert prompt is duration:3d
  assert dirty is false
  shot window
  key escape
  assert prompt is none
