# File > Export > Change File Type (#635) and new documents from Word
# templates (#636). A harness instance opens no native dialog, so the Export
# page's types are refused in words; the save-as verb saves as each of them
# (save-as.uit). Every case opens a copy, so what it writes lands in the
# run's sandbox.

test a document's File screen has an Export page
  open copy:../fixtures/basic.docx
  call backstage {"action":"open"}
  assert reply.items.6 is Export
  call backstage-page {"page":"export"}
  assert reply.page is export
  shot window
  call backstage-page {"page":"new"}
  assert reply.page is new
  call backstage-page {"page":"export"}
  assert reply.page is export
  call backstage-page {"page":"open"}
  assert reply.page is open

test a workbook's File screen has no Export page
  open copy:../fixtures/basic.xlsx
  call backstage {"action":"open"}
  call-error backstage-page {"page":"export"} => the Export page is for a document tab

test a template opens as a new untitled document that never saves over it
  open copy:../fixtures/basic.docx
  type Dear reader
  call save-as {"path":"Letter.dotx"}
  assert reply.format is dotx
  call new-from-template {"path":"Letter.dotx"}
  assert reply.path is null
  assert reply.title is Letter1.docx
  assert reply.dirty is false
  assert title is Letter1.docx
  # Save asks for a name (refused in words here): the template is not
  # written, and the new document stays untitled and unsaved.
  type x
  key ctrl+s
  assert title is Letter1.docx
  assert dirty is true
  # The new document has no folder, so a relative path names none.
  call-error new-from-template {"path":"Letter.dotx"} => the active tab has never been saved, so a relative 'path' has no folder

test new-from-template refuses what is not a template
  open copy:../fixtures/basic.docx
  call-error new-from-template {"path":"basic.docx"} => is not a Word template
  call-error new-from-template {"path":"missing.dotx"} => cannot open the template
  assert title is basic.docx
