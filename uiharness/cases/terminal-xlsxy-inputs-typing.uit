test xlsxy xlsxy-cell: pastes
  open copy:../fixtures/basic.xlsx
  call real-key {"key":"down"}
  call real-key {"key":"ctrl+c"}
  call real-key {"key":"up"}
  call real-key {"key":"right","times":4}
  call real-key {"key":"f2"}
  call real-key {"key":"ctrl+v"}
  call field-read {"input":"xlsxy-cell"}
  assert reply.focused is true
  assert reply.value is exactly North
  assert reply.caret is 5

test xlsxy xlsxy-cell: Enter commits
  open copy:../fixtures/basic.xlsx
  call real-key {"key":"right","times":4}
  call real-key {"key":"f2"}
  call real-type {"text":"Ab1"}
  call real-key {"key":"enter"}
  call cell.get {"ref":"E1"}
  assert reply.text is exactly Ab1
  call wb.path {}
  assert reply.modified is true

test xlsxy xlsxy-cell: Escape cancels
  open copy:../fixtures/basic.xlsx
  call real-key {"key":"right","times":4}
  call real-key {"key":"f2"}
  call real-type {"text":"Ab1"}
  call real-key {"key":"escape"}
  call field-read {"input":"xlsxy-cell"}
  assert reply.value is null
  call cell.get {"ref":"E1"}
  assert reply.text is exactly ""
  call wb.path {}
  assert reply.modified is false


# ---- Backstage Save As's file name (Alt+F, Down x3, Enter), prefilled.
# The typing steps first empty it with Backspace (40 presses). F12 opens
# the minibuffer's Save As instead: that is xlsxy-prompt. Enter saves into
# the workbook's folder, where wb.open of the new name then succeeds.
test xlsxy xlsxy-save-as: focus
  open copy:../fixtures/basic.xlsx
  call real-key {"key":"alt+f"}
  call real-key {"key":"down","times":3}
  call real-key {"key":"enter"}
  call field-read {"input":"xlsxy-save-as"}
  assert reply.focused is true
  assert reply.at is not null
  assert reply.value is not null
  assert reply.selection is null

test xlsxy xlsxy-save-as: focus by click
  open copy:../fixtures/basic.xlsx
  call real-key {"key":"alt+f"}
  call real-key {"key":"down","times":3}
  call real-key {"key":"enter"}
  call real-key {"key":"tab"}
  call pointer-click {"input":"xlsxy-save-as"}
  call field-read {"input":"xlsxy-save-as"}
  assert reply.focused is true

test xlsxy xlsxy-save-as: types
  open copy:../fixtures/basic.xlsx
  call real-key {"key":"alt+f"}
  call real-key {"key":"down","times":3}
  call real-key {"key":"enter"}
  call real-key {"key":"backspace","times":40}
  call real-type {"text":"Ab1 "}
  call field-read {"input":"xlsxy-save-as"}
  assert reply.focused is true
  assert reply.value is exactly "Ab1 "
  assert reply.caret is 4

test xlsxy xlsxy-save-as: edits
  open copy:../fixtures/basic.xlsx
  call real-key {"key":"alt+f"}
  call real-key {"key":"down","times":3}
  call real-key {"key":"enter"}
  call real-key {"key":"backspace","times":40}
  call real-type {"text":"abcd"}
  call real-key {"key":"backspace"}
  call field-read {"input":"xlsxy-save-as"}
  assert reply.value is exactly abc
  call real-key {"key":"home"}
  call field-read {"input":"xlsxy-save-as"}
  assert reply.caret is 0
  call real-key {"key":"right"}
  call real-key {"key":"delete"}
  call field-read {"input":"xlsxy-save-as"}
  assert reply.value is exactly ac
  call real-key {"key":"end"}
  call real-key {"key":"left"}
  call field-read {"input":"xlsxy-save-as"}
  assert reply.caret is 1
  call real-type {"text":"X"}
  call field-read {"input":"xlsxy-save-as"}
  assert reply.value is exactly aXc
  assert reply.caret is 2

test xlsxy xlsxy-save-as: select-all replaces
  open copy:../fixtures/basic.xlsx
  call real-key {"key":"alt+f"}
  call real-key {"key":"down","times":3}
  call real-key {"key":"enter"}
  call real-key {"key":"backspace","times":40}
  call real-type {"text":"abcd"}
  call real-key {"key":"ctrl+a"}
  call field-read {"input":"xlsxy-save-as"}
  assert reply.focused is true
  assert reply.selection is [0,4]
  call real-type {"text":"X"}
  call field-read {"input":"xlsxy-save-as"}
  assert reply.value is exactly X

test xlsxy xlsxy-save-as: copies
  open copy:../fixtures/basic.xlsx
  call real-key {"key":"alt+f"}
  call real-key {"key":"down","times":3}
  call real-key {"key":"enter"}
  call real-key {"key":"backspace","times":40}
  call real-type {"text":"abcd"}
  call real-key {"key":"ctrl+a"}
  call real-key {"key":"ctrl+c"}
  call real-key {"key":"end"}
  call real-key {"key":"backspace","times":10}
  call field-read {"input":"xlsxy-save-as"}
  assert reply.value is exactly ""
  call real-key {"key":"ctrl+v"}
  call field-read {"input":"xlsxy-save-as"}
  assert reply.value is exactly abcd

test xlsxy xlsxy-save-as: pastes
  open copy:../fixtures/basic.xlsx
  call real-key {"key":"down"}
  call real-key {"key":"ctrl+c"}
  call real-key {"key":"up"}
  call real-key {"key":"alt+f"}
  call real-key {"key":"down","times":3}
  call real-key {"key":"enter"}
  call real-key {"key":"backspace","times":40}
  call real-key {"key":"ctrl+v"}
  call field-read {"input":"xlsxy-save-as"}
  assert reply.focused is true
  assert reply.value is exactly North
  assert reply.caret is 5

test xlsxy xlsxy-save-as: Enter commits
  open copy:../fixtures/basic.xlsx
  call real-key {"key":"alt+f"}
  call real-key {"key":"down","times":3}
  call real-key {"key":"enter"}
  call real-key {"key":"backspace","times":40}
  call real-type {"text":"saved-copy.xlsx"}
  call real-key {"key":"enter"}
  call wb.path {}
  assert reply.modified is false
  call wb.open {"path":"saved-copy.xlsx"}
  assert reply.sheets is 1

test xlsxy xlsxy-save-as: Escape cancels
  open copy:../fixtures/basic.xlsx
  call real-key {"key":"alt+f"}
  call real-key {"key":"down","times":3}
  call real-key {"key":"enter"}
  call real-key {"key":"backspace","times":40}
  call real-type {"text":"saved-copy.xlsx"}
  call real-key {"key":"escape"}
  call-error wb.open {"path":"saved-copy.xlsx"} => (os error 2)
