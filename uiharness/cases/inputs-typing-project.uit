# GENERATED from suite/docxy/src/dialog/catalog/entries.rs by
# `UPDATE_INPUTS_TYPING=1 cargo test --manifest-path suite/Cargo.toml
# inputs_typing_case_is_current`; do not edit by hand (#1029).
#
# Every editable field of every project dialog, typed into with real keys
# only: `real-key` and `real-type` go through the window's own input
# path, and the field is focused by a real click or by Tab. A test is
# one field and one step, named `<surface> <dialog>/<field>: <step>`.
# See qa/inputs-typing.md.

test project task-information: matches the catalogue
  open copy:../fixtures/project-clipboard.xml
  click C1
  key alt t c
  assert dialog is task-information
  call dialog-catalog-check {}
  call real-key {"key":"escape"}

test project task-information/name: focus by click
  open copy:../fixtures/project-clipboard.xml
  click C1
  key alt t c
  assert dialog is task-information
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"duration"}
  call field-read {"dialog-field":"name"}
  assert reply.focused is false
  call pointer-click {"dialog-field":"name"}
  call field-read {"dialog-field":"name"}
  assert reply.focused is true
  call real-key {"key":"escape"}

test project task-information/name: focus by Tab
  open copy:../fixtures/project-clipboard.xml
  click C1
  key alt t c
  assert dialog is task-information
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"duration"}
  call field-read {"dialog-field":"name"}
  assert reply.focused is false
  call real-key {"key":"tab","to-field":"name"}
  call field-read {"dialog-field":"name"}
  assert reply.focused is true
  call real-key {"key":"escape"}

test project task-information/name: types
  open copy:../fixtures/project-clipboard.xml
  click C1
  key alt t c
  assert dialog is task-information
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"name"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"Ab1 "}
  call field-read {"dialog-field":"name"}
  assert reply.value is "Ab1 "
  assert reply.caret is 4
  call real-key {"key":"escape"}

test project task-information/name: edits
  open copy:../fixtures/project-clipboard.xml
  click C1
  key alt t c
  assert dialog is task-information
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"name"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"abcd"}
  call real-key {"key":"backspace"}
  call field-read {"dialog-field":"name"}
  assert reply.value is abc
  call real-key {"key":"home"}
  call field-read {"dialog-field":"name"}
  assert reply.caret is 0
  call real-key {"key":"right"}
  call real-key {"key":"delete"}
  call field-read {"dialog-field":"name"}
  assert reply.value is ac
  call real-key {"key":"end"}
  call real-key {"key":"left"}
  call field-read {"dialog-field":"name"}
  assert reply.caret is 1
  call real-type {"text":"X"}
  call field-read {"dialog-field":"name"}
  assert reply.value is aXc
  assert reply.caret is 2
  call real-key {"key":"escape"}

test project task-information/name: select-all replaces
  open copy:../fixtures/project-clipboard.xml
  click C1
  key alt t c
  assert dialog is task-information
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"name"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"abcd"}
  call real-key {"key":"ctrl+a"}
  call field-read {"dialog-field":"name"}
  assert reply.selection.0 is 0
  assert reply.selection.1 is 4
  call real-type {"text":"X"}
  call field-read {"dialog-field":"name"}
  assert reply.value is X
  call real-key {"key":"escape"}

test project task-information/name: pastes
  open copy:../fixtures/project-clipboard.xml
  click C1
  key alt t c
  assert dialog is task-information
  call dialog-catalog-check {}
  call clipboard {"action":"write","text":"Pasted"}
  call pointer-click {"dialog-field":"name"}
  call real-key {"key":"ctrl+a"}
  call real-key {"key":"ctrl+v"}
  call field-read {"dialog-field":"name"}
