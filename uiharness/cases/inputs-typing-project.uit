test project task-information/name: OK applies
  open copy:../fixtures/project-clipboard.xml
  click C1
  key alt t c
  assert dialog is task-information
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"name"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"Ab1 "}
  call real-key {"key":"enter"}
  assert dialog is not task-information
  assert selected_name is Ab1
  click C1
  key alt t c
  assert dialog is task-information
  call dialog-catalog-check {}
  call field-read {"dialog-field":"name"}
  assert reply.value is Ab1
  call real-key {"key":"escape"}

