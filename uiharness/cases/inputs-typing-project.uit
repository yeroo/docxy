test project task-information/ttype: Up and Down step
  open copy:../fixtures/project-clipboard.xml
  click C1
  key alt t c
  assert dialog is task-information
  call dialog-catalog-check {}
  call pointer-click {"dialog-tab":"Advanced"}
  call real-key {"key":"tab","to-field":"ttype"}
  call field-read {"dialog-field":"ttype"}
  assert reply.focused is true
  call real-key {"key":"down"}
  call real-key {"key":"down"}
  call field-read {"dialog-field":"ttype"}
  assert reply.index is not 0
  assert reply.index is not null
  call real-key {"key":"up","times":100}
  call field-read {"dialog-field":"ttype"}
  assert reply.index is 0
  call real-key {"key":"down"}
  call field-read {"dialog-field":"ttype"}
  assert reply.index is 1
  call real-key {"key":"escape"}

