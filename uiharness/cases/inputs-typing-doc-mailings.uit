  call mail-attach {"path":"recipients.csv"}
  call ribbon-click {"tab":"Mailings","command":"matchfields"}
  assert dialog is mail-match-fields
  call dialog-catalog-check {}
  call real-key {"key":"tab","to-field":"state"}
  call field-read {"dialog-field":"state"}
  assert reply.focused is true
  call real-key {"key":"up","times":100}
  call field-read {"dialog-field":"state"}
  assert reply.index is 0
  call real-key {"key":"down"}
  call field-read {"dialog-field":"state"}
  assert reply.index is 1
  call real-key {"key":"escape"}

