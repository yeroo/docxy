  call pointer-click {"dialog-field":"to"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"2"}
  call real-type {"text":"x"}
  call field-read {"dialog-field":"to"}
  assert reply.value is 2
  call real-key {"key":"escape"}
