test doc mail-find/find: OK applies
  open ../fixtures/basic.docx
  call mail-attach {"path":"recipients.csv"}
  call ribbon-click {"tab":"Mailings","command":"findrecipient"}
  assert dialog is mail-find
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"find"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"John"}
  call real-key {"key":"enter"}
  assert status is Found in record 2
  assert mail.record is 2
  call real-key {"key":"escape"}

test doc mail-find/find: Escape cancels
  open ../fixtures/basic.docx
  call mail-attach {"path":"recipients.csv"}
  call ribbon-click {"tab":"Mailings","command":"findrecipient"}
  assert dialog is mail-find
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"find"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"Esc9"}
  call real-key {"key":"escape"}
  assert dialog is not mail-find
  call mail-attach {"path":"recipients.csv"}
  call ribbon-click {"tab":"Mailings","command":"findrecipient"}
  assert dialog is mail-find
  call dialog-catalog-check {}
  call field-read {"dialog-field":"find"}
  assert reply.value is not Esc9
  call real-key {"key":"escape"}

