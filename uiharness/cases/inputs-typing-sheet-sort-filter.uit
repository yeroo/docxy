  click A1
  call ribbon-click {"tab":"Data","command":"Advanced"}
  assert dialog is advanced-filter
  call dialog-catalog-check {}
  call clipboard {"action":"write","text":"before"}
  call pointer-click {"dialog-field":"copy"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"abcd"}
  call real-key {"key":"ctrl+a"}
  call real-key {"key":"ctrl+c"}
  call clipboard {"action":"read"}
  assert reply.text is abcd
  call real-key {"key":"escape"}

test sheet advanced-filter/copy: Escape cancels
  open ../fixtures/basic.xlsx
  click E1
  type Region
  key enter
  type East
  key enter
  click A1
  call ribbon-click {"tab":"Data","command":"Advanced"}
  assert dialog is advanced-filter
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"copy"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"Esc9"}
  call real-key {"key":"escape"}
  assert dialog is not advanced-filter
  click E1
  type Region
  key enter
  type East
  key enter
  click A1
  call ribbon-click {"tab":"Data","command":"Advanced"}
  assert dialog is advanced-filter
  call dialog-catalog-check {}
  call field-read {"dialog-field":"copy"}
  assert reply.value is not Esc9
  call real-key {"key":"escape"}

