test sheet filter-menu/search: types
  open ../fixtures/basic.xlsx
  click A2
  key ctrl+shift+l
  shot filter-button:A
  call pointer-click {"region":"filter-button:A"}
  assert dialog is filter-menu
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"search"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"Ea"}
  call field-read {"dialog-field":"search"}
  assert reply.value is Ea
  assert reply.caret is 2
  call real-key {"key":"escape"}

test sheet filter-menu/search: edits
  open ../fixtures/basic.xlsx
  click A2
  key ctrl+shift+l
  shot filter-button:A
  call pointer-click {"region":"filter-button:A"}
  assert dialog is filter-menu
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"search"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"abcd"}
  call real-key {"key":"backspace"}
  call field-read {"dialog-field":"search"}
  assert reply.value is abc
  call real-key {"key":"home"}
  call field-read {"dialog-field":"search"}
  assert reply.caret is 0
  call real-key {"key":"right"}
  call real-key {"key":"delete"}
  call field-read {"dialog-field":"search"}
  assert reply.value is ac
  call real-key {"key":"end"}
  call real-key {"key":"left"}
  call field-read {"dialog-field":"search"}
  assert reply.caret is 1
  call real-type {"text":"X"}
  call field-read {"dialog-field":"search"}
  assert reply.value is aXc
  assert reply.caret is 2
  call real-key {"key":"escape"}

test sheet filter-menu/search: select-all replaces
  open ../fixtures/basic.xlsx
  click A2
  key ctrl+shift+l
  shot filter-button:A
  call pointer-click {"region":"filter-button:A"}
  assert dialog is filter-menu
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"search"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"abcd"}
  call real-key {"key":"ctrl+a"}
  call field-read {"dialog-field":"search"}
  assert reply.selection.0 is 0
  assert reply.selection.1 is 4
  call real-type {"text":"X"}
  call field-read {"dialog-field":"search"}
  assert reply.value is X
  call real-key {"key":"escape"}

test sheet filter-menu/search: pastes
  open ../fixtures/basic.xlsx
  click A2
  key ctrl+shift+l
  shot filter-button:A
  call pointer-click {"region":"filter-button:A"}
  assert dialog is filter-menu
  call dialog-catalog-check {}
  call clipboard {"action":"write","text":"Pasted"}
  call pointer-click {"dialog-field":"search"}
  call real-key {"key":"ctrl+a"}
  call real-key {"key":"ctrl+v"}
  call field-read {"dialog-field":"search"}
  assert reply.value is Pasted
  call real-key {"key":"escape"}

test sheet filter-menu/search: copies
  open ../fixtures/basic.xlsx
  click A2
  key ctrl+shift+l
  shot filter-button:A
  call pointer-click {"region":"filter-button:A"}
  assert dialog is filter-menu
  call dialog-catalog-check {}
  call clipboard {"action":"write","text":"before"}
  call pointer-click {"dialog-field":"search"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"abcd"}
  call real-key {"key":"ctrl+a"}
  call real-key {"key":"ctrl+c"}
  call clipboard {"action":"read"}
  assert reply.text is abcd
  call real-key {"key":"escape"}

test sheet filter-menu/search: Escape cancels
  open ../fixtures/basic.xlsx
  click A2
  key ctrl+shift+l
  shot filter-button:A
  call pointer-click {"region":"filter-button:A"}
  assert dialog is filter-menu
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"search"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"Esc9"}
  call real-key {"key":"escape"}
  assert dialog is not filter-menu
  shot filter-button:A
  call pointer-click {"region":"filter-button:A"}
  assert dialog is filter-menu
  call dialog-catalog-check {}
  call field-read {"dialog-field":"search"}
  assert reply.value is not Esc9
  call real-key {"key":"escape"}

