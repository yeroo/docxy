test sheet sort-warning: matches the catalogue
  open ../fixtures/basic.xlsx
  click B2
  click B5 shift
  call ribbon-click {"tab":"Data","command":"Sort Z to A"}
  assert dialog is sort-warning
  call dialog-catalog-check {}
  call real-key {"key":"escape"}
