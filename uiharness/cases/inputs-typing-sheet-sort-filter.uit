test sheet top10-autofilter/unit: Up and Down step
  open ../fixtures/basic.xlsx
  click A2
  key ctrl+shift+l
  shot filter-button:B
  call pointer-click {"region":"filter-button:B"}
  call dialog-set {"control":"typed","value":"Top 10..."}
  call dialog-click {"button":"Apply Filter"}
  assert dialog is top10-autofilter
  call dialog-catalog-check {}
  call real-key {"key":"tab","to-field":"unit"}
  call field-read {"dialog-field":"unit"}
  assert reply.focused is true
  call real-key {"key":"up","times":100}
  call field-read {"dialog-field":"unit"}
  assert reply.index is 0
  call real-key {"key":"down"}
  call field-read {"dialog-field":"unit"}
  assert reply.index is 1
  call real-key {"key":"escape"}

