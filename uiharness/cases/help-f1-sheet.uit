# F1 on a hovered sheet ribbon command (#1869): the command's page in the
# Excel manual, by its `SheetCmd` id, else its ribbon tab's area page, else
# the root. The runner installs the helpdocs excel fixture as this instance's
# Excel manual: `excel` (the root), `home` (area home, keys bold),
# `clipboard` (keys pane:office-clipboard) and `chart-pane` (keys
# pane:chart). Apart
# from help-docs.uit, which needs no Excel manual installed. Each step closes
# the Help tab it opened (Ctrl+W on it).
manual excel ../../helpdocs/tests/fixture/excel

test F1 with focus on a sheet ribbon command opens that command's page
  open ../fixtures/basic.xlsx
  call ribbon-layout {"tab":"Home"}
  call pointer-move {"to":"ribbon-cmd:bold"}
  call real-key {"key":"f1"}
  call help-read {}
  assert reply.open is true
  assert reply.editor is excel
  assert reply.page is home
  assert reply.via is exact
  call real-key {"key":"ctrl+w"}
  # A Large command no page keys, on a tab with no area page of its own:
  # View > New Window, the root.
  call ribbon-layout {"tab":"View"}
  call pointer-move {"to":"ribbon-cmd:newwindow"}
  call real-key {"key":"f1"}
  call help-read {}
  assert reply.page is excel
  assert reply.via is root
  call real-key {"key":"ctrl+w"}
  # The pointer on the grid, on no command: Home's area page.
  call ribbon-layout {"tab":"Home"}
  call pointer-move {"to":"cell:B3"}
  call real-key {"key":"f1"}
  call help-read {}
  assert reply.page is home
  assert reply.via is area
  call real-key {"key":"ctrl+w"}
  # The pointer left the window over Bold: no command, the area page.
  call pointer-move {"to":"ribbon-cmd:bold"}
  call pointer-leave {}
  call real-key {"key":"f1"}
  call help-read {}
  assert reply.page is home
  assert reply.via is area
  call real-key {"key":"ctrl+w"}

test F1 with the keyboard in a sheet pane opens that pane's page
  # #2077: a press in the Office Clipboard, then F1. The clipboard is
  # emptied first, so the press can land on no item (a click pastes one).
  open ../fixtures/basic.xlsx
  call office-clipboard {"action":"clear-all"}
  call office-clipboard {"action":"open"}
  assert office_clipboard is 0
  call pointer-click {"region":"pane:office-clipboard"}
  call real-key {"key":"f1"}
  call help-read {}
  assert reply.open is true
  assert reply.editor is excel
  assert reply.page is clipboard
  assert reply.via is exact
  call real-key {"key":"ctrl+w"}
  # A press on the grid: Home's area page.
  call ribbon-layout {"tab":"Home"}
  call pointer-click {"region":"cell:B3"}
  call real-key {"key":"f1"}
  call help-read {}
  assert reply.page is home
  assert reply.via is area
  call real-key {"key":"ctrl+w"}
  call office-clipboard {"action":"close"}

test F1 in a Chart panel field opens the Chart pane's page
  # The one pane whose field takes the keys (`range_edit`): F1 there opens
  # `pane:chart`'s page, where any other entry swallows F1. The Help tab is
  # a tab switch, which drops the field and closes the panel as Ctrl+Tab
  # does, so F1 commits the field first, as Enter does.
  open ../fixtures/basic.xlsx
  select chart 0
  assert panel_chart is 0
  focus chart-title
  assert field is chart-title
  key ctrl+a
  type Help Title
  assert field_text is Help Title
  call real-key {"key":"f1"}
  call help-read {}
  assert reply.open is true
  assert reply.editor is excel
  assert reply.page is chart-pane
  assert reply.via is exact
  call real-key {"key":"ctrl+w"}
  assert field is nothing
  assert panel_chart is nothing
  # The typed title was committed: the field opens on it.
  select chart 0
  focus chart-title
  assert field_text is Help Title
  key escape
  # Text the field refuses: F1 commits nothing, opens no Help tab, and the
  # field stays open with its text.
  focus categories
  key ctrl+a
  type not a range
  call real-key {"key":"f1"}
  call help-read {}
  assert reply.open is false
  assert field is categories
  assert field_text is not a range
  assert panel_chart is 0
  key escape
