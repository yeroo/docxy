# #588: the window title is the active tab's Project-style title. Run
# against a fresh harness instance: the cases share it, and tab 0 is the
# sample.docx it starts with.

test issue 588 the window title is the active tab's stem  -  docxy
  call tab-list {}
  assert reply.active is 0
  assert reply.tabs.0.title is sample.docx
  assert reply.window_title is sample  -  docxy
  call proj.new {}
  assert reply.name is Project1
  call tab-list {}
  assert reply.active is 1
  assert reply.tabs.1.title is Project1
  assert reply.tabs.1.kind is project
  assert reply.window_title is Project1  -  docxy
  call proj.new {}
  assert reply.name is Project2
  call tab-list {}
  assert reply.tabs.2.title is Project2
  assert reply.window_title is Project2  -  docxy
  call close-tab {"answer":"discard"}
  assert tabs is 2
  call proj.new {}
  assert reply.name is Project3
  call tab-list {}
  assert tabs is 3
  assert reply.tabs.2.title is Project3
  assert reply.window_title is Project3  -  docxy

test issue 588 a saved plan's window title is the file's stem
  open copy:../fixtures/gantt-summary.xml
  assert title is gantt-summary.xml
  call tab-list {}
  assert reply.window_title is gantt-summary  -  docxy

test issue 588 r1 a long window title yields to the tab strip on a narrow window
  open copy:"../fixtures/basic.docx" as a very long window title that must yield to the tab strip.docx
  call window-size {"w":500,"h":700}
  shot window
  call title-bar {}
  assert reply.overflow is true
  assert reply.theme_visible is true
  assert reply.controls_clear is true
  assert reply.active_visible is true
  call tab-list {}
  assert reply.window_title is a very long window title that must yield to the tab strip  -  docxy

# #1143: the title the OS window holds (the last string handed to
# set_window_title), not one recomputed from the tabs. The window sets it in
# its render, so each step that changes the title is followed by a shot,
# which paints the window before the next read.
test issue 1143 the OS window title follows the active tab
  open copy:"../fixtures/basic.docx" as title1143.docx
  shot window
  call tab-list {}
  assert reply.os_title is title1143  -  docxy
  open copy:../fixtures/basic.xlsx
  shot window
  call tab-list {}
  assert reply.os_title is basic  -  docxy
  call tab-select {"tab":"title1143.docx"}
  shot window
  call tab-list {}
  assert reply.os_title is title1143  -  docxy
  call tab-select {"tab":"basic.xlsx"}
  call save-as {"path":"renamed1143.xlsx"}
  shot window
  call tab-list {}
  assert reply.os_title is renamed1143  -  docxy
  call close-tab {"answer":"discard"}
  shot window
  call tab-list {}
  assert reply.os_title is title1143  -  docxy
