# GENERATED from suite/docxy/src/dialog/catalog/entries.rs by
# `UPDATE_INPUTS_TYPING=1 cargo test --manifest-path suite/Cargo.toml
# inputs_typing_case_is_current`; do not edit by hand (#1029).
#
# Every editable field of every sheet dialog, typed into with real keys
# only: `real-key` and `real-type` go through the window's own input
# path, and the field is focused by a real click or by Tab. A test is
# one field and one step, named `<surface> <dialog>/<field>: <step>`.
# See qa/inputs-typing.md.

test sheet calc-options: matches the catalogue
  open ../fixtures/basic.xlsx
  call ribbon-click {"tab":"Formulas","command":"More Calculation Options..."}
  assert dialog is calc-options
  call dialog-catalog-check {}
  call real-key {"key":"escape"}

test sheet calc-options/max-iterations: focus by click
  open ../fixtures/basic.xlsx
  call ribbon-click {"tab":"Formulas","command":"More Calculation Options..."}
  assert dialog is calc-options
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"max-iterations"}
  call field-read {"dialog-field":"max-iterations"}
  assert reply.focused is true
  call real-key {"key":"escape"}

test sheet calc-options/max-iterations: focus by Tab
  open ../fixtures/basic.xlsx
  call ribbon-click {"tab":"Formulas","command":"More Calculation Options..."}
  assert dialog is calc-options
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"max-change"}
  call field-read {"dialog-field":"max-iterations"}
  assert reply.focused is false
  call real-key {"key":"tab","to-field":"max-iterations"}
  call field-read {"dialog-field":"max-iterations"}
  assert reply.focused is true
  call real-key {"key":"escape"}

test sheet calc-options/max-iterations: types
  open ../fixtures/basic.xlsx
  call ribbon-click {"tab":"Formulas","command":"More Calculation Options..."}
  assert dialog is calc-options
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"max-iterations"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"50"}
  call field-read {"dialog-field":"max-iterations"}
  assert reply.value is 50
  assert reply.caret is 2
  call real-key {"key":"escape"}

test sheet calc-options/max-iterations: edits
  open ../fixtures/basic.xlsx
  call ribbon-click {"tab":"Formulas","command":"More Calculation Options..."}
  assert dialog is calc-options
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"max-iterations"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"1234"}
  call real-key {"key":"backspace"}
  call field-read {"dialog-field":"max-iterations"}
  assert reply.value is 123
  call real-key {"key":"home"}
  call field-read {"dialog-field":"max-iterations"}
  assert reply.caret is 0
  call real-key {"key":"right"}
  call real-key {"key":"delete"}
  call field-read {"dialog-field":"max-iterations"}
  assert reply.value is 13
  call real-key {"key":"end"}
  call real-key {"key":"left"}
  call field-read {"dialog-field":"max-iterations"}
  assert reply.caret is 1
  call real-type {"text":"9"}
  call field-read {"dialog-field":"max-iterations"}
  assert reply.value is 193
  assert reply.caret is 2
  call real-key {"key":"escape"}

test sheet calc-options/max-iterations: select-all replaces
  open ../fixtures/basic.xlsx
  call ribbon-click {"tab":"Formulas","command":"More Calculation Options..."}
  assert dialog is calc-options
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"max-iterations"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"1234"}
  call real-key {"key":"ctrl+a"}
  call field-read {"dialog-field":"max-iterations"}
  assert reply.selection.0 is 0
  assert reply.selection.1 is 4
  call real-type {"text":"9"}
  call field-read {"dialog-field":"max-iterations"}
  assert reply.value is 9
  call real-key {"key":"escape"}

test sheet calc-options/max-iterations: pastes
  open ../fixtures/basic.xlsx
  call ribbon-click {"tab":"Formulas","command":"More Calculation Options..."}
