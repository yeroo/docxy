# The harness's private clipboard and the `clipboard` verb (#699), and the
# document copy/paste that goes through it (#755).

# Keep this case first: it is the instance's clipboard before anything is
# copied. It only tells a private clipboard from the OS one when the real
# clipboard holds text, which it usually does on a desktop.
test a harness instance starts with an empty private clipboard
  open ../fixtures/basic.xlsx
  call clipboard {"action":"read"}
  assert reply.text is nothing
  assert reply.app.kind is none

test a sheet copy puts its cells on the clipboard for the next paste
  open ../fixtures/basic.xlsx
  click A1
  click B2 shift
  key ctrl+c
  call clipboard {"action":"read"}
  assert reply.app.kind is grid
  assert reply.app.rows is 2
  assert reply.app.cols is 2
  click D2
  key ctrl+v
  assert cell D2 is Region
  assert cell E3 is 10

test text another app copied wins over the older grid clip
  open ../fixtures/basic.xlsx
  click A1
  key ctrl+c
  call clipboard {"action":"write","text":"7\t8\n9\t10\n"}
  assert reply.app.kind is none
  click D8
  key ctrl+v
  assert cell D8 is 7
  assert cell E8 is 8
  assert cell D9 is 9
  assert cell E9 is 10

test a copy with no text in it is newer than the grid clip
  # An empty write reads as an image or empty copy does: an item, no text.
  open ../fixtures/basic.xlsx
  click A1
  key ctrl+c
  call clipboard {"action":"write","text":""}
  assert reply.text is nothing
  assert reply.app.kind is none
  click D8
  key ctrl+v
  assert cell D8 is nothing
  assert dirty is false

# Keep this case before the document copies: the cases share one app, and it
# is the only one that pastes with no document clip made yet.
test text another app pastes into a document before any document copy
  open copy:../fixtures/basic.docx
  call clipboard {"action":"write","text":"pasted"}
  call clipboard {"action":"read"}
  assert reply.app.kind is none
  key ctrl+v
  assert text is pasted
  assert dirty is true

test a document copy puts its text on the clipboard
  open copy:../fixtures/basic.docx
  type hello world
  call selection-set {"start":0,"end":5}
  key ctrl+c
  call clipboard {"action":"read"}
  assert reply.text is hello
  assert reply.app.kind is doc
  assert reply.app.text is hello

test a document copy pastes back with its formatting
  open copy:../fixtures/basic.docx
  type hello
  call selection-set {"start":0,"end":5}
  call ribbon-click {"tab":"Home","command":"Bold"}
  key ctrl+c
  key end
  key ctrl+v
  assert text is hellohello
  call selection-set {"start":7,"end":7}
  assert run.bold is true

test text another app copied wins over the older document clip
  open copy:../fixtures/basic.docx
  type hello
  call selection-set {"start":0,"end":5}
  key ctrl+c
  call clipboard {"action":"write","text":"-other"}
  assert reply.app.kind is none
  key end
  key ctrl+v
  assert text is hello-other

test a copy with no text in it is newer than the document clip
  open copy:../fixtures/basic.docx
  type hello
  call selection-set {"start":0,"end":5}
  key ctrl+c
  key ctrl+s
  assert dirty is false
  call clipboard {"action":"write","text":""}
  assert reply.app.kind is none
  key end
  key ctrl+v
  assert text is hello
  assert dirty is false

test a document cut with nothing selected leaves the document clean
  open copy:../fixtures/basic.docx
  key ctrl+x
  assert dirty is false

test the clipboard verb refuses what it does not do
  open ../fixtures/basic.xlsx
  call-error clipboard {"action":"paste-special"} => press the app's own key (key ctrl+alt+v)
  call-error clipboard {"action":"copy"} => press the app's own key
  call-error clipboard {"action":"write"} => text
  call-error clipboard {"action":"shuffle"} => unknown clipboard action

# #664: Excel's sheet clipboard. Each case builds the issue's book in an
# unused corner of basic.xlsx: M20 1, M21 2, N20 =M20*10, N21 =M21*10,
# P20:P25 old, T20 =M20+N20.

test a sheet copy tiles over a paste area of whole copies
  open copy:../fixtures/basic.xlsx
  click M20
  type 1
  key enter
  type 2
  key enter
  click N20
  type =M20*10
  key enter
  type =M21*10
  key enter
  click N20
  click N21 shift
  key ctrl+c
  click P20
  click P25 shift
  key ctrl+v
  call cell {"cell":"P20"}
  assert reply.value is =O20*10
  call cell {"cell":"P25"}
  assert reply.value is =O25*10
  assert cell P26 is nothing
  assert range is P20:P25
  assert sel is P20

test a sheet paste area that is not whole copies is refused
  open copy:../fixtures/basic.xlsx
  click N20
  type =M20*10
  key enter
  type =M21*10
  key enter
  click P20
  type old
  key enter
  click N20
  click N21 shift
  key ctrl+c
  click P20
  click P22 shift
  key ctrl+v
  assert status is The information cannot be pasted because the Copy area and the paste area aren't the same size and shape.
  assert cell P20 is old

test a pasted sheet copy translates its references
  open copy:../fixtures/basic.xlsx
  click N20
  type =M20*10
  key enter
  type =M21*10
  key enter
  click N20
  click N21 shift
  key ctrl+c
  click Q20
  key ctrl+v
  call cell {"cell":"Q20"}
  assert reply.value is =P20*10
  call cell {"cell":"Q21"}
  assert reply.value is =P21*10

test enter pastes a sheet copy and ends copy mode
  open copy:../fixtures/basic.xlsx
  click N20
  type =M20*10
  key enter
  type =M21*10
  key enter
  click N20
  click N21 shift
  key ctrl+c
  click R20
  key enter
  call cell {"cell":"R21"}
  assert reply.value is =Q21*10
  assert sel is R20
  call clipboard {"action":"read"}
  assert reply.app.kind is none
  click S20
  key ctrl+v
  assert cell S20 is nothing

test escape ends sheet copy mode
  open copy:../fixtures/basic.xlsx
  click N20
  type =M20*10
  key enter
  click N20
  key ctrl+c
  key escape
  call clipboard {"action":"read"}
  assert reply.app.kind is none
  click S20
  key ctrl+v
  assert cell S20 is nothing
  # Enter moves again once copy mode is over.
  key enter
  assert sel is S21

test a sheet cut moves its cells and the references to them, once
  open copy:../fixtures/basic.xlsx
  click M20
  type 1
  key enter
  click N20
  type =M20*10
  key enter
  click T20
  type =M20+N20
  key enter
  click M20
  click N20 shift
  key ctrl+x
  assert cell M20 is 1
  click M30
  key ctrl+v
  assert cell M30 is 1
  call cell {"cell":"N30"}
  assert reply.value is =M30*10
  assert cell M20 is nothing
  assert cell N20 is nothing
  call cell {"cell":"T20"}
  assert reply.value is =M30+N30
  assert cell T20 is 11
  click V20
  key ctrl+v
  assert cell V20 is nothing
  key ctrl+z
  assert cell M20 is 1
  assert cell M30 is nothing
  call cell {"cell":"T20"}
  assert reply.value is =M20+N20

test an edit after a sheet cut cancels it
  open copy:../fixtures/basic.xlsx
  click M20
  type 1
  key enter
  click M20
  key ctrl+x
  click M20
  type 5
  key enter
  click M30
  key ctrl+v
  assert cell M30 is nothing
  assert cell M20 is 5
  assert status is The cut was cancelled: the workbook changed since it was cut (nothing pasted)

# #664 r1: an edit ends copy mode, as typing into a cell does in Excel, so a
# later Enter moves instead of pasting the old clip.
test an edit after a sheet copy ends copy mode and enter moves
  open copy:../fixtures/basic.xlsx
  click M20
  type 1
  key enter
  click M20
  key ctrl+c
  click P20
  type 5
  key enter
  assert sel is P21
  key enter
  assert sel is P22
  assert cell P21 is nothing
  call clipboard {"action":"read"}
  assert reply.app.kind is none
  click Q20
  key ctrl+v
  assert cell Q20 is nothing

test a sheet copy pastes with ctrl+v again and again, then enter ends it
  open copy:../fixtures/basic.xlsx
  click M20
  type 1
  key enter
  click M20
  key ctrl+c
  click P20
  key ctrl+v
  assert cell P20 is 1
  click Q20
  key ctrl+v
  assert cell Q20 is 1
  click R20
  key enter
  assert cell R20 is 1
  assert sel is R20
  call clipboard {"action":"read"}
  assert reply.app.kind is none

test an edit after a sheet cut lets enter move
  open copy:../fixtures/basic.xlsx
  click M20
  type 1
  key enter
  click M20
  key ctrl+x
  click P20
  type 5
  key enter
  assert sel is P21
  key enter
  assert sel is P22
  click M30
  key ctrl+v
  assert cell M30 is nothing
  assert cell M20 is 1
  assert status is The cut was cancelled: the workbook changed since it was cut (nothing pasted)

# #664 r2: a protected sheet refuses a paste as silently as it refuses
# typing, so Enter in copy mode moves, and copy mode stays on.
test enter in copy mode on a protected sheet moves
  open copy:../fixtures/basic.xlsx
  call ribbon-click {"tab":"Review","command":"Protect Sheet"}
  click A1
  key ctrl+c
  click P20
  key enter
  assert sel is P21
  assert cell P20 is nothing
  call clipboard {"action":"read"}
  assert reply.app.kind is grid

# #669: Paste Special, the gallery, Paste Options and the Office Clipboard,
# in an unused corner (M30:T40).
test paste special pastes values, operations and transposed
  open ../fixtures/basic.xlsx
  click M30
  type 2
  key enter
  type =M30*3
  key enter
  click M30
  click M31 shift
  key ctrl+c
  click O30
  key ctrl+alt+v
  assert dialog is paste-special
  call dialog-set {"control":"paste","value":"Values"}
  call dialog-set {"control":"transpose","value":true}
  call dialog-click {"button":"OK"}
  assert cell O30 is 2
  assert cell P30 is 6
  call cell {"cell":"P30"}
  assert reply.value is 6

test the gallery and the Paste Options button paste another way
  open ../fixtures/basic.xlsx
  click M32
  type 5
  key enter
  type =M32*10
  key enter
  click M33
  key ctrl+c
  click O33
  key ctrl+v
  call cell {"cell":"O33"}
  assert reply.value is =O32*10
  assert paste_options is Paste
  call menu-open {"target":{"grid":"paste-options"}}
  call menu-click {"label":"Values"}
  call cell {"cell":"O33"}
  # Values pastes what the copied M33 shows: =M32*10 is 50.
  assert reply.value is 50
  assert paste_options is Values
  click Q33
  call menu-open {"target":{"ribbon":["Home","Clipboard","Paste"]}}
  call menu-click {"label":"Paste Link"}
  call cell {"cell":"Q33"}
  assert reply.value is =$M$33
  assert paste_options is Paste Link
  # Esc dismisses the button (R3).
  key escape
  assert paste_options is null

test the Office Clipboard keeps copies and pastes them as values
  open ../fixtures/basic.xlsx
  # The pane is the app's, not the workbook's: it keeps the copies earlier
  # cases made, as Excel's does across workbooks.
  call office-clipboard {"action":"clear-all"}
  click A2
  key ctrl+c
  click B2
  key ctrl+c
  call office-clipboard {"action":"open"}
  assert reply.open is true
  assert office_clipboard is 2
  click M40
  call office-clipboard {"action":"paste","index":1}
  assert cell M40 is North
  call office-clipboard {"action":"clear-all"}
  assert office_clipboard is 0
