test document state follows keys, selections, ribbon commands and backstage
  open ../fixtures/basic.docx
  type hello
  assert text is hello
  assert caret.offset is 5
  key home
  assert caret.offset is 0
  key shift+end
  assert sel.start is 0
  assert sel.end is 5
  assert anchor.offset is 0
  call selection-set {"start":5,"end":1}
  assert sel.start is 1
  assert sel.end is 5
  assert anchor.offset is 5
  assert caret.offset is 1
  call ribbon-read {}
  assert reply.tabs.0.name is File
  assert reply.tabs.1.name is Home
  assert reply.qat.0.label is Undo
  call ribbon-click {"tab":"Home","command":"Bold"}
  call selection-set {"start":2,"end":2}
  assert run.bold is true
  call selection-set {"start":0,"end":0}
  assert run.bold is false
  call ribbon-click {"tab":"View","command":"ruler"}
  assert view.ruler is true
  call ribbon-click {"tab":"View","command":"showhide"}
  assert view.marks is true
  call doc {}
  assert reply.text is hello
  assert reply.run.bold is false
  call status-read {}
  assert reply.items.0.text is loaded
  call backstage {"action":"open"}
  assert reply.open is true
  assert reply.items.0 is Back
  call backstage {"action":"read"}
  assert reply.open is true
  call backstage {"action":"close"}
  assert reply.open is false

test table context follows the caret and exposes Table ribbon
  open ../fixtures/doc-table.docx
  call selection-set {"start":7,"end":7}
  assert para.index is 1
  call ribbon-read {}
  assert reply.tabs.5.name is Table
  key alt t escape escape
  assert ribbon_tab is Table
  call selection-set {"start":0,"end":0}
  assert ribbon_tab is Home
