# Task > Properties > Information... is the Task Information dialog (#1368):
# General, Predecessors, Resources, Advanced and Notes. Every key and click
# into the dialog is real input (`real-key`, `real-type`, `pointer-click`);
# `open`, `click <cell>` and the KeyTips that open it are setup. The generated
# `inputs-typing-project.uit` types into each field; these cases cover what
# OK does with them. Each opens its own copy of project-clipboard.xml (tasks A
# and B, both As Soon As Possible, 2d each).

test project task information: OK writes General, Advanced and Notes as one undo step
  open copy:../fixtures/project-clipboard.xml
  click C2
  assert selected_name is B
  assert dirty is false
  key alt t c
  assert dialog is task-information
  call dialog-read {}
  assert reply.tab is General
  assert reply.title is Task Information
  call pointer-click {"dialog-field":"name"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"Build"}
  call pointer-click {"dialog-field":"percent"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"50"}
  call pointer-click {"dialog-field":"priority"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"800"}
  call pointer-click {"dialog-tab":"Advanced"}
  call real-key {"key":"tab","to-field":"ctype"}
  call real-key {"key":"down","times":4}
  call pointer-click {"dialog-field":"cdate"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"2026-01-19"}
  call pointer-click {"dialog-field":"deadline"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"2026-02-27"}
  call pointer-click {"dialog-tab":"Notes"}
  call pointer-click {"dialog-field":"notes"}
  call real-type {"text":"check\\nit"}
  call real-key {"key":"enter"}
  assert dialog is none
  assert dirty is true
  assert selected_name is Build
  assert undo_depth is 1
  call task.get {"uid":2,"fields":["Priority","Deadline","Notes"]}
  assert reply.start is 2026-01-19 08:00
  assert reply.fields.Priority.value is 800
  assert reply.fields.Deadline.value is 2026-02-27 00:00
  key ctrl+z
  assert selected_name is B
  assert undo_depth is 0
  call task.get {"uid":2,"fields":["Priority","Deadline","Notes"]}
  assert reply.start is 2026-01-05 08:00
  assert reply.fields.Priority.value is 500
  assert reply.fields.Deadline.value is null

test project task information: Notes... opens on the Notes page and an unchanged OK stays clean
  open copy:../fixtures/project-clipboard.xml
  click C1
  call ribbon-click {"tab":"Task","command":"Notes..."}
  assert dialog is task-information
  call dialog-read {}
  assert reply.tab is Notes
  call real-key {"key":"enter"}
  assert dialog is none
  assert dirty is false
  assert undo_depth is 0
  key alt t c
  call dialog-read {}
  assert reply.tab is General
  call real-key {"key":"escape"}
  assert dialog is none

test project task information: a refused field keeps the dialog open and applies nothing
  open copy:../fixtures/project-clipboard.xml
  click C1
  key alt t c
  call pointer-click {"dialog-field":"name"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"Renamed"}
  call pointer-click {"dialog-field":"duration"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"banana"}
  call real-key {"key":"enter"}
  assert dialog is task-information
  assert dirty is false
  assert undo_depth is 0
  assert selected_name is A
  call pointer-click {"dialog-field":"duration"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"3d"}
  call real-key {"key":"enter"}
  assert dialog is none
  assert selected_name is Renamed
  assert undo_depth is 1
  assert cell D1 is 3 days

test project task information: a double-click on a task's ID opens it, the entry row's does not
  open copy:../fixtures/project-clipboard.xml
  click A2 double
  assert dialog is task-information
  assert cell_edit is none
  call real-key {"key":"escape"}
  assert dialog is none
  click A3 double
  assert dialog is none
  assert status is ID is read-only
