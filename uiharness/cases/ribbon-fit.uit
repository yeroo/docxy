# No ribbon group draws its content taller than its body (#1018). Each tab
# is shown (ribbon-layout selects it; when that switched tabs it answers
# `settled: false`), a frame is drawn, and the second call reads where every group's content landed.

test sheet ribbon: no tab is clipped vertically
  open ../fixtures/basic.xlsx
  call window-size {"w":1600,"h":900}
  call ribbon-layout {"tab":"Home"}
  shot window
  call ribbon-layout {"tab":"Home"}
  assert reply.tab is Home
  assert reply.settled is true
  assert reply.any_clipped_v is false
  call ribbon-layout {"tab":"Insert"}
  shot window
  call ribbon-layout {"tab":"Insert"}
  assert reply.tab is Insert
  assert reply.settled is true
  assert reply.any_clipped_v is false
  call ribbon-layout {"tab":"Data"}
  shot window
  call ribbon-layout {"tab":"Data"}
  assert reply.tab is Data
  assert reply.settled is true
  assert reply.any_clipped_v is false
  call ribbon-layout {"tab":"Review"}
  shot window
  call ribbon-layout {"tab":"Review"}
  assert reply.tab is Review
  assert reply.settled is true
  assert reply.any_clipped_v is false
  call ribbon-layout {"tab":"View"}
  shot window
  call ribbon-layout {"tab":"View"}
  assert reply.tab is View
  assert reply.settled is true
  assert reply.any_clipped_v is false

