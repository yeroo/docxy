test document Home at the narrowest window
  open ../fixtures/basic.docx
  call window-size {"w":460,"h":800}
  call ribbon-layout {"tab":"Home"}
  shot window
  call ribbon-layout {"tab":"Home"}
  assert reply.settled is true
  assert reply.any_clipped is false
  assert reply.estimates_ok is true
  # A document group's flyout: Paragraph's alignment works from it.
  call ribbon-flyout {"action":"open","group":"Paragraph"}
  assert reply.open is true
  shot window
  shot ribbon-flyout

test Project Task tab narrow
  open ../fixtures/gantt-summary.xml
  call window-size {"w":640,"h":800}
  call ribbon-layout {"tab":"Task"}
  shot window
  call ribbon-layout {"tab":"Task"}
  assert reply.settled is true
  assert reply.any_clipped is false
  assert reply.estimates_ok is true
  assert reply.groups.0.title is Clipboard
  assert reply.groups.0.state is icon-only
  call window-size {"w":460,"h":800}
  shot window
  call ribbon-layout {}
  assert reply.settled is true
  assert reply.any_clipped is false
  assert reply.estimates_ok is true
  assert reply.groups.0.state is icon-only

test widening restores full groups
  open ../fixtures/basic.xlsx
  call window-size {"w":700,"h":800}
  call ribbon-layout {"tab":"Home"}
  shot window
  call ribbon-layout {"tab":"Home"}
  assert reply.groups.6.state is collapsed
  call ribbon-flyout {"action":"open","group":"Editing"}
  assert reply.open is true
  call window-size {"w":1400,"h":800}
  shot window
  call ribbon-layout {"tab":"Home"}
  assert reply.settled is true
  assert reply.any_clipped is false
  assert reply.groups.6.state is full
  # The flyout closed: its group is drawn in place again.
  call ribbon-flyout {}
  assert reply.open is false
