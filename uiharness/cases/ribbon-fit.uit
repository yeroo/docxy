# No ribbon group draws its content taller than its body (#1018). Each tab
# is shown (ribbon-layout selects it), a frame is drawn, and the second call
# reads where every group's content landed. Any call whose last frame is not
# the shown tab's answers `settled: false` with no groups.

test sheet ribbon: no tab is clipped vertically
  open ../fixtures/basic.xlsx
  call window-size {"w":1400,"h":800}
  call ribbon-layout {"tab":"Home"}
  shot window
  call ribbon-layout {"tab":"Home"}
  assert reply.tab is Home
  assert reply.settled is true
  assert reply.groups.1.title is Font
  # Not vacuous: Font is a Rows stack, so its content was measured.
  assert reply.groups.1.content_bounds is not null
  assert reply.any_clipped_v is false
  call ribbon-layout {"tab":"Insert"}
  shot window
  call ribbon-layout {"tab":"Insert"}
  assert reply.tab is Insert
  assert reply.settled is true
  assert reply.any_clipped_v is false
  call ribbon-layout {"tab":"Page Layout"}
  shot window
  call ribbon-layout {"tab":"Page Layout"}
  assert reply.tab is Page Layout
  assert reply.settled is true
  # Not vacuous: Scale to Fit is a column, so its content was measured.
  assert reply.groups.2.title is Scale to Fit
  assert reply.groups.2.content_bounds is not null
  assert reply.any_clipped_v is false
  call ribbon-layout {"tab":"Formulas"}
  shot window
  call ribbon-layout {"tab":"Formulas"}
  assert reply.tab is Formulas
  assert reply.settled is true
  assert reply.groups.2.title is Formula Auditing
  assert reply.groups.2.content_bounds is not null
  assert reply.any_clipped_v is false
  call ribbon-layout {"tab":"Data"}
  shot window
  call ribbon-layout {"tab":"Data"}
  assert reply.tab is Data
  assert reply.settled is true
  assert reply.any_clipped_v is false
  call ribbon-layout {"tab":"Review"}
  shot window
  call ribbon-layout {"tab":"Review"}
  assert reply.tab is Review
  assert reply.settled is true
  assert reply.any_clipped_v is false
  call ribbon-layout {"tab":"View"}
  shot window
  call ribbon-layout {"tab":"View"}
  assert reply.tab is View
  assert reply.settled is true
  assert reply.any_clipped_v is false

