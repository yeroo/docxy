# The User name dialog with no document open (#1027): the Start page has no tab
# to hold the dialog, so it sits on the app's own stack. This file has only
# this case: it closes every tab, and cases in one file share one instance.

test the user name dialog opened from the Backstage row takes typed text with no document open
  open copy:../fixtures/basic.docx
  call close-tab {}
  call close-tab {}
  call backstage {"action":"open"}
  shot window
  call pointer-click {"at":"user-name-row"}
  assert dialog is user-name
  shot window
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"Jane Doe"}
  call real-key {"key":"tab"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"JD"}
  call real-key {"key":"enter"}
  assert dialog is none
  assert user_name is Jane Doe
  assert user_initials is JD

test a tab arriving under the open dialog does not strand it
  call backstage {"action":"open"}
  call user-name {}
  assert dialog is user-name
  open copy:../fixtures/basic.docx
  assert dialog is user-name
  call dialog-set {"control":"user-name","value":"Pat Lee"}
  call dialog-click {"button":"OK"}
  assert dialog is none
  assert user_name is Pat Lee
