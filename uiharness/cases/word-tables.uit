# Word tables (#705): Tab navigation (#643), Insert > Table (#646), the table
# Layout tab (#647) and the Table Design tab (#648). The document state's
# `table` object is the caret's innermost table: `cells.<row>.<cell>` lists a
# cell's paragraphs, with a tab shown as ⇥.

test tab moves between cells and adds a row, ctrl+tab types a tab (643)
  open copy:../fixtures/basic.docx
  call ribbon-click {"tab":"Insert","command":"table"}
  call table-grid {"cols":2,"rows":2,"click":true}
  assert table.rows is 2
  assert table.columns is 2
  type a
  key enter
  type b
  key ctrl+tab
  type c
  key tab
  type d
  key tab
  type e
  key tab
  type f
  key tab
  type g
  key shift+tab
  type h
  assert table.rows is 3
  assert table.cells.0.0.0 is a
  assert table.cells.0.0.1 is b⇥c
  assert table.cells.0.1.0 is d
  assert table.cells.1.0.0 is e
  assert table.cells.1.1.0 is h
  assert table.cells.2.0.0 is g
  shot window
  key ctrl+s
  assert dirty is false
  # Shift+Tab in the first cell stays there.
  key ctrl+home
  key shift+tab
  assert table.row is 0
  assert table.cell is 0

test insert table grid reads columns by rows and inserts that table (646)
  open copy:../fixtures/basic.docx
  call ribbon-click {"tab":"Insert","command":"table"}
  call menu-read {}
  assert reply.items.0.table_grid.columns is 10
  assert reply.items.0.table_grid.rows is 8
  assert reply.items.2.label is Insert Table...
  assert reply.items.3.label is Draw Table
  assert reply.items.3.enabled is true
  assert reply.items.4.label is Convert Text to Table...
  assert reply.items.4.enabled is false
  call table-grid {"cols":4,"rows":3}
  assert reply.header is 4x3 Table
  call table-grid {}
  assert reply.header is Insert Table
  call table-grid {"cols":4,"rows":3,"click":true}
  assert menu is null
  assert table.columns is 4
  assert table.rows is 3
  shot window
  key ctrl+z
  assert table is null

test insert table dialog defaults and convert text to table (646)
  open copy:../fixtures/basic.docx
  call ribbon-click {"tab":"Insert","command":"table"}
  call menu-click {"label":"Insert Table..."}
  assert dialog is insert-table
  call dialog-read {}
  assert reply.controls.0.value is 5
  assert reply.controls.1.value is 2
  assert reply.controls.2.value is Fixed column width
  call dialog-set {"control":"Number of columns","value":3}
  call dialog-click {"button":"OK"}
  assert table.columns is 3
  assert table.rows is 2
  key ctrl+z
  type one	two
  key home shift+end
  call ribbon-click {"tab":"Insert","command":"table"}
  call menu-read {}
  assert reply.items.4.enabled is true
  call menu-click {"label":"Convert Text to Table..."}
  assert dialog is convert-text-to-table
  call dialog-read {}
  assert reply.controls.0.value is 2
  call dialog-click {"button":"OK"}
  assert table.cells.0.0.0 is one
  assert table.cells.0.1.0 is two

test insert table dialog opens with number of columns focused (1163)
  open copy:../fixtures/basic.docx
  call ribbon-click {"tab":"Insert","command":"table"}
  call menu-click {"label":"Insert Table..."}
  assert dialog is insert-table
  call field-read {"dialog-field":"cols"}
  assert reply.focused is true
  call real-key {"key":"backspace"}
  call real-type {"text":"3"}
  call field-read {"dialog-field":"cols"}
  assert reply.value is 3
  assert reply.focused is true
  call real-key {"key":"enter"}
  assert dialog is none
  assert table.columns is 3
  assert table.rows is 2

test layout tab selects, merges, splits, aligns, sorts and converts (647)
  open copy:../fixtures/basic.docx
  call ribbon-click {"tab":"Insert","command":"table"}
  call table-grid {"cols":3,"rows":3,"click":true}
  type 3
  key tab
  type c
  key tab
  key tab
  type 1
  key tab
  type a
  key tab
  key tab
  type 2
  key tab
  type b
  assert ribbon_tab is Insert
  call ribbon-click {"tab":"Table Layout","command":"select-column"}
  assert table.range.top is 0
  assert table.range.bottom is 2
  assert table.range.left is 1
  assert table.range.right is 1
  call ribbon-click {"tab":"Table Layout","command":"merge-cells"}
  assert table.cells.0.1.0 is c
  assert table.cells.0.1.1 is a
  assert table.cells.0.1.2 is b
  key ctrl+z
  assert table.cells.1.1.0 is a
  call ribbon-click {"tab":"Table Layout","command":"split-cells"}
  assert dialog is split-cells
  call dialog-click {"button":"OK"}
  assert table.columns is 4
  key ctrl+z
  key escape
  call ribbon-click {"tab":"Table Layout","command":"align-bottom-right"}
  assert para.alignment is right
  call ribbon-click {"tab":"Table Layout","command":"text-direction"}
  assert table.text_direction is tbRl
  call ribbon-click {"tab":"Table Layout","command":"insert-below"}
  assert table.rows is 4
  key ctrl+z
  # Home > Sort in a table opens the table's Sort dialog.
  call ribbon-click {"tab":"Home","command":"sort"}
  assert dialog is sort
  call dialog-set {"control":"type1","value":"Number"}
  call dialog-click {"button":"OK"}
  assert table.cells.0.0.0 is 1
  assert table.cells.1.0.0 is 2
  assert table.cells.2.0.0 is 3
  assert table.cells.2.1.0 is c
  call ribbon-click {"tab":"Table Layout","command":"gridlines"}
  assert view.gridlines is false
  call ribbon-click {"tab":"Table Layout","command":"gridlines"}
  assert view.gridlines is true
  shot window
  call ribbon-click {"tab":"Table Layout","command":"convert-to-text"}
  assert dialog is convert-to-text
  call dialog-click {"button":"OK"}
  assert table is null
  assert ribbon_tab is Home

test design tab styles, options, shading and borders (648)
  open copy:../fixtures/basic.docx
  call ribbon-click {"tab":"Insert","command":"table"}
  call table-grid {"cols":3,"rows":4,"click":true}
  call ribbon-click {"tab":"Table Design","command":"tablestyles:Grid Table 4 Accent 1"}
  assert table.style is GridTable4-Accent1
  assert table.look is 04A0
  call ribbon-click {"tab":"Table Design","command":"banded-columns"}
  assert table.look is 00A0
  call ribbon-click {"tab":"Table Design","command":"header-row"}
  assert table.look is 0080
  key ctrl+z
  assert table.look is 00A0
  # Into a body row: Grid Table 4's header row has no inside vertical border,
  # so there All Borders is rightly off.
  key tab tab tab
  assert table.row is 1
  call ribbon-click {"tab":"Table Design","command":"shade-yellow"}
  assert table.shading is FFFF00
  call ribbon-click {"tab":"Table Design","command":"shade-none"}
  assert table.shading is null
  call ribbon-read {}
  assert reply.tabs.9.name is Table Design
  assert reply.tabs.9.groups.2.commands.6.id is border-all
  assert reply.tabs.9.groups.2.commands.6.checked is true
  assert reply.tabs.9.groups.2.commands.11.id is border-diag-down
  assert reply.tabs.9.groups.2.commands.11.enabled is true
  call ribbon-click {"tab":"Table Design","command":"border-all"}
  call ribbon-read {}
  assert reply.tabs.9.groups.2.commands.6.checked is false
  call ribbon-click {"tab":"Table Design","command":"border-diag-down"}
  call ribbon-read {}
  assert reply.tabs.9.groups.2.commands.11.checked is true
  shot window
  key ctrl+z ctrl+z
  call ribbon-read {}
  assert reply.tabs.9.groups.2.commands.6.checked is true

# Live preview (#764): hovering a grid cell or a Table Styles tile draws the
# document as the click would leave it, without changing it. `preview` is
# what the last frame drew in place of the document (`shot window` settles
# one); the document, its undo and `dirty` stay as they were.
test hovering the insert table grid previews the table in the document (764)
  open copy:../fixtures/basic.docx
  # Print Layout is a window setting: on here, off again at the end.
  call ribbon-click {"tab":"View","command":"Print Layout"}
  assert view.layout is print
  call ribbon-click {"tab":"Insert","command":"table"}
  shot window
  assert preview is null
  call table-grid {"cols":3,"rows":2}
  shot window
  assert preview.kind is grid
  assert preview.cols is 3
  assert preview.rows is 2
  assert preview.tables is 1
  assert preview.pages is 1
  assert table is null
  assert dirty is false
  call table-grid {"cols":4,"rows":3}
  shot window
  assert preview.cols is 4
  assert preview.rows is 3
  call table-grid {}
  shot window
  assert preview is null
  assert table is null
  assert dirty is false
  # Escape closes the menu, and the preview goes with it.
  call table-grid {"cols":2,"rows":2}
  shot window
  assert preview.kind is grid
  key escape
  shot window
  assert menu is null
  assert preview is null
  assert dirty is false
  # A click inserts what was previewed; what is drawn is then the real table.
  call ribbon-click {"tab":"Insert","command":"table"}
  call table-grid {"cols":3,"rows":2}
  call table-grid {"cols":3,"rows":2,"click":true}
  shot window
  assert preview is null
  assert table.columns is 3
  assert table.rows is 2
  key ctrl+z
  assert table is null
  call ribbon-click {"tab":"View","command":"Print Layout"}
  assert view.layout is web

test the insert table grid preview draws in draft view too (764)
  open copy:../fixtures/basic.docx
  assert view.layout is web
  call ribbon-click {"tab":"Insert","command":"table"}
  call table-grid {"cols":5,"rows":4}
  shot window
  assert preview.kind is grid
  assert preview.tables is 1
  assert preview.pages is null
  call menu-close {}
  shot window
  assert preview is null

test a tall grid preview flows onto another page the document does not have (764)
  open copy:../fixtures/basic.docx
  call ribbon-click {"tab":"View","command":"Print Layout"}
  assert view.layout is print
  # Near the foot of the one page: an 8-row table no longer fits on it.
  key ctrl+end
  key enter enter enter enter enter enter enter enter enter enter enter enter enter enter enter enter enter enter enter enter enter enter enter enter enter enter enter enter enter enter
  call status-read {}
  assert reply.items.2.text is 1 page · 0 words
  call ribbon-click {"tab":"Insert","command":"table"}
  call table-grid {"cols":3,"rows":8}
  shot window
  assert preview.pages is 2
  # The document itself still has one page.
  call status-read {}
  assert reply.items.2.text is 1 page · 0 words
  call menu-close {}
  call ribbon-click {"tab":"View","command":"Print Layout"}
  assert view.layout is web

test hovering a table style previews it on the caret's table (764)
  open copy:../fixtures/basic.docx
  call ribbon-click {"tab":"Insert","command":"table"}
  call table-grid {"cols":3,"rows":3,"click":true}
  call ribbon-click {"tab":"Table Design","command":"tablestyles:Grid Table 1 Light"}
  key ctrl+s
  assert dirty is false
  call gallery-hover {"gallery":"tablestyles","item":"Grid Table 4 Accent 1"}
  shot window
  assert preview.kind is style
  assert preview.style is GridTable4-Accent1
  assert preview.tables is 1
  assert table.style is GridTable1Light
  assert dirty is false
  call gallery-hover {"gallery":"tablestyles"}
  shot window
  assert preview is null
  assert table.style is GridTable1Light
  assert dirty is false
  # A caret moved by a key while the pointer rests on a tile drops the
  # preview: it was of the table where the caret was.
  call gallery-hover {"gallery":"tablestyles","item":"Grid Table 4 Accent 1"}
  shot window
  assert preview.kind is style
  key tab
  assert table.cell is 1
  shot window
  assert preview is null
  # Another ribbon tab hides the gallery with no leave; back on Table
  # Design, nothing is hovered and nothing is previewed.
  call gallery-hover {"gallery":"tablestyles","item":"Grid Table 4 Accent 1"}
  shot window
  assert preview.kind is style
  call ribbon-layout {"tab":"Home"}
  shot window
  assert preview is null
  call ribbon-layout {"tab":"Table Design"}
  shot window
  assert preview is null
  # So does File: the backstage frame drops it, and back from it nothing
  # is previewed.
  call gallery-hover {"gallery":"tablestyles","item":"Grid Table 4 Accent 1"}
  shot window
  assert preview.kind is style
  call backstage {"action":"open"}
  shot window
  assert preview is null
  call backstage {"action":"close"}
  shot window
  assert preview is null
  # A click applies the hovered style; the drawn table is then the real one.
  call gallery-hover {"gallery":"tablestyles","item":"Grid Table 4 Accent 1"}
  call ribbon-click {"tab":"Table Design","command":"tablestyles:Grid Table 4 Accent 1"}
  shot window
  assert preview is null
  assert table.style is GridTable4-Accent1
  assert dirty is true
  key ctrl+z
  assert table.style is GridTable1Light
  # Out of the table the gallery is gone: no hover there.
  key ctrl+end
  call-error gallery-hover {"gallery":"tablestyles","item":"Grid Table 4 Accent 1"} => is not showing

test an edit while hovering a table style drops the preview (764)
  open copy:../fixtures/basic.docx
  call ribbon-click {"tab":"Insert","command":"table"}
  call table-grid {"cols":2,"rows":2,"click":true}
  call ribbon-layout {"tab":"Table Design"}
  call gallery-hover {"gallery":"tablestyles","item":"Grid Table 4 Accent 1"}
  shot window
  assert preview.kind is style
  type z
  shot window
  assert preview is null
  assert table.cells.0.0.0 is z

test the table styles gallery previews from its narrow-window flyout (764 1020)
  open copy:../fixtures/basic.docx
  call ribbon-click {"tab":"Insert","command":"table"}
  call table-grid {"cols":2,"rows":2,"click":true}
  call window-size {"w":460,"h":800}
  call ribbon-layout {"tab":"Table Design"}
  shot window
  call-error gallery-hover {"gallery":"tablestyles","item":"Grid Table 4 Accent 1"} => is not showing
  call ribbon-flyout {"action":"open","group":"Table Styles"}
  assert reply.open is true
  call gallery-hover {"gallery":"tablestyles","item":"Grid Table 4 Accent 1"}
  shot window
  assert preview.kind is style
  assert preview.style is GridTable4-Accent1
  call ribbon-flyout {"action":"close"}
  shot window
  assert preview is null
  # Escape closes the flyout with no leave from the tile: the preview is
  # gone for good, not drawn again when the flyout reopens.
  call ribbon-flyout {"action":"open","group":"Table Styles"}
  call gallery-hover {"gallery":"tablestyles","item":"Grid Table 4 Accent 1"}
  shot window
  assert preview.kind is style
  key escape
  shot window
  assert preview is null
  call ribbon-flyout {"action":"open","group":"Table Styles"}
  shot window
  assert preview is null

test no document preview while a header is being edited (764)
  open copy:../fixtures/basic.docx
  call ribbon-click {"tab":"Insert","command":"Edit Header"}
  assert hf_edit is true
  call ribbon-click {"tab":"Insert","command":"table"}
  call table-grid {"cols":3,"rows":2}
  assert reply.header is 3x2 Table
  shot window
  assert preview is null

test a grid hover leaves repeat as it was (764)
  open copy:../fixtures/basic.docx
  type ab cd
  call selection-set {"start":0,"end":2}
  key ctrl+b
  call ribbon-click {"tab":"Insert","command":"table"}
  call table-grid {"cols":3,"rows":2}
  shot window
  assert preview.kind is grid
  call table-grid {}
  call menu-close {}
  # The hover built its preview on a copy and issued no undo serial, so
  # Repeat still repeats the bold.
  call ribbon-read {}
  assert reply.qat.1.tip.title is Repeat (Ctrl+Y)
  call selection-set {"start":3,"end":5}
  key f4
  call selection-set {"start":4,"end":4}
  assert run.bold is true
