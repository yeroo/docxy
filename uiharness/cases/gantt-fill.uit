# filler_rows reads the last frame's body height, and state asserts do not wait
# for a frame; the shot does, so it comes first.
test gantt grid fills the pane below the last task
  open ../fixtures/gantt-critical.xml
  assert tasks is 2
  shot window
  assert filler_rows is not 0
  assert bar_2 is critical 1-2
  assert border bar:2 solid amber
test empty gantt is ruled from the top
  open ../fixtures/gantt-empty.xml
  assert tasks is 0
  shot window
  assert filler_rows is not 0
