test project editing keys and prompts
  open ../fixtures/gantt-summary.xml
  key insert
  assert tasks is 4
  assert selected_task is 0
  assert selected_name is empty
  assert cell is Name
  assert undo_depth is 1
  key delete
  assert tasks is 4
  assert undo_depth is 1
  key ctrl+z
  assert tasks is 3
  assert selected_name is Task 1
  key insert insert
  assert tasks is 5
  assert selected_name is empty
  key left left
  assert cell is ID
  key delete delete
  assert tasks is 3
  assert selected_name is Task 1
  # Rename and Duration are cell edits, as in Project (#370): F2 edits the
  # Name in place and Tab commits it, moving to Duration on the same row.
  key ctrl+up down right right f2
  assert cell is Name
  assert cell_edit is Task 2
  type renamed
  key tab
  assert selected_name is Task 2renamed
  assert dirty is true
  assert cell is Duration
  type 3d
  key tab
  assert cell D2 is 3 days
  assert bar_2 is on-track 0-2
  key alt t p
  type 3
  key enter
  assert bar_2 is critical 4-8
  key alt t c
  key backspace backspace backspace backspace
  type SNET 2026-01-19
  key enter
  assert status is Constraint set: SNET
  assert bar_2 is critical 14-16
  key alt u a
  type Alice
  key enter
  assert status is Assigned Alice
  key alt p b
  assert status is Baseline set — baseline bars now show under the current bars
  key ctrl+shift+l
  assert status is Resource leveling ON — bars delayed to fit resource capacity
  shot window

test project find reveals a distant row and F3 wraps
  open ../fixtures/gantt-scroll.xml
  key ctrl+f
  type Task 100
  key enter
  assert selected_task is 99
  assert selected_name is Task 100
  assert status is Found 'Task 100'  (F3 next)
  shot bar:100
  key f3
  assert selected_task is 99
  shot bar:100
