# An extension tab's embedded read-only document view (#1873). The script's
# `ext fixture` line has this instance draw Mail tabs with the suite's test
# extension: a header line over a DocView of a document built in code
# (heading "Embedded view", "Alpha Beta Gamma" with Beta bold, a paragraph
# holding the hyperlink "docxy link" to https://example.com/docxy, an
# indented paragraph that starts with the link "Indented link" to
# https://example.com/indented, a picture, a 2x2 table, a 100% table
# imported from HTML with the link "cell link" to https://example.com/cell,
# a fixed 12000-twip table "Fixed left" / "Right Omega Zeta" (#1895),
# then Line 1..Line 80). The extension records every link the
# view hands it (`ext-doc-read` link_calls). Keys go through `real-key`: the
# `key` verb presses the suite's own handler and never reaches the view.
# The view's own Find box (#1887) opens on Ctrl+F: `ext-doc-read`'s `find`
# (open, query, field_focused, count, current, current_path,
# current_in_view, hits_painted), its regions `ext-doc-find:<field|prev|
# next|close>` and the input `ext-doc-find` (`pointer-click`, `field-read`).
# Each test opens its own Mail tab and closes it at the end.
ext fixture

test issue 1873 the test extension's Mail tab draws the document in the embedded view
  call backstage {"action":"open"}
  call backstage-page {"page":"new"}
  call new-card {"card":"new-mail-card"}
  shot window
  call tab-list {}
  assert reply.tabs.1.kind is mail
  assert reply.active is 1
  call ext-doc-read {}
  assert reply.blocks is 88
  assert reply.tables is 3
  assert reply.pictures is 1
  assert reply.links.0.url is https://example.com/docxy
  assert reply.links.1.url is https://example.com/indented
  assert reply.zoom is 1
  assert reply.scroll_y is 0
  assert reply.max_scroll_y is not 0
  assert reply.links_followed is 0
  assert reply.link_click is ctrl-click
  assert reply.selection is empty
  call ext-doc-set {"content_dark":true}
  assert reply.content_dark is true
  shot window
  call ext-doc-set {"content_dark":false}
  assert reply.content_dark is false
  call real-key {"key":"ctrl+w"}
  call tab-list {}
  assert reply.count is 1

test issue 1873 a drag selects in the view and Ctrl+C copies its text and RTF, Ctrl+A all, Tab nothing
  call backstage {"action":"open"}
  call backstage-page {"page":"new"}
  call new-card {"card":"new-mail-card"}
  shot window
  call pointer-drag {"from":"ext-doc-word:Alpha:start","to":"ext-doc-word:Gamma:end"}
  call ext-doc-read {}
  # The press gave the view the keys; the suite took none of them back.
  assert reply.focused is true
  assert reply.selection is Alpha Beta Gamma
  assert reply.selected_paragraphs is 1
  call real-key {"key":"ctrl+c"}
  call clipboard {"action":"read"}
  assert reply.text is Alpha Beta Gamma
  assert reply.rtf is not nothing
  assert reply.rtf_bold is Beta
  # Tab is the extension's: the suite edits nothing and the view keeps its
  # selection and the keys.
  call real-key {"key":"tab"}
  call ext-doc-read {}
  assert reply.selection is Alpha Beta Gamma
  assert reply.focused is true
  call real-key {"key":"ctrl+a"}
  call ext-doc-read {}
  assert reply.selected_paragraphs is 93
  shot window
  call real-key {"key":"ctrl+w"}
  call tab-list {}
  assert reply.count is 1

test issue 1873 the wheel and the keys scroll the view, Ctrl with them zooms it
  call backstage {"action":"open"}
  call backstage-page {"page":"new"}
  call new-card {"card":"new-mail-card"}
  shot window
  call pointer-click {"region":"ext-doc-view"}
  call pointer-wheel {"region":"ext-doc-view","dy":-200}
  call ext-doc-read {}
  assert reply.scroll_y is not 0
  # Page Down scrolls further (the snapshot is ext-doc-set's reply).
  call ext-doc-set {"content_dark":false}
  call real-key {"key":"pagedown"}
  call ext-doc-read {}
  assert reply.scroll_y is not {ext-doc-set.scroll_y}
  call real-key {"key":"home"}
  call ext-doc-read {}
  assert reply.scroll_y is 0
  call real-key {"key":"ctrl+="}
  call real-key {"key":"ctrl+="}
  call ext-doc-read {}
  assert reply.zoom is 1.2
  call real-key {"key":"ctrl+-"}
  call ext-doc-read {}
  assert reply.zoom is 1.1
  call real-key {"key":"ctrl+0"}
  call ext-doc-read {}
  assert reply.zoom is 1
  # Ctrl+wheel down zooms out a step and leaves the scroll where it was,
  # though the view was scrolled and could scroll further.
  call pointer-wheel {"region":"ext-doc-view","dy":-300}
  call ext-doc-set {"content_dark":false}
  assert reply.scroll_y is not 0
  call pointer-wheel {"region":"ext-doc-view","dy":-120,"ctrl":true}
  call ext-doc-read {}
  assert reply.zoom is 0.9
  assert reply.scroll_y is {ext-doc-set.scroll_y}
  shot window
  call real-key {"key":"ctrl+w"}
  call tab-list {}
  assert reply.count is 1

test issue 1873 a hyperlink press reaches the extension's callback, by Ctrl+click or as set by click
  call backstage {"action":"open"}
  call backstage-page {"page":"new"}
  call new-card {"card":"new-mail-card"}
  shot window
  # Ctrl+click (the default mode) hands the link over and selects nothing.
  call pointer-click {"region":"ext-doc-link:0","ctrl":true}
  call ext-doc-read {}
  assert reply.links_followed is 1
  assert reply.link_calls.0 is https://example.com/docxy
  assert reply.selection is empty
  # A plain click does not follow it in that mode.
  call pointer-click {"region":"ext-doc-link:0"}
  call ext-doc-read {}
  assert reply.links_followed is 1
  # Set to follow on a plain click, it does.
  call ext-doc-set {"link_click":"click"}
  assert reply.link_click is click
  call pointer-click {"region":"ext-doc-link:0"}
  call ext-doc-read {}
  assert reply.links_followed is 2
  assert reply.link_calls.1 is https://example.com/docxy
  # A press in the blank indent beside a row that starts with a link is not
  # on the link: neither a plain press there (in click mode) nor a Ctrl+press
  # follows it, though the row's nearest stop is the link's first character.
  call pointer-click {"region":"ext-doc-link:1:left"}
  call ext-doc-read {}
  assert reply.links_followed is 2
  call pointer-click {"region":"ext-doc-link:1:left","ctrl":true}
  call ext-doc-read {}
  assert reply.links_followed is 2
  # On the link itself it does.
  call pointer-click {"region":"ext-doc-link:1","ctrl":true}
  call ext-doc-read {}
  assert reply.links_followed is 3
  assert reply.link_calls.2 is https://example.com/indented
  # A drag that starts on the link selects and follows nothing.
  call pointer-drag {"from":"ext-doc-link:0","to":"ext-doc-word:here.:end"}
  call ext-doc-read {}
  assert reply.links_followed is 3
  assert reply.selection is not empty
  call real-key {"key":"ctrl+w"}
  call tab-list {}
  assert reply.count is 1

test issue 1895 a 100% table fits a narrow view and a fixed one scrolls sideways to its right edge
  call window-size {"w":600,"h":700}
  call backstage {"action":"open"}
  call backstage-page {"page":"new"}
  call new-card {"card":"new-mail-card"}
  shot window
  call ext-doc-read {}
  # The 100% table takes the text width, narrower than its 624 px grid;
  # the fixed one keeps its 800 px and reaches past the view.
  assert reply.table_widths.1.block is 6
  assert reply.table_widths.1.fits_text is true
  assert reply.table_widths.1.width is {ext-doc-read.text_width}
  assert reply.table_widths.1.right_in_view is true
  assert reply.table_widths.2.block is 7
  assert reply.table_widths.2.width is 800
  assert reply.table_widths.2.right_in_view is false
  assert reply.scroll_x is 0
  assert reply.max_scroll_x is not 0
  # A link in a fitted cell still reaches the extension.
  call pointer-click {"region":"ext-doc-link:2","ctrl":true}
  call ext-doc-read {}
  assert reply.links_followed is 1
  assert reply.link_calls.0 is https://example.com/cell
  # A plain wheel scrolls down only, and back.
  call pointer-wheel {"region":"ext-doc-view","dy":-40}
  call ext-doc-read {}
  assert reply.scroll_y is not 0
  assert reply.scroll_x is 0
  call pointer-wheel {"region":"ext-doc-view","dy":40}
  # A shifted one scrolls sideways, as far as the fixed table's right edge.
  call pointer-wheel {"region":"ext-doc-view","dy":-1000,"shift":true}
  shot window
  call ext-doc-read {}
  assert reply.scroll_y is 0
  assert reply.scroll_x is not 0
  assert reply.scroll_x is {ext-doc-read.max_scroll_x}
  assert reply.table_widths.2.right_in_view is true
  # A drag in the scrolled table selects its words.
  call pointer-drag {"from":"ext-doc-word:Omega:start","to":"ext-doc-word:Zeta:end"}
  call ext-doc-read {}
  assert reply.selection is Omega Zeta
  call pointer-wheel {"region":"ext-doc-view","dy":1000,"shift":true}
  call ext-doc-read {}
  assert reply.scroll_x is 0
  # Wider: the 100% table grows with the view, nothing scrolls sideways and
  # the selection stays.
  call window-size {"w":1100,"h":700}
  shot window
  call ext-doc-read {}
  assert reply.table_widths.1.width is {ext-doc-read.text_width}
  assert reply.table_widths.1.width is not 624
  assert reply.max_scroll_x is 0
  assert reply.selection is Omega Zeta
  call real-key {"key":"ctrl+w"}
  call tab-list {}
  assert reply.count is 1

test issue 2003 the host sets the view's page inset and its dark page's colour, and resets both
  call window-size {"w":1000,"h":700}
  call theme-set {"theme":"dark"}
  call backstage {"action":"open"}
  call backstage-page {"page":"new"}
  call new-card {"card":"new-mail-card"}
  shot window
  # The default: 48 px beside the text, 28 above and below, the theme's
  # background under dark content.
  call ext-doc-set {"content_dark":true}
  shot window
  call ext-doc-read {}
  assert reply.page_inset.top is 28
  assert reply.page_inset.right is 48
  assert reply.page_inset.bottom is 28
  assert reply.page_inset.left is 48
  assert reply.page_background is null
  assert reply.column_left is 48
  assert reply.page_color is not 262626
  assert reply.text_width is 904
  # The host's: 22 px beside, 12 above and below, the page in its header's
  # #262626. The text is 2 x (48 - 22) = 52 px wider.
  call ext-doc-set {"page_inset":{"top":12,"right":22,"bottom":12,"left":22},"page_background":"262626"}
  assert reply.page_inset.left is 22
  assert reply.page_background is 262626
  shot window
  call ext-doc-read {}
  assert reply.page_inset.top is 12
  assert reply.page_inset.right is 22
  assert reply.page_inset.bottom is 12
  assert reply.column_left is 22
  assert reply.page_color is 262626
  assert reply.text_width is 956
  # A press on the fixture's header takes the keys from the view; one in
  # the narrower left padding gives them back, beside a paragraph and
  # beside a table row (the view draws no row-selection strip there to
  # swallow the press).
  call pointer-click {"region":"ext-doc-header"}
  call ext-doc-read {}
  assert reply.focused is false
  call pointer-click {"region":"ext-doc-inset:left:Alpha"}
  call ext-doc-read {}
  assert reply.focused is true
  call pointer-click {"region":"ext-doc-header"}
  call ext-doc-read {}
  assert reply.focused is false
  call pointer-click {"region":"ext-doc-inset:left:A1"}
  call ext-doc-read {}
  assert reply.focused is true
  assert reply.selection is empty
  # Light content on the dark theme: the white page, whatever the host's.
  call ext-doc-set {"content_dark":false}
  shot window
  call ext-doc-read {}
  assert reply.page_color is ffffff
  assert reply.column_left is 22
  # The light theme: the white page too, dark content or not.
  call ext-doc-set {"content_dark":true}
  call theme-set {"theme":"light"}
  shot window
  call ext-doc-read {}
  assert reply.page_color is ffffff
  assert reply.page_background is 262626
  assert reply.column_left is 22
  # Back to the dark theme and the defaults: 48 x 28 and the theme's page.
  call theme-set {"theme":"dark"}
  call ext-doc-set {"page_inset":null,"page_background":null}
  shot window
  call ext-doc-read {}
  assert reply.page_inset.left is 48
  assert reply.page_background is null
  assert reply.column_left is 48
  assert reply.page_color is not 262626
  call ext-doc-set {"content_dark":false}
  call theme-set {"theme":"auto"}
  call real-key {"key":"ctrl+w"}
  call tab-list {}
  assert reply.count is 1

test issue 1887 Ctrl+F finds Line 7 in the view, Enter steps to the second match and scrolls it into view
  # Line 7 is in view without scrolling at this size; Line 70 is not.
  call window-size {"w":1000,"h":700}
  call backstage {"action":"open"}
  call backstage-page {"page":"new"}
  call new-card {"card":"new-mail-card"}
  shot window
  call pointer-click {"region":"ext-doc-view"}
  call real-key {"key":"ctrl+f"}
  call ext-doc-read {}
  assert reply.find.open is true
  assert reply.find.field_focused is true
  assert reply.find.count is 0
  call real-type {"text":"Line 7"}
  shot window
  call ext-doc-read {}
  assert reply.find.query is Line 7
  # Line 7 and Line 70..79, the first selected; the others are below the
  # view, so none paints yet.
  assert reply.find.count is 11
  assert reply.find.current is 1
  assert reply.find.current_path.0 is 14
  assert reply.find.current_in_view is true
  assert reply.find.hits_painted is 0
  assert reply.selection is Line 7
  assert reply.scroll_y is 0
  # The suite's own Find bar took none of it.
  assert find_open is false
  call real-key {"key":"enter"}
  shot window
  call ext-doc-read {}
  assert reply.find.current is 2
  assert reply.find.current_path.0 is 77
  assert reply.find.current_in_view is true
  assert reply.scroll_y is not 0
  assert reply.selection is Line 7
  # The match is revealed at the view's bottom edge. Page Down from the
  # field scrolls the view (the read-only map's key): Line 71.. come into
  # view and paint as hits, the field keeping the keys.
  call real-key {"key":"pagedown"}
  shot window
  call ext-doc-read {}
  assert reply.find.hits_painted is not 0
  assert reply.find.field_focused is true
  call real-key {"key":"shift+enter"}
  shot window
  call ext-doc-read {}
  assert reply.find.current is 1
  assert reply.find.current_path.0 is 14
  assert reply.find.current_in_view is true
  call real-key {"key":"f3"}
  call ext-doc-read {}
  assert reply.find.current is 2
  call real-key {"key":"shift+f3"}
  call real-key {"key":"shift+f3"}
  shot window
  call ext-doc-read {}
  # Back from the first wraps to the last, Line 79, and forward from it
  # to the first.
  assert reply.find.current is 11
  assert reply.find.current_path.0 is 86
  assert reply.find.current_in_view is true
  call real-key {"key":"f3"}
  call ext-doc-read {}
  assert reply.find.current is 1
  # Escape closes the box: the match stays selected and nothing is painted.
  call real-key {"key":"escape"}
  shot window
  call ext-doc-read {}
  assert reply.find.open is false
  assert reply.find.hits_painted is 0
  assert reply.selection is Line 7
  assert reply.focused is true
  # Ctrl+F reopens it on the selected match, the query selected.
  call real-key {"key":"ctrl+f"}
  call ext-doc-read {}
  assert reply.find.open is true
  assert reply.find.current is 1
  call field-read {"input":"ext-doc-find"}
  assert reply.value is Line 7
  assert reply.focused is true
  assert reply.selection.1 is 6
  call real-key {"key":"ctrl+w"}
  call tab-list {}
  assert reply.count is 1

test issue 1887 in the editing mode the Find box takes the typing and gives the keys back on a press in the document
  call backstage {"action":"open"}
  call backstage-page {"page":"new"}
  call new-card {"card":"new-mail-card"}
  shot window
  call ext-doc-set {"editable":true}
  call pointer-click {"region":"ext-doc-word:Gamma:end"}
  call real-key {"key":"ctrl+f"}
  call real-type {"text":"Beta"}
  # Tab, the document's chords and a field edit never reach the document.
  call real-key {"key":"tab"}
  call real-key {"key":"shift+tab"}
  call real-key {"key":"ctrl+b"}
  call real-key {"key":"ctrl+z"}
  call real-key {"key":"backspace"}
  call real-type {"text":"a"}
  call ext-doc-read {}
  assert reply.change_calls is 0
  assert reply.can_undo is false
  assert reply.find.query is Beta
  assert reply.find.count is 1
  assert reply.find.current is 1
  assert reply.find.field_focused is true
  assert reply.selection is Beta
  call ext-doc-document {}
  assert reply.paragraphs.1.text is Alpha Beta Gamma
  assert reply.paragraphs.1.runs.1.text is Beta
  assert reply.paragraphs.1.runs.1.bold is true
  call field-read {"input":"ext-doc-find"}
  assert reply.value is Beta
  assert reply.focused is true
  assert reply.caret is 4
  # A press in the document gives the keys back; the box stays.
  call pointer-click {"region":"ext-doc-word:Gamma:end"}
  call ext-doc-read {}
  assert reply.find.open is true
  assert reply.find.field_focused is false
  call real-type {"text":"!"}
  call ext-doc-document {}
  assert reply.paragraphs.1.text is Alpha Beta Gamma!
  call ext-doc-read {}
  assert reply.change_calls is not 0
  assert reply.find.query is Beta
  # Ctrl+F gives the box the keys again with its text selected.
  call real-key {"key":"ctrl+f"}
  call field-read {"input":"ext-doc-find"}
  assert reply.focused is true
  assert reply.selection.1 is 4
  # A click on the field puts the caret at its end; it types there.
  call pointer-click {"input":"ext-doc-find"}
  call real-key {"key":"backspace","times":4}
  call real-type {"text":"Gamma"}
  call field-read {"input":"ext-doc-find"}
  assert reply.value is Gamma
  assert reply.caret is 5
  call ext-doc-read {}
  assert reply.selection is Gamma
  # Escape closes the box and keeps the match; the next Escape is the
  # editing map's, which collapses the selection.
  call real-key {"key":"escape"}
  call ext-doc-read {}
  assert reply.find.open is false
  assert reply.selection is Gamma
  call real-key {"key":"escape"}
  call ext-doc-read {}
  assert reply.selection is empty
  call ext-doc-document {}
  assert reply.paragraphs.1.text is Alpha Beta Gamma!
  call real-key {"key":"ctrl+w"}
  call tab-list {}
  assert reply.count is 1

test issue 1887 the Find box's buttons step and close it, a match past the right edge scrolls into view, Ctrl+W still closes the tab
  call window-size {"w":600,"h":700}
  call backstage {"action":"open"}
  call backstage-page {"page":"new"}
  call new-card {"card":"new-mail-card"}
  shot window
  call pointer-click {"region":"ext-doc-view"}
  call real-key {"key":"ctrl+f"}
  call real-type {"text":"Line 7"}
  shot window
  call pointer-click {"region":"ext-doc-find:next"}
  call ext-doc-read {}
  assert reply.find.current is 2
  assert reply.focused is true
  call pointer-click {"region":"ext-doc-find:prev"}
  call pointer-click {"region":"ext-doc-find:prev"}
  shot window
  call ext-doc-read {}
  assert reply.find.current is 11
  assert reply.find.current_in_view is true
  # Zoomed to 150% from the field (the view's keys), Zeta in the fixed
  # 12000-twip table's right cell is past the view's right edge (#1895):
  # the step scrolls sideways to it.
  call real-key {"key":"ctrl+=","times":5}
  shot window
  call ext-doc-read {}
  assert reply.zoom is 1.5
  assert reply.scroll_x is 0
  assert reply.find.field_focused is true
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"Zeta"}
  shot window
  call ext-doc-read {}
  assert reply.find.count is 1
  assert reply.find.current_path.0 is 7
  assert reply.find.current_in_view is true
  assert reply.scroll_x is not 0
  assert reply.selection is Zeta
  call pointer-click {"region":"ext-doc-find:close"}
  call ext-doc-read {}
  assert reply.find.open is false
  assert reply.selection is Zeta
  # With the box open, Ctrl+W still closes the tab.
  call real-key {"key":"ctrl+f"}
  call ext-doc-read {}
  assert reply.find.open is true
  call real-key {"key":"ctrl+w"}
  call tab-list {}
  assert reply.count is 1

test issue 1873 the view's copy pastes into a document with its bold, as another app's rich copy
  # Last: the document it pastes into stays open (and edited).
  call backstage {"action":"open"}
  call backstage-page {"page":"new"}
  call new-card {"card":"new-mail-card"}
  shot window
  call pointer-drag {"from":"ext-doc-word:Alpha:start","to":"ext-doc-word:Gamma:end"}
  call real-key {"key":"ctrl+c"}
  call clipboard {"action":"read"}
  assert reply.rtf_bold is Beta
  open copy:../fixtures/basic.docx
  key ctrl+v
  assert text is Alpha Beta Gamma
  call selection-set {"start":8,"end":8}
  assert run.bold is true
  call selection-set {"start":2,"end":2}
  assert run.bold is false
