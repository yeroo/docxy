# The Project input outside the dialogs, typed into with real keys only
# (#1203, the Project slice of #1029): the grid's inline cell editor. Written
# by hand, not generated: the dialog catalogue's `inputs-typing-*.uit` own
# that prefix.
#
# The input is focused by `pointer-click {"input":"project-cell"}`: a
# double-click on the cursor's cell. Keys go by `real-key` and `real-type`
# only; `open` and `click <cell>` are setup. A test is one input and one
# step, named `project <input>: <step>`; each opens its own copy of
# project-clipboard.xml (tasks A and B, both As Soon As Possible). Expected
# values follow Project. The steps that fail today are in
# expected-failures.txt. See qa/inputs-typing.md.
#
# Task > Information... was once a second input here, the prompt bar's
# Constraint prompt. It is the catalogued Task Information dialog now
# (#1368), which `inputs-typing-project.uit` types into.

# ---- The cell editor: a double-click on the cursor's cell opens it, with
# the cell's text and the caret at its end. The typing steps use the entry
# row's Name, which starts empty; Enter there appends a task.

test project project-cell: focus by click
  open copy:../fixtures/project-clipboard.xml
  click C1
  assert cell_edit is none
  call field-read {"input":"project-cell"}
  assert reply.focused is false
  assert reply.value is A
  call pointer-click {"input":"project-cell"}
  assert reply.clicks is 2
  call field-read {"input":"project-cell"}
  assert reply.focused is true
  assert reply.value is A
  assert reply.caret is 1
  assert reply.selection is null
  assert cell_edit is A
  assert selected_row is 1
  call real-key {"key":"escape"}

test project project-cell: types
  open copy:../fixtures/project-clipboard.xml
  click C3
  call pointer-click {"input":"project-cell"}
  call field-read {"input":"project-cell"}
  assert reply.value is exactly ""
  call real-type {"text":"Ab1 "}
  call field-read {"input":"project-cell"}
  assert reply.focused is true
  assert reply.value is exactly "Ab1 "
  assert reply.caret is 4
  call real-key {"key":"escape"}

test project project-cell: edits
  open copy:../fixtures/project-clipboard.xml
  click C3
  call pointer-click {"input":"project-cell"}
  call real-type {"text":"abcd"}
  call real-key {"key":"backspace"}
  call field-read {"input":"project-cell"}
  assert reply.value is abc
  call real-key {"key":"home"}
  call field-read {"input":"project-cell"}
  assert reply.caret is 0
  call real-key {"key":"right"}
  call real-key {"key":"delete"}
  call field-read {"input":"project-cell"}
  assert reply.value is ac
  call real-key {"key":"end"}
  call real-key {"key":"left"}
  call field-read {"input":"project-cell"}
  assert reply.caret is 1
  call real-type {"text":"X"}
  call field-read {"input":"project-cell"}
  assert reply.value is aXc
  assert reply.caret is 2
  call real-key {"key":"escape"}

test project project-cell: select-all replaces
  open copy:../fixtures/project-clipboard.xml
  click C3
  call pointer-click {"input":"project-cell"}
  call real-type {"text":"abcd"}
  call real-key {"key":"ctrl+a"}
  call field-read {"input":"project-cell"}
  assert reply.focused is true
  assert reply.selection is [0,4]
  call real-type {"text":"X"}
  call field-read {"input":"project-cell"}
  assert reply.value is X
  call real-key {"key":"escape"}

# Ctrl+C in the cell editor copies its whole buffer (#561), so this passes
# without the Ctrl+A that selects it; `select-all replaces` pins Ctrl+A.
test project project-cell: copies
  open copy:../fixtures/project-clipboard.xml
  click C3
  call clipboard {"action":"write","text":"before"}
  call pointer-click {"input":"project-cell"}
  call real-type {"text":"abcd"}
  call real-key {"key":"ctrl+a"}
  call real-key {"key":"ctrl+c"}
  call clipboard {"action":"read"}
  assert reply.text is abcd
  assert cell_edit is abcd
  call real-key {"key":"escape"}

test project project-cell: pastes
  open copy:../fixtures/project-clipboard.xml
  click C3
  call clipboard {"action":"write","text":"Pasted"}
  call pointer-click {"input":"project-cell"}
  call real-key {"key":"ctrl+v"}
  call field-read {"input":"project-cell"}
  assert reply.focused is true
  assert reply.value is Pasted
  assert reply.caret is 6
  call real-key {"key":"escape"}

test project project-cell: Enter commits
  open copy:../fixtures/project-clipboard.xml
  click C1
  assert dirty is false
  call pointer-click {"input":"project-cell"}
  call real-type {"text":"b1"}
  call real-key {"key":"enter"}
  assert cell_edit is none
  assert cell C1 is exactly Ab1
  assert selected_row is 2
  assert cell is Name
  assert dirty is true

test project project-cell: Enter on the entry row appends a task
  open copy:../fixtures/project-clipboard.xml
  click C3
  assert tasks is 2
  call pointer-click {"input":"project-cell"}
  call real-type {"text":"Ab1"}
  call real-key {"key":"enter"}
  assert cell_edit is none
  assert tasks is 3
  assert cell C3 is exactly Ab1
  assert dirty is true

test project project-cell: Tab commits and moves right
  open copy:../fixtures/project-clipboard.xml
  click C1
  call pointer-click {"input":"project-cell"}
  call real-type {"text":"b1"}
  call real-key {"key":"tab"}
  assert cell_edit is none
  assert cell C1 is exactly Ab1
  assert selected_row is 1
  assert cell is Duration
  assert dirty is true

test project project-cell: Escape cancels
  open copy:../fixtures/project-clipboard.xml
  click C1
  call pointer-click {"input":"project-cell"}
  call real-type {"text":"b1"}
  call real-key {"key":"escape"}
  assert cell_edit is none
  assert cell C1 is exactly A
  assert selected_row is 1
  assert dirty is false

# The split bar dragged left narrows the table: the Name cell's middle is
# past its edge, so the press lands on what the table shows of it, as
# `click C1` does, not on the split bar or the chart.
test project project-cell: focus by click in a narrowed table
  open copy:../fixtures/project-clipboard.xml
  call pointer-drag {"from":"project-split","to":"cell:B1"}
  click C1
  assert cell_edit is none
  call pointer-click {"input":"project-cell"}
  assert reply.clicks is 2
  assert cell_edit is A
  assert cell is Name
  call real-key {"key":"escape"}

test project project-cell: a click is refused while a cell is open
  open copy:../fixtures/project-clipboard.xml
  click C1
  call pointer-click {"input":"project-cell"}
  call-error pointer-click {"input":"project-cell"} => a Project cell edit is already open; a click on a cell commits it
  assert cell_edit is A
  call real-key {"key":"escape"}
