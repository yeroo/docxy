test project task-info: Enter commits
  open copy:../fixtures/project-clipboard.xml
  click C1
  assert dirty is false
  call real-key {"key":"alt"}
  call real-key {"key":"t"}
  call real-key {"key":"c"}
  call pointer-click {"input":"task-info"}
  call real-type {"text":"SNET 2026-01-19"}
  call real-key {"key":"enter"}
  assert prompt is none
  assert status is Constraint set: SNET
  assert dirty is true
  call field-read {"input":"task-info"}
  assert reply.focused is false
  call real-key {"key":"alt"}
  call real-key {"key":"t"}
  call real-key {"key":"c"}
  call field-read {"input":"task-info"}
  assert reply.value is SNET 2026-01-19
  call real-key {"key":"escape"}

test project task-info: Escape cancels
  open copy:../fixtures/project-clipboard.xml
  click C1
  call real-key {"key":"alt"}
  call real-key {"key":"t"}
  call real-key {"key":"c"}
  call pointer-click {"input":"task-info"}
  call real-type {"text":"SNET 2026-01-19"}
  call real-key {"key":"escape"}
  assert prompt is none
  assert dirty is false
  call real-key {"key":"alt"}
  call real-key {"key":"t"}
  call real-key {"key":"c"}
  call field-read {"input":"task-info"}
  assert reply.value is exactly ""
  call real-key {"key":"escape"}

# Another prompt kind is the same field, but not this input: field-read
# does not report its buffer as Information...'s, and a click is refused.
test project task-info: another prompt is not it
  open copy:../fixtures/project-clipboard.xml
  click C1
  call real-key {"key":"alt"}
  call real-key {"key":"t"}
  call real-key {"key":"p"}
  assert prompt is predecessor:
  call-error pointer-click {"input":"task-info"} => the open prompt is predecessor, not Task > Information...'s constraint
  call field-read {"input":"task-info"}
  assert reply.focused is false
  assert reply.value is null
  call real-key {"key":"escape"}
