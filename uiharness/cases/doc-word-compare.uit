# The page view against Word for the web (#2231). The owner compared a real
# document in Print Layout with Word for the web; the fixture
# (`fixtures/word-compare.docx`, generated by `ext_fixture::word_compare_docx`)
# has its four shapes in made-up text:
#
# - block 0, a `Title` whose style has a bottom rule `w:sz="8" w:space="4"`
#   in `4F81BD` (`w:themeColor="accent1"`): drawn 1.33 px wide, 4 pt below
#   the text, in the theme's accent on the light page and mapped as a
#   border on the dark one (where `4F81BD` already reads at 3:1, so kept);
# - blocks 1 and 2, `ListParagraph` (`w:ind w:left="720"`) bullets of a list
#   whose level 0 has `w:ind w:left="720" w:hanging="360"`: the bullet at
#   0.25" (24 px) and the text and its wrapped lines at 0.5" (48 px) from the
#   text column; the mark names Segoe UI, the text Arial (Liberation Sans on
#   Linux, and Segoe UI an Arial-width face, never DejaVu Sans);
# - block 3, yellow highlights under explicit `212121` text ("Explicit") and
#   automatic text ("Automatic"): `ffff00` on the light page; Word's dark
#   mode measured `3C3C00` with `DDDDDD` (ours `dedede`) and `49492B` with
#   `F5F5F5` on the dark page;
# - blocks 5 and 6, a direct box border (`C0504D`) shared by two paragraphs:
#   the box's top on the first, `w:between` above the second, its bottom on
#   the second only.
#
# `doc`'s `page.layout` is Print Layout's paragraphs as last painted: per
# paragraph its marker (x from the text column, family), its lines' x, its
# highlighted runs' fill and ink, and its border sides (`gap`: the space to
# the text). Each read follows a `shot`, which waits for the frame.

test issue 2231 the page view draws the Word shapes on the light page
  open copy:../fixtures/word-compare.docx
  call window-size {"w":1100,"h":900}
  call theme-set {"theme":"light"}
  assert reply.applied is light
  call ribbon-click {"tab":"View","command":"Print Layout"}
  assert view.layout is print
  shot window
  call doc {}
  assert reply.page_mode is light
  # The title's accent rule, 4 pt (5.33 px) below its text: 6 px once
  # layout places the strip and the text on whole pixels.
  assert reply.page.layout.paragraphs.0.borders.0.side is bottom
  assert reply.page.layout.paragraphs.0.borders.0.color is 4f81bd
  assert reply.page.layout.paragraphs.0.borders.0.width is 1.33
  assert reply.page.layout.paragraphs.0.borders.0.gap is 6
  # The bullets: marker at 0.25", text and wrapped lines at 0.5".
  assert reply.page.layout.paragraphs.1.marker.x is 24
  assert reply.page.layout.paragraphs.1.text_x is 48
  assert reply.page.layout.paragraphs.1.marker.family is Liberation Sans
  assert reply.page.layout.paragraphs.2.marker.x is 24
  assert reply.page.layout.paragraphs.2.lines.0.x is 48
  assert reply.page.layout.paragraphs.2.lines.1.x is 48
  # The highlights as before.
  assert reply.page.layout.paragraphs.3.highlights.0.text is Explicit
  assert reply.page.layout.paragraphs.3.highlights.0.fill is ffff00
  assert reply.page.layout.paragraphs.3.highlights.1.text is Automatic
  assert reply.page.layout.paragraphs.3.highlights.1.fill is ffff00
  # One box over blocks 5 and 6: top, sides; between, sides, bottom.
  assert reply.page.layout.paragraphs.5.borders.0.side is top
  assert reply.page.layout.paragraphs.5.borders.0.color is c0504d
  assert reply.page.layout.paragraphs.5.borders.2.side is right
  assert reply.page.layout.paragraphs.6.borders.0.side is top
  assert reply.page.layout.paragraphs.6.borders.2.side is bottom
  assert reply.inks.all_readable is true
  # Arial draws in its metric-compatible Liberation Sans.
  call doc-word {"text":"Alpha"}
  assert reply.face.family is Liberation Sans
  # The window keeps its view across tests: back to Web Layout.
  call ribbon-click {"tab":"View","command":"Print Layout"}
  assert view.layout is web
  call theme-set {"theme":"auto"}

test issue 2231 the page view draws the Word shapes on the dark page
  open copy:../fixtures/word-compare.docx
  call window-size {"w":1100,"h":900}
  call theme-set {"theme":"dark"}
  assert reply.applied is dark
  call ribbon-click {"tab":"View","command":"Print Layout"}
  assert view.layout is print
  shot window
  call doc {}
  assert reply.page_mode is dark
  # The title's rule, its accent mapped as a border on the dark page.
  assert reply.page.layout.paragraphs.0.borders.0.side is bottom
  assert reply.page.layout.paragraphs.0.borders.0.color is 4f81bd
  assert reply.page.layout.paragraphs.0.borders.0.gap is 6
  assert reply.page.layout.paragraphs.1.marker.x is 24
  assert reply.page.layout.paragraphs.2.lines.1.x is 48
  # Word's dark-mode highlights, measured: 3C3C00 / DDDDDD, 49492B / F5F5F5.
  assert reply.page.layout.paragraphs.3.highlights.0.fill is 3c3c00
  assert reply.page.layout.paragraphs.3.highlights.0.ink is dedede
  assert reply.page.layout.paragraphs.3.highlights.1.fill is 49492b
  assert reply.page.layout.paragraphs.3.highlights.1.ink is f5f5f5
  assert reply.page.layout.paragraphs.4.highlights.0.fill is 49492b
  assert reply.inks.all_readable is true
  call ribbon-click {"tab":"View","command":"Print Layout"}
  assert view.layout is web
  call theme-set {"theme":"auto"}
