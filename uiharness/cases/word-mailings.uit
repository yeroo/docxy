# #628: Word's Mailings tab. Commands that need recipients wait for a list;
# mail-attach hands in the list Use an Existing List... would pick; Insert
# Merge Field lists its columns; Preview Results shows a record in place;
# Finish & Merge > Edit Individual Documents... opens the merged document.

test the Mailings tab sits between Layout and Review and waits for a list
  open ../fixtures/basic.docx
  call ribbon-read {}
  assert reply.tabs.4.name is Layout
  assert reply.tabs.5.name is Mailings
  assert reply.tabs.5.key_tip is M
  assert reply.tabs.6.name is Review
  assert reply.tabs.5.groups.0.title is Create
  assert reply.tabs.5.groups.0.commands.0.label is Envelopes
  assert reply.tabs.5.groups.0.commands.0.enabled is true
  assert reply.tabs.5.groups.1.commands.0.label is Start Mail Merge
  assert reply.tabs.5.groups.1.commands.0.enabled is true
  assert reply.tabs.5.groups.1.commands.10.label is Use an Existing List...
  assert reply.tabs.5.groups.1.commands.10.enabled is true
  assert reply.tabs.5.groups.1.commands.12.label is Edit Recipient List
  assert reply.tabs.5.groups.1.commands.12.enabled is false
  assert reply.tabs.5.groups.2.commands.0.label is Highlight Merge Fields
  assert reply.tabs.5.groups.2.commands.0.enabled is false
  assert reply.tabs.5.groups.2.commands.1.enabled is false
  assert reply.tabs.5.groups.2.commands.2.enabled is false
  assert reply.tabs.5.groups.2.commands.3.label is Insert Merge Field
  assert reply.tabs.5.groups.2.commands.3.enabled is false
  assert reply.tabs.5.groups.2.commands.4.label is Rules
  assert reply.tabs.5.groups.2.commands.4.enabled is false
  assert reply.tabs.5.groups.2.commands.14.label is Match Fields
  assert reply.tabs.5.groups.2.commands.14.enabled is false
  assert reply.tabs.5.groups.3.commands.0.label is Preview Results
  assert reply.tabs.5.groups.3.commands.0.enabled is false
  assert reply.tabs.5.groups.3.commands.4.label is Next Record
  assert reply.tabs.5.groups.3.commands.4.enabled is false
  assert reply.tabs.5.groups.3.commands.6.label is Find Recipient
  assert reply.tabs.5.groups.3.commands.6.enabled is false
  assert reply.tabs.5.groups.3.commands.7.label is Check for Errors
  assert reply.tabs.5.groups.3.commands.7.enabled is false
  assert reply.tabs.5.groups.4.commands.0.label is Finish & Merge
  assert reply.tabs.5.groups.4.commands.0.enabled is false
  key alt m escape escape
  assert ribbon_tab is Mailings
  shot window

test the follow-ups are drawn disabled and say so
  open ../fixtures/basic.docx
  call ribbon-read {}
  assert reply.tabs.5.groups.1.commands.7.label is Step-by-Step Mail Merge Wizard...
  assert reply.tabs.5.groups.1.commands.7.enabled is false
  assert reply.tabs.5.groups.1.commands.7.tip.body is Not available yet: the Mail Merge Wizard is a follow-up.
  assert reply.tabs.5.groups.4.commands.2.label is Print Documents...
  assert reply.tabs.5.groups.4.commands.2.enabled is false
  assert reply.tabs.5.groups.4.commands.2.tip.body is Not available yet: printing merged documents is a follow-up.
  call menu-open {"target":{"ribbon":["Mailings","Start Mail Merge","Start Mail Merge"]}}
  assert reply.items.0.label is Letters
  assert reply.items.0.enabled is true
  assert reply.items.8.label is Step-by-Step Mail Merge Wizard...
  assert reply.items.8.enabled is false
  call menu-close {}

test Use an Existing List refuses in words in a harness
  open ../fixtures/basic.docx
  call ribbon-click {"tab":"Mailings","command":"Use an Existing List..."}
  assert status is Use an Existing List opens a native file dialog: use the harness mail-attach verb
  call-error mail-attach {"path":"basic.docx"} => recipient lists are .csv or .txt files

test a list enables the tab, Insert Merge Field lists its columns, and Preview shows each record
  open ../fixtures/basic.docx
  key ctrl+a
  type Dear
  call mail-attach {"path":"recipients.csv"}
  assert reply.rows is 3
  assert reply.columns.0 is First Name
  assert mail.doc_type is Letters
  assert mail.rows is 3
  assert dirty is true
  call ribbon-read {}
  assert reply.tabs.5.groups.1.commands.12.enabled is true
  assert reply.tabs.5.groups.2.commands.0.enabled is true
  assert reply.tabs.5.groups.2.commands.3.enabled is true
  assert reply.tabs.5.groups.3.commands.0.enabled is true
  assert reply.tabs.5.groups.3.commands.4.enabled is true
  assert reply.tabs.5.groups.4.commands.0.enabled is true
  call menu-open {"target":{"ribbon":["Mailings","Write & Insert Fields","Insert Merge Field"]}}
  assert reply.items.0.label is First Name
  assert reply.items.6.label is Postal Code
  call menu-click {"label":"First Name"}
  assert status is Inserted merge field First Name
  assert mail.text is Dear«First Name»
  call ribbon-click {"tab":"Mailings","command":"Preview Results"}
  assert mail.preview is true
  assert mail.text is DearJane
  call ribbon-click {"tab":"Mailings","command":"mailnext"}
  assert mail.record is 2
  assert mail.text is DearJohn
  assert status is Record 2 of 3
  shot window
  call ribbon-click {"tab":"Mailings","command":"Preview Results"}
  assert mail.text is Dear«First Name»

test Finish and Merge opens one letter per recipient in a new tab
  open ../fixtures/basic.docx
  key ctrl+a
  type Dear
  call mail-attach {"path":"recipients.csv"}
  call menu-open {"target":{"ribbon":["Mailings","Write & Insert Fields","Insert Merge Field"]}}
  call menu-click {"label":"First Name"}
  call ribbon-click {"tab":"Mailings","command":"Edit Individual Documents..."}
  assert dialog is mail-merge-new
  call dialog-read {}
  assert reply.title is Merge to New Document
  assert reply.controls.0.value is All
  call dialog-click {"button":"OK"}
  assert dialog is none
  assert title is Letters1.docx
  assert mail.text is DearJane¶DearJohn¶DearAmy
  assert mail.doc_type is nothing
  shot window

test Edit Recipient List leaves a recipient out of the merge
  open ../fixtures/basic.docx
  call mail-attach {"path":"recipients.csv"}
  call ribbon-click {"tab":"Mailings","command":"Edit Recipient List"}
  assert dialog is mail-recipients
  call dialog-set {"control":"record","value":"2"}
  call dialog-set {"control":"include","value":false}
  call dialog-click {"button":"OK"}
  assert status is 2 recipients included
  call ribbon-click {"tab":"Mailings","command":"Last Record"}
  assert mail.record is 3
  call ribbon-click {"tab":"Mailings","command":"Previous Record"}
  assert mail.record is 1

test Envelopes adds an envelope section before the letter
  open ../fixtures/basic.docx
  key ctrl+a
  type Dear Jane
  call ribbon-click {"tab":"Mailings","command":"Envelopes"}
  assert dialog is mail-envelopes
  call dialog-set {"control":"delivery","value":"Jane Doe;1 Main St"}
  call dialog-set {"control":"return","value":"Acme"}
  call dialog-click {"button":"Add to Document"}
  assert dialog is none
  assert status is Envelope added: Size 10 (4 1/8 x 9 1/2 in)
  assert mail.text is Acme¶Jane Doe¶1 Main St¶Dear Jane
  key ctrl+z
  assert mail.text is Dear Jane
