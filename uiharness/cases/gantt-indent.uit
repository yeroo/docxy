test gantt indent outdent undo and redo reschedule
  open ../fixtures/gantt-indent.xml
  assert bar_1 is on-track 0-0
  assert dirty is false
  key down
  assert selected_task is 1
  key alt+shift+right
  assert bar_1 is summary 0-3
  assert dirty is true
  shot gantt
  key alt+shift+left
  assert bar_1 is on-track 0-0
  key ctrl+z
  assert bar_1 is summary 0-3
  key ctrl+y
  assert bar_1 is on-track 0-0
  shot gantt
