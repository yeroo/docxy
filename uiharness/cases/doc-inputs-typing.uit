  call clipboard {"action":"write","text":"old"}
  call pointer-click {"input":"doc-font-size"}
  call real-type {"text":"abcd"}
  call real-key {"key":"ctrl+a"}
  call real-key {"key":"ctrl+c"}
  call clipboard {"action":"read"}
  assert reply.text is abcd
  call real-key {"key":"escape"}

test document doc-font-size: pastes
  open copy:../fixtures/doc-table.docx
  call real-key {"key":"escape"}
  call selection-set {"start":0,"end":6}
  call clipboard {"action":"write","text":"Pasted"}
  call pointer-click {"input":"doc-font-size"}
  call real-key {"key":"ctrl+v"}
  call field-read {"input":"doc-font-size"}
  assert reply.focused is true
  assert reply.value is Pasted
  assert reply.caret is 6
  call real-key {"key":"escape"}

test document doc-font-size: Enter formats the selection
  open copy:../fixtures/doc-table.docx
  call real-key {"key":"escape"}
  call selection-set {"start":0,"end":6}
  call pointer-click {"input":"doc-font-size"}
  call real-type {"text":"14"}
  call real-key {"key":"enter"}
  assert dirty is true
  call selection-set {"start":0,"end":6}
  call field-read {"input":"doc-font-size"}
  assert reply.value is 14
  assert run.size_half_pts is 28
  call real-key {"key":"escape"}

test document doc-font-size: Escape cancels
  open copy:../fixtures/doc-table.docx
  call real-key {"key":"escape"}
  call selection-set {"start":0,"end":6}
  call pointer-click {"input":"doc-font-size"}
  call real-type {"text":"14"}
  call field-read {"input":"doc-font-size"}
  assert reply.focused is true
  assert reply.value is 14
  call real-key {"key":"escape"}
  assert dirty is false
  call field-read {"input":"doc-font-size"}
  assert reply.focused is false
  assert reply.value is 11

# ---- The comment editor: Review > New Comment on `before` opens it,
# focused. Enter adds the comment, Escape drops it. It has no Tab stop.

test document comment-editor: New Comment focuses it
  open copy:../fixtures/doc-table.docx
  call real-key {"key":"escape"}
  call selection-set {"start":0,"end":6}
  call ribbon-click {"tab":"Review","command":"New Comment"}
  call field-read {"input":"comment-editor"}
  assert reply.focused is true
  assert reply.value is exactly ""
  assert reply.caret is 0
  call real-key {"key":"escape"}

test document comment-editor: types
  open copy:../fixtures/doc-table.docx
  call real-key {"key":"escape"}
  call selection-set {"start":0,"end":6}
  call ribbon-click {"tab":"Review","command":"New Comment"}
  call pointer-click {"input":"comment-editor"}
  call real-type {"text":"Ab1 "}
  call field-read {"input":"comment-editor"}
  assert reply.focused is true
  assert reply.value is exactly "Ab1 "
  assert reply.caret is 4
  call real-key {"key":"escape"}

test document comment-editor: edits
  open copy:../fixtures/doc-table.docx
  call real-key {"key":"escape"}
  call selection-set {"start":0,"end":6}
  call ribbon-click {"tab":"Review","command":"New Comment"}
  call pointer-click {"input":"comment-editor"}
  call real-type {"text":"abcd"}
  call real-key {"key":"backspace"}
  call field-read {"input":"comment-editor"}
  assert reply.value is abc
  call real-key {"key":"home"}
  call field-read {"input":"comment-editor"}
  assert reply.caret is 0
  call real-key {"key":"right"}
  call real-key {"key":"delete"}
  call field-read {"input":"comment-editor"}
  assert reply.value is ac
  call real-key {"key":"end"}
  call real-key {"key":"left"}
  call field-read {"input":"comment-editor"}
  assert reply.caret is 1
  call real-type {"text":"X"}
  call field-read {"input":"comment-editor"}
  assert reply.value is aXc
  assert reply.caret is 2
  call real-key {"key":"escape"}

test document comment-editor: select-all replaces
  open copy:../fixtures/doc-table.docx
  call real-key {"key":"escape"}
  call selection-set {"start":0,"end":6}
  call ribbon-click {"tab":"Review","command":"New Comment"}
  call pointer-click {"input":"comment-editor"}
  call real-type {"text":"abcd"}
  call real-key {"key":"ctrl+a"}
  call field-read {"input":"comment-editor"}
  assert reply.focused is true
  assert reply.selection is [0,4]
  call real-type {"text":"X"}
  call field-read {"input":"comment-editor"}
  assert reply.value is X
  call real-key {"key":"escape"}

test document comment-editor: copies
  open copy:../fixtures/doc-table.docx
  call real-key {"key":"escape"}
  call selection-set {"start":0,"end":6}
  call ribbon-click {"tab":"Review","command":"New Comment"}
  call clipboard {"action":"write","text":"old"}
  call pointer-click {"input":"comment-editor"}
  call real-type {"text":"abcd"}
  call real-key {"key":"ctrl+a"}
  call real-key {"key":"ctrl+c"}
  call clipboard {"action":"read"}
  assert reply.text is abcd
  call real-key {"key":"escape"}

test document comment-editor: pastes
  open copy:../fixtures/doc-table.docx
  call real-key {"key":"escape"}
  call selection-set {"start":0,"end":6}
  call ribbon-click {"tab":"Review","command":"New Comment"}
  call clipboard {"action":"write","text":"Pasted"}
  call pointer-click {"input":"comment-editor"}
  call real-key {"key":"ctrl+v"}
  call field-read {"input":"comment-editor"}
  assert reply.focused is true
  assert reply.value is Pasted
  assert reply.caret is 6
  call real-key {"key":"escape"}

test document comment-editor: Enter adds the comment
  open copy:../fixtures/doc-table.docx
  call real-key {"key":"escape"}
  call selection-set {"start":0,"end":6}
  call ribbon-click {"tab":"Review","command":"New Comment"}
  call pointer-click {"input":"comment-editor"}
  call real-type {"text":"Ab1"}
  call real-key {"key":"enter"}
  call field-read {"input":"comment-editor"}
  assert reply.focused is false
  assert dirty is true
  call comments {}
  assert reply.comments.0.text is exactly Ab1

test document comment-editor: Escape cancels
  open copy:../fixtures/doc-table.docx
  call real-key {"key":"escape"}
  call selection-set {"start":0,"end":6}
  call ribbon-click {"tab":"Review","command":"New Comment"}
  call pointer-click {"input":"comment-editor"}
  call real-type {"text":"Ab1"}
  call field-read {"input":"comment-editor"}
  assert reply.value is exactly Ab1
  call real-key {"key":"escape"}
  call field-read {"input":"comment-editor"}
  assert reply.focused is false
  assert dirty is false
  call comments {}
  assert reply.comments is []

test document comment-editor: keeps the keys over Ctrl+F
  open copy:../fixtures/doc-table.docx
  call real-key {"key":"escape"}
  call selection-set {"start":0,"end":6}
  call ribbon-click {"tab":"Review","command":"New Comment"}
  call real-key {"key":"ctrl+f"}
  call real-type {"text":"Ab"}
  call field-read {"input":"comment-editor"}
  assert reply.focused is true
  assert reply.value is exactly Ab
  call field-read {"input":"doc-find"}
  assert reply.focused is false
  call field-read {"input":"doc-replace"}
  assert reply.focused is false
  call real-key {"key":"escape"}
  call real-key {"key":"escape"}
