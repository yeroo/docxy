test document doc-replace: Enter replaces the current match
  open copy:../fixtures/doc-table.docx
  call real-key {"key":"escape"}
  call real-key {"key":"ctrl+f"}
  assert find_open is true
  call pointer-click {"input":"doc-find"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"doc-replace"}
  call real-key {"key":"backspace","times":60}
  call selection-set {"start":0,"end":0}
  assert find_open is true
  call pointer-click {"input":"doc-find"}
  call real-type {"text":"cell"}
  call pointer-click {"input":"doc-replace"}
  call real-type {"text":"X"}
  assert dirty is false
  call real-key {"key":"enter"}
  assert dirty is true
  call selection-set {"start":7,"end":7}
  assert table.cells is [[["X A"],["cell B"]]]
  call real-key {"key":"escape"}

test document doc-replace: Replace rewrites one match
  open copy:../fixtures/doc-table.docx
  call real-key {"key":"escape"}
  call real-key {"key":"ctrl+f"}
  assert find_open is true
  call pointer-click {"input":"doc-find"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"doc-replace"}
  call real-key {"key":"backspace","times":60}
  call selection-set {"start":0,"end":0}
  assert find_open is true
  call pointer-click {"input":"doc-find"}
  call real-type {"text":"cell"}
  call pointer-click {"input":"doc-replace"}
  call real-type {"text":"X"}
  assert dirty is false
  call pointer-click {"at":"doc-replace-button"}
  assert dirty is true
  call selection-set {"start":7,"end":7}
  assert table.cells is [[["X A"],["cell B"]]]
  call real-key {"key":"escape"}

test document doc-replace: All rewrites every match
  open copy:../fixtures/doc-table.docx
  call real-key {"key":"escape"}
  call real-key {"key":"ctrl+f"}
  assert find_open is true
  call pointer-click {"input":"doc-find"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"doc-replace"}
  call real-key {"key":"backspace","times":60}
  call selection-set {"start":0,"end":0}
  assert find_open is true
  call pointer-click {"input":"doc-find"}
  call real-type {"text":"cell"}
  call pointer-click {"input":"doc-replace"}
  call real-type {"text":"X"}
  assert dirty is false
  call pointer-click {"at":"doc-replace-all-button"}
  assert dirty is true
  call selection-set {"start":7,"end":7}
  assert table.cells is [[["X A"],["X B"]]]
  call real-key {"key":"escape"}

test document doc-replace: Escape closes the bar
  open copy:../fixtures/doc-table.docx
  call real-key {"key":"escape"}
  call real-key {"key":"ctrl+f"}
  assert find_open is true
  call pointer-click {"input":"doc-find"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"doc-replace"}
  call real-key {"key":"backspace","times":60}
  call selection-set {"start":0,"end":0}
  assert find_open is true
  call pointer-click {"input":"doc-replace"}
  call real-type {"text":"Ab1"}
  call field-read {"input":"doc-replace"}
  assert reply.focused is true
  assert reply.value is exactly Ab1
  call real-key {"key":"escape"}
  assert find_open is false
  assert dirty is false
  call field-read {"input":"doc-replace"}
  assert reply.focused is false

# ---- Home > Font and Font Size: a click selects the box's text, Enter
# formats the selection (`before`) with what was typed, Escape gives the
# value back. doc-table.docx's runs set no font or size, so the boxes
# show Word's defaults, Calibri and 11: hence [0,7] and [0,2].

test document doc-font: focus by click
  open copy:../fixtures/doc-table.docx
  call real-key {"key":"escape"}
  call selection-set {"start":0,"end":6}
  call pointer-click {"input":"doc-font"}
  call field-read {"input":"doc-font"}
  assert reply.focused is true
  assert reply.value is Calibri
  assert reply.selection is [0,7]
  call real-key {"key":"escape"}

test document doc-font: types
  open copy:../fixtures/doc-table.docx
