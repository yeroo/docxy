# The document's inputs outside the dialogs, typed into with real keys
# only (#1201, the document slice of #1029): the Find bar's Find and
# Replace fields, the Home ribbon's Font and Font Size boxes and the comment
# editor. The suite has no Styles gallery search, so there is none to type
# into. Written by hand, not generated: the dialog catalogue's
# `inputs-typing-*.uit` own that prefix.
#
# `real-key` and `real-type` go through the window's own input path, and an
# input is focused by `pointer-click {"input":id}` or by Tab, but the
# comment editor, which Review > New Comment opens focused. `open`,
# `selection-set` and `ribbon-click` (Review > New Comment) are setup only,
# and the checks after may use handler verbs. A test is one input and one
# step, named `document <input>: <step>`; each opens its own copy of
# doc-table.docx (`before`, a table row `cell A` | `cell B`, `after`), so a
# key that lands in the document does not leak into the next test, and
# first presses Escape, which closes a Find bar or comment bar an earlier
# test left open (both are the window's, not the tab's). Expected values
# follow Word, except that Enter in the Replace field replaces the current
# match, as this bar says it does (`replace_one`), where Word's Replace
# dialog's default button is Find Next. The steps that fail today are in
# expected-failures.txt. See qa/inputs-typing.md.

# ---- The Find bar's Find field: typing finds as it goes; Enter selects
# the next match.

test document doc-find: focus by click
  open copy:../fixtures/doc-table.docx
  call real-key {"key":"escape"}
  call real-key {"key":"ctrl+f"}
  assert find_open is true
  call pointer-click {"input":"doc-find"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"doc-replace"}
  call real-key {"key":"backspace","times":60}
  call selection-set {"start":0,"end":0}
  assert find_open is true
  call pointer-click {"input":"doc-replace"}
  call pointer-click {"input":"doc-find"}
  call field-read {"input":"doc-find"}
  assert reply.focused is true
  assert reply.value is exactly ""
  assert reply.caret is 0
  call field-read {"input":"doc-replace"}
  assert reply.focused is false
  call real-key {"key":"escape"}

test document doc-find: types
  open copy:../fixtures/doc-table.docx
  call real-key {"key":"escape"}
  call real-key {"key":"ctrl+f"}
  assert find_open is true
  call pointer-click {"input":"doc-find"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"doc-replace"}
  call real-key {"key":"backspace","times":60}
  call selection-set {"start":0,"end":0}
  assert find_open is true
  call pointer-click {"input":"doc-find"}
  call real-type {"text":"Ab1 "}
  call field-read {"input":"doc-find"}
  assert reply.focused is true
  assert reply.value is exactly "Ab1 "
  assert reply.caret is 4
  call real-key {"key":"escape"}

test document doc-find: edits
  open copy:../fixtures/doc-table.docx
  call real-key {"key":"escape"}
  call real-key {"key":"ctrl+f"}
  assert find_open is true
  call pointer-click {"input":"doc-find"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"doc-replace"}
  call real-key {"key":"backspace","times":60}
  call selection-set {"start":0,"end":0}
  assert find_open is true
  call pointer-click {"input":"doc-find"}
  call real-type {"text":"abcd"}
  call real-key {"key":"backspace"}
  call field-read {"input":"doc-find"}
  assert reply.value is abc
  call real-key {"key":"home"}
  call field-read {"input":"doc-find"}
  assert reply.caret is 0
  call real-key {"key":"right"}
  call real-key {"key":"delete"}
  call field-read {"input":"doc-find"}
  assert reply.value is ac
  call real-key {"key":"end"}
  call real-key {"key":"left"}
  call field-read {"input":"doc-find"}
  assert reply.caret is 1
  call real-type {"text":"X"}
  call field-read {"input":"doc-find"}
  assert reply.value is aXc
  assert reply.caret is 2
  call real-key {"key":"escape"}

