test doc autocorrect-redefine: matches the catalogue
  open ../fixtures/basic.docx
  call autocorrect {}
  call dialog-set {"control":"replace","value":"zq"}
  call dialog-set {"control":"with","value":"one"}
  call dialog-click {"button":"Add"}
  call dialog-set {"control":"replace","value":"zq"}
  call dialog-set {"control":"with","value":"two"}
  call dialog-click {"button":"Add"}
  assert dialog is autocorrect-redefine
  call dialog-catalog-check {}
  call real-key {"key":"escape"}
