# GENERATED from suite/docxy/src/dialog/catalog/entries.rs by
# `UPDATE_INPUTS_TYPING=1 cargo test --manifest-path suite/Cargo.toml
# inputs_typing_case_is_current`; do not edit by hand (#1029).
#
# Every editable field of every doc dialog, typed into with real keys
# only: `real-key` and `real-type` go through the window's own input
# path, and the field is focused by a real click or by Tab. A test is
# one field and one step, named `<surface> <dialog>/<field>: <step>`.
# See qa/inputs-typing.md.

test doc save-on-close: matches the catalogue
  open copy:../fixtures/basic.docx
  type x
  key ctrl+w
  assert dialog is save-on-close
  call dialog-catalog-check {}
  call real-key {"key":"escape"}

test doc save-on-close/file-name: focus by click
  open copy:../fixtures/basic.docx
  type x
  key ctrl+w
  assert dialog is save-on-close
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"file-name"}
  call field-read {"dialog-field":"file-name"}
  assert reply.focused is true
  call real-key {"key":"escape"}

test doc save-on-close/file-name: focus by Tab
  open copy:../fixtures/basic.docx
  type x
  key ctrl+w
  assert dialog is save-on-close
  call dialog-catalog-check {}
  call real-key {"key":"tab","to-field":"file-name"}
  call field-read {"dialog-field":"file-name"}
  assert reply.focused is true
  call real-key {"key":"escape"}

test doc save-on-close/file-name: types
  open copy:../fixtures/basic.docx
  type x
  key ctrl+w
  assert dialog is save-on-close
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"file-name"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"Ab1 "}
  call field-read {"dialog-field":"file-name"}
  assert reply.value is "Ab1 "
  assert reply.caret is 4
  call real-key {"key":"escape"}

test doc save-on-close/file-name: edits
  open copy:../fixtures/basic.docx
  type x
  key ctrl+w
  assert dialog is save-on-close
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"file-name"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"abcd"}
  call real-key {"key":"backspace"}
  call field-read {"dialog-field":"file-name"}
  assert reply.value is abc
  call real-key {"key":"home"}
  call field-read {"dialog-field":"file-name"}
  assert reply.caret is 0
  call real-key {"key":"right"}
  call real-key {"key":"delete"}
  call field-read {"dialog-field":"file-name"}
  assert reply.value is ac
  call real-key {"key":"end"}
  call real-key {"key":"left"}
  call field-read {"dialog-field":"file-name"}
  assert reply.caret is 1
  call real-type {"text":"X"}
  call field-read {"dialog-field":"file-name"}
  assert reply.value is aXc
  assert reply.caret is 2
  call real-key {"key":"escape"}

test doc save-on-close/file-name: select-all replaces
  open copy:../fixtures/basic.docx
  type x
  key ctrl+w
  assert dialog is save-on-close
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"file-name"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"abcd"}
  call real-key {"key":"ctrl+a"}
  call field-read {"dialog-field":"file-name"}
  assert reply.selection.0 is 0
  assert reply.selection.1 is 4
  call real-type {"text":"X"}
  call field-read {"dialog-field":"file-name"}
  assert reply.value is X
  call real-key {"key":"escape"}

test doc save-on-close/file-name: pastes
  open copy:../fixtures/basic.docx
  type x
  key ctrl+w
  assert dialog is save-on-close
  call dialog-catalog-check {}
  call clipboard {"action":"write","text":"Pasted"}
  call pointer-click {"dialog-field":"file-name"}
  call real-key {"key":"ctrl+a"}
  call real-key {"key":"ctrl+v"}
  call field-read {"dialog-field":"file-name"}
  assert reply.value is Pasted
  call real-key {"key":"escape"}

test doc save-on-close/file-name: copies
  open copy:../fixtures/basic.docx
  type x
  key ctrl+w
  assert dialog is save-on-close
  call dialog-catalog-check {}
  call clipboard {"action":"write","text":"before"}
  call pointer-click {"dialog-field":"file-name"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"abcd"}
  call real-key {"key":"ctrl+a"}
  call real-key {"key":"ctrl+c"}
  call clipboard {"action":"read"}
  assert reply.text is abcd
  call real-key {"key":"escape"}

test doc save-on-close/file-name: OK applies
  open copy:../fixtures/basic.docx
  type x
  key ctrl+w
  assert dialog is save-on-close
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"file-name"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"Ab1 "}
  call real-key {"key":"enter"}
  assert dialog is not save-on-close

test doc save-on-close/file-name: Escape cancels
  open copy:../fixtures/basic.docx
  type x
  key ctrl+w
  assert dialog is save-on-close
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"file-name"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"Esc9"}
  call real-key {"key":"escape"}
  assert dialog is not save-on-close
  type x
  key ctrl+w
  assert dialog is save-on-close
  call dialog-catalog-check {}
  call field-read {"dialog-field":"file-name"}
  assert reply.value is not Esc9
  call real-key {"key":"escape"}

test doc save-on-close/location: focus by click
  open copy:../fixtures/basic.docx
  type x
  key ctrl+w
  assert dialog is save-on-close
