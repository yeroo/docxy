  call pointer-click {"dialog-control":"location"}
  call field-read {"dialog-field":"location"}
  assert reply.focused is true
  call real-key {"key":"escape"}

test doc save-on-close/location: Up and Down step
  open copy:../fixtures/basic.docx
  type x
  key ctrl+w
  assert dialog is save-on-close
  call dialog-catalog-check {}
  call real-key {"key":"tab","to-field":"location"}
  call field-read {"dialog-field":"location"}
  assert reply.focused is true
  call real-key {"key":"up","times":100}
  call field-read {"dialog-field":"location"}
  assert reply.index is 0
  call real-key {"key":"down"}
  call field-read {"dialog-field":"location"}
  assert reply.index is 1
  call real-key {"key":"escape"}

