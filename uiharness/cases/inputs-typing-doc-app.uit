test doc autocorrect/replace: Escape cancels
  open ../fixtures/basic.docx
  call autocorrect {}
  assert dialog is autocorrect
  call dialog-catalog-check {}
  call pointer-click {"dialog-tab":"AutoCorrect"}
  call pointer-click {"dialog-field":"replace"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"Esc9"}
  call real-key {"key":"escape"}
  assert dialog is not autocorrect
  call autocorrect {}
  assert dialog is autocorrect
  call dialog-catalog-check {}
  call pointer-click {"dialog-tab":"AutoCorrect"}
