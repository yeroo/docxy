  assert reply.value is not Esc9
  call real-key {"key":"escape"}

test doc pdf-export-png/dpi: focus by click
  open copy:../fixtures/pdf-view-text.pdf
  call pdf-read {"until_drawn":[1]}
  call backstage {"action":"open"}
  call pointer-click {"region":"bs-rail:pdf-export"}
  call pointer-click {"region":"pdf-export-png"}
  assert dialog is pdf-export-png
  call dialog-catalog-check {}
  call real-key {"key":"tab","to-field":"range"}
  call field-read {"dialog-field":"dpi"}
  assert reply.focused is false
  call pointer-click {"dialog-control":"dpi"}
  call field-read {"dialog-field":"dpi"}
  assert reply.focused is true
  call real-key {"key":"escape"}

test doc pdf-export-png/dpi: Up and Down step
  open copy:../fixtures/pdf-view-text.pdf
  call pdf-read {"until_drawn":[1]}
  call backstage {"action":"open"}
  call pointer-click {"region":"bs-rail:pdf-export"}
  call pointer-click {"region":"pdf-export-png"}
  assert dialog is pdf-export-png
  call dialog-catalog-check {}
  call real-key {"key":"tab","to-field":"dpi"}
  call field-read {"dialog-field":"dpi"}
  assert reply.focused is true
  call real-key {"key":"down"}
  call real-key {"key":"down"}
  call field-read {"dialog-field":"dpi"}
  assert reply.index is not 0
  assert reply.index is not null
  call real-key {"key":"up","times":100}
  call field-read {"dialog-field":"dpi"}
  assert reply.index is 0
  call real-key {"key":"down"}
  call field-read {"dialog-field":"dpi"}
  assert reply.index is 1
  call real-key {"key":"escape"}

