test sheet save-on-close: matches the catalogue
  open copy:../fixtures/basic.xlsx
  click B2
  type 5
  key enter
  call close-tab {}
  assert dialog is save-on-close
  call dialog-catalog-check {}
  call real-key {"key":"escape"}
