test sheet data-validation/error-style: Up and Down step
  open ../fixtures/basic.xlsx
  click B2
  call ribbon-click {"tab":"Data","command":"Data Validation"}
  assert dialog is data-validation
  call dialog-catalog-check {}
  call pointer-click {"dialog-tab":"Error Alert"}
  call real-key {"key":"tab","to-field":"error-style"}
  call field-read {"dialog-field":"error-style"}
  assert reply.focused is true
  call real-key {"key":"down"}
  call real-key {"key":"down"}
  call field-read {"dialog-field":"error-style"}
  assert reply.index is not 0
  assert reply.index is not null
  call real-key {"key":"up","times":100}
  call field-read {"dialog-field":"error-style"}
  assert reply.index is 0
  call real-key {"key":"down"}
  call field-read {"dialog-field":"error-style"}
  assert reply.index is 1
  call real-key {"key":"escape"}

