  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"entries"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"Esc9"}
  call real-key {"key":"escape"}
  assert dialog is not custom-lists
  call backstage {"action":"open"}
  call pointer-wheel {"region":"backstage-content","dy":-6000}
  shot window
  call pointer-click {"at":"custom-lists-row"}
  assert dialog is custom-lists
  call dialog-catalog-check {}
  call field-read {"dialog-field":"entries"}
  assert reply.value is not Esc9
  call real-key {"key":"escape"}

