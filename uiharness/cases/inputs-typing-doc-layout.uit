test doc page-setup/header: edits
  open ../fixtures/basic.docx
  call menu-open {"target":{"ribbon":["Layout","Page Setup","Margins"]}}
  call menu-click {"label":"Custom Margins..."}
  assert dialog is page-setup
  call dialog-catalog-check {}
  call pointer-click {"dialog-tab":"Layout"}
  call pointer-click {"dialog-field":"header"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"1234"}
  call real-key {"key":"backspace"}
  call field-read {"dialog-field":"header"}
  assert reply.value is 123
  call real-key {"key":"home"}
  call field-read {"dialog-field":"header"}
  assert reply.caret is 0
  call real-key {"key":"right"}
  call real-key {"key":"delete"}
  call field-read {"dialog-field":"header"}
  assert reply.value is 13
  call real-key {"key":"end"}
  call real-key {"key":"left"}
  call field-read {"dialog-field":"header"}
  assert reply.caret is 1
  call real-type {"text":"9"}
  call field-read {"dialog-field":"header"}
  assert reply.value is 193
  assert reply.caret is 2
  call real-key {"key":"escape"}

