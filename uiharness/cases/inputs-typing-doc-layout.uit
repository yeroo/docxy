test doc columns/space8: edits
  open ../fixtures/basic.docx
  call menu-open {"target":{"ribbon":["Layout","Page Setup","Columns"]}}
  call menu-click {"label":"More Columns..."}
  assert dialog is columns
  call dialog-catalog-check {}
