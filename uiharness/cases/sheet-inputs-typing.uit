test sheet name-box: Enter goes to the reference
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call pointer-click {"input":"name-box"}
  call real-type {"text":"C3"}
  call real-key {"key":"enter"}
  assert sel is C3
  assert editing is false
  assert cell E1 is empty
  call field-read {"input":"name-box"}
  assert reply.focused is false
  assert reply.value is C3

test sheet name-box: Escape cancels
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call pointer-click {"input":"name-box"}
  call real-type {"text":"C3"}
  call field-read {"input":"name-box"}
  assert reply.focused is true
  assert reply.value is C3
  call real-key {"key":"escape"}
  assert sel is E1
  assert editing is false
  assert cell E1 is empty
  call field-read {"input":"name-box"}
  assert reply.focused is false
  assert reply.value is E1

# ---- The Find bar (Ctrl+F): Find what and Replace with. Tab moves between
# them; Enter finds the next match from either, Escape closes the bar;
# its Replace and All buttons have no key, so a real click presses them.

test sheet sheet-find: focus by click
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call real-key {"key":"ctrl+f"}
  assert find_open is true
  call pointer-click {"input":"sheet-find"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"sheet-replace"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"sheet-replace"}
  call pointer-click {"input":"sheet-find"}
  call field-read {"input":"sheet-find"}
  assert reply.focused is true
  call field-read {"input":"sheet-replace"}
  assert reply.focused is false
  call real-key {"key":"escape"}

test sheet sheet-find: types
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call real-key {"key":"ctrl+f"}
  assert find_open is true
  call pointer-click {"input":"sheet-find"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"sheet-replace"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"sheet-find"}
  call real-type {"text":"Ab1 "}
  call field-read {"input":"sheet-find"}
  assert reply.focused is true
  assert reply.value is exactly "Ab1 "
  assert reply.caret is 4
  call real-key {"key":"escape"}

