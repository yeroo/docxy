  call pointer-click {"input":"sheet-find"}
  call real-key {"key":"tab"}
  call field-read {"input":"sheet-replace"}
  assert reply.focused is true
  call real-key {"key":"escape"}

test sheet sheet-replace: Enter finds the next match
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call real-key {"key":"ctrl+f"}
  assert find_open is true
  call pointer-click {"input":"sheet-find"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"sheet-replace"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"sheet-find"}
  call real-type {"text":"West"}
  call pointer-click {"input":"sheet-replace"}
  call real-type {"text":"Ab1"}
  call real-key {"key":"enter"}
  assert sel is A5
  assert cell A5 is West
  call real-key {"key":"escape"}

test sheet sheet-replace: Replace rewrites the found cell
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call real-key {"key":"ctrl+f"}
  assert find_open is true
  call pointer-click {"input":"sheet-find"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"sheet-replace"}
  call real-key {"key":"backspace","times":60}
  assert dirty is false
  call pointer-click {"input":"sheet-find"}
  call real-type {"text":"North"}
  call pointer-click {"input":"sheet-replace"}
  call real-type {"text":"Nord"}
  call pointer-click {"at":"sheet-replace-button"}
  assert sel is A2
  call pointer-click {"at":"sheet-replace-button"}
  assert cell A2 is Nord
  assert dirty is true
  call real-key {"key":"escape"}

test sheet sheet-replace: All rewrites every match
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call real-key {"key":"ctrl+f"}
  assert find_open is true
  call pointer-click {"input":"sheet-find"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"sheet-replace"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"sheet-find"}
  call real-type {"text":"th"}
  call pointer-click {"input":"sheet-replace"}
  call real-type {"text":"XY"}
  call pointer-click {"at":"sheet-replace-all-button"}
  assert cell A2 is exactly NorXY
  assert cell A3 is exactly SouXY
  assert dirty is true
  call real-key {"key":"escape"}

test sheet sheet-replace: Escape closes the bar
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call real-key {"key":"ctrl+f"}
  assert find_open is true
  call pointer-click {"input":"sheet-find"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"sheet-replace"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"sheet-replace"}
  call real-type {"text":"Ab1"}
  call field-read {"input":"sheet-replace"}
  assert reply.focused is true
  assert reply.value is exactly Ab1
  call real-key {"key":"escape"}
  assert find_open is false
  assert dirty is false
  call field-read {"input":"sheet-replace"}
  assert reply.focused is false

# ---- Home › Font and Font Size: a click selects the box's text, Enter
# formats the selection with what was typed, Escape gives the value back.
# Nothing typed into them reaches the cell.

test sheet sheet-font: focus by click
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call pointer-click {"input":"sheet-font"}
  call field-read {"input":"sheet-font"}
  assert reply.focused is true
  assert reply.value is Calibri
  assert reply.selection is [0,7]
  call real-key {"key":"escape"}

test sheet sheet-font: types
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call pointer-click {"input":"sheet-font"}
  call real-type {"text":"Ab1 "}
  call field-read {"input":"sheet-font"}
  assert reply.focused is true
  assert reply.value is exactly "Ab1 "
  assert reply.caret is 4
  call real-key {"key":"escape"}

test sheet sheet-font: edits
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call pointer-click {"input":"sheet-font"}
  call real-type {"text":"abcd"}
  call real-key {"key":"backspace"}
  call field-read {"input":"sheet-font"}
  assert reply.value is abc
  call real-key {"key":"home"}
  call field-read {"input":"sheet-font"}
  assert reply.caret is 0
  call real-key {"key":"right"}
  call real-key {"key":"delete"}
  call field-read {"input":"sheet-font"}
  assert reply.value is ac
  call real-key {"key":"end"}
  call real-key {"key":"left"}
  call field-read {"input":"sheet-font"}
  assert reply.caret is 1
  call real-type {"text":"X"}
  call field-read {"input":"sheet-font"}
  assert reply.value is aXc
  assert reply.caret is 2
  call real-key {"key":"escape"}

test sheet sheet-font: select-all replaces
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call pointer-click {"input":"sheet-font"}
  call real-type {"text":"abcd"}
  call real-key {"key":"ctrl+a"}
  call field-read {"input":"sheet-font"}
  assert reply.focused is true
  assert reply.selection is [0,4]
  call real-type {"text":"X"}
  call field-read {"input":"sheet-font"}
  assert reply.value is X
  call real-key {"key":"escape"}

test sheet sheet-font: copies
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call clipboard {"action":"write","text":"before"}
  call pointer-click {"input":"sheet-font"}
  call field-read {"input":"sheet-font"}
  assert reply.focused is true
  call real-type {"text":"abcd"}
  call real-key {"key":"ctrl+a"}
  call real-key {"key":"ctrl+c"}
  call clipboard {"action":"read"}
  assert reply.text is abcd
  call real-key {"key":"escape"}

test sheet sheet-font: pastes
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call clipboard {"action":"write","text":"Pasted"}
  call pointer-click {"input":"sheet-font"}
  call real-key {"key":"ctrl+v"}
  call field-read {"input":"sheet-font"}
  assert reply.focused is true
  assert reply.value is Pasted
  assert reply.caret is 6
  call real-key {"key":"escape"}

test sheet sheet-font: Enter formats the selection
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call pointer-click {"input":"sheet-font"}
  call real-type {"text":"Arial"}
  call real-key {"key":"enter"}
  assert dirty is true
  assert cell E1 is empty
  click A1
  click E1
  call field-read {"input":"sheet-font"}
  assert reply.value is Arial

test sheet sheet-font: Escape cancels
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call pointer-click {"input":"sheet-font"}
  call real-type {"text":"Arial"}
  call field-read {"input":"sheet-font"}
  assert reply.focused is true
  assert reply.value is Arial
  call real-key {"key":"escape"}
  assert dirty is false
  assert cell E1 is empty
  call field-read {"input":"sheet-font"}
  assert reply.focused is false
  assert reply.value is Calibri

test sheet sheet-font-size: focus by click
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call pointer-click {"input":"sheet-font-size"}
  call field-read {"input":"sheet-font-size"}
