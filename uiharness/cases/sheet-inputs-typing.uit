# ---- The Name Box: a click selects the reference it shows, Enter goes
# to what was typed and Escape gives the reference back. Nothing typed
# into it reaches the cell.

test sheet name-box: focus by click
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call pointer-click {"input":"name-box"}
  call field-read {"input":"name-box"}
  assert reply.focused is true
  assert reply.value is E1
  assert reply.selection is [0,2]
  call real-key {"key":"escape"}

