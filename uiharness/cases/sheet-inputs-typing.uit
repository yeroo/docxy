# The sheet's inputs outside the dialogs, typed into with real keys only
# (#1200, the sheet slice of #1029): the formula bar, the in-cell editor,
# the Name Box, the Find bar's Find and Replace fields and the Home ribbon's
# Font and Font Size boxes. Written by hand, not generated: the dialog
# catalogue's `inputs-typing-*.uit` own that prefix.
#
# `real-key` and `real-type` go through the window's own input path, and an
# input is focused by `pointer-click {"input":id}` (a double-click on the
# active cell for the in-cell editor) or by Tab. `open` and `click <cell>`
# are setup only. A test is one input and one step, named
# `sheet <input>: <step>`; each opens its own copy and first presses Escape,
# which closes a Find bar an earlier test left open (the bar is the
# window's, not the tab's). Expected values follow Excel. The steps that
# fail today are in expected-failures.txt. See qa/inputs-typing.md.

# ---- The formula bar: a click opens an Edit-mode entry on the active cell.

test sheet formula-bar: focus by click
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  click A1
  assert editing is false
  call pointer-click {"input":"formula-bar"}
  call field-read {"input":"formula-bar"}
  assert reply.focused is true
  assert reply.value is Region
  assert editing is true
  assert edit is Region
  call real-key {"key":"escape"}

test sheet formula-bar: types
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call pointer-click {"input":"formula-bar"}
  assert app_state is Edit
  call real-type {"text":"Ab1 "}
  call field-read {"input":"formula-bar"}
  assert reply.focused is true
  assert reply.value is exactly "Ab1 "
  assert reply.caret is 4
  call real-key {"key":"escape"}

test sheet formula-bar: edits
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call pointer-click {"input":"formula-bar"}
  assert app_state is Edit
  call real-type {"text":"abcd"}
  call real-key {"key":"backspace"}
  call field-read {"input":"formula-bar"}
  assert reply.value is abc
  call real-key {"key":"home"}
  call field-read {"input":"formula-bar"}
  assert reply.caret is 0
  call real-key {"key":"right"}
  call real-key {"key":"delete"}
  call field-read {"input":"formula-bar"}
  assert reply.value is ac
  call real-key {"key":"end"}
  call real-key {"key":"left"}
  call field-read {"input":"formula-bar"}
  assert reply.caret is 1
  call real-type {"text":"X"}
  call field-read {"input":"formula-bar"}
  assert reply.value is aXc
  assert reply.caret is 2
  call real-key {"key":"escape"}

test sheet formula-bar: select-all replaces
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call pointer-click {"input":"formula-bar"}
  assert app_state is Edit
  call real-type {"text":"abcd"}
  call real-key {"key":"ctrl+a"}
  call field-read {"input":"formula-bar"}
  assert reply.focused is true
  assert reply.selection is [0,4]
  call real-type {"text":"X"}
  call field-read {"input":"formula-bar"}
  assert reply.value is X
  call real-key {"key":"escape"}

test sheet formula-bar: copies
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call clipboard {"action":"write","text":"before"}
  call pointer-click {"input":"formula-bar"}
  assert app_state is Edit
  call real-type {"text":"abcd"}
  call real-key {"key":"ctrl+a"}
  call real-key {"key":"ctrl+c"}
  call clipboard {"action":"read"}
  assert reply.text is abcd
  call real-key {"key":"escape"}

test sheet formula-bar: pastes
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call clipboard {"action":"write","text":"Pasted"}
  call pointer-click {"input":"formula-bar"}
  assert app_state is Edit
  call real-key {"key":"ctrl+v"}
  call field-read {"input":"formula-bar"}
  assert reply.focused is true
  assert reply.value is Pasted
  assert reply.caret is 6
  call real-key {"key":"escape"}

test sheet formula-bar: Enter commits
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  assert dirty is false
  call pointer-click {"input":"formula-bar"}
  assert app_state is Edit
  call real-type {"text":"Ab1"}
  call real-key {"key":"enter"}
  assert editing is false
  assert cell E1 is exactly Ab1
  assert sel is E2
  assert dirty is true

test sheet formula-bar: Escape cancels
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call pointer-click {"input":"formula-bar"}
  assert app_state is Edit
  call real-type {"text":"Ab1"}
  call real-key {"key":"escape"}
  assert editing is false
  assert cell E1 is empty
  assert sel is E1
  assert dirty is false

# ---- The in-cell editor: a double-click on the cell opens it.

test sheet cell-editor: focus by click
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  click A1
  assert editing is false
  call pointer-click {"input":"cell-editor"}
  assert reply.clicks is 2
  call field-read {"input":"cell-editor"}
  assert reply.focused is true
  assert reply.value is Region
  assert editing is true
  assert sel is A1
  call real-key {"key":"escape"}

