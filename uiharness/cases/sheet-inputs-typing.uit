test sheet sheet-find: focus by Tab
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call real-key {"key":"ctrl+f"}
  assert find_open is true
  call pointer-click {"input":"sheet-find"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"sheet-replace"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"sheet-replace"}
  call real-key {"key":"tab"}
  call field-read {"input":"sheet-find"}
  assert reply.focused is true
  call real-key {"key":"escape"}

test sheet sheet-find: Enter finds the next match
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call real-key {"key":"ctrl+f"}
  assert find_open is true
  call pointer-click {"input":"sheet-find"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"sheet-replace"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"sheet-find"}
  call real-type {"text":"West"}
  call real-key {"key":"enter"}
  assert sel is A5
  assert find_open is true
  call real-key {"key":"escape"}

test sheet sheet-find: Escape closes the bar
  open copy:../fixtures/basic.xlsx
  click E1
  call real-key {"key":"escape"}
  call real-key {"key":"ctrl+f"}
  assert find_open is true
  call pointer-click {"input":"sheet-find"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"sheet-replace"}
  call real-key {"key":"backspace","times":60}
  call pointer-click {"input":"sheet-find"}
  call real-type {"text":"West"}
  call field-read {"input":"sheet-find"}
  assert reply.focused is true
  assert reply.value is exactly West
  call real-key {"key":"escape"}
  assert find_open is false
  assert sel is E1
  call field-read {"input":"sheet-find"}
  assert reply.focused is false

