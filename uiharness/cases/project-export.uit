test project export uses a sandbox copy
  open copy:../fixtures/gantt-summary.xml
  assert title is gantt-summary.xml
  assert dirty is false
  key ctrl+e
  assert exported is gantt-summary.md
  assert title is gantt-summary.xml
  assert dirty is false
  key alt f
  shot window

test dirty project export uses a fresh sandbox copy
  open copy:../fixtures/gantt-summary.xml
  assert exported is none
  key alt p b
  assert dirty is true
  key ctrl+e
  assert exported is gantt-summary.md
  assert dirty is true
  key ctrl+z
  assert status is Undo
  assert dirty is true
  key alt f
  shot window
