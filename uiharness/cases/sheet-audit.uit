# Formula auditing (#675): the green indicator and smart tag on a flagged
# cell, Convert to Number and Ignore Error (one undo step each), and
# Formulas > Error Checking walking the flagged cells. Run with:
#
#   cargo run -p uiharness -- run uiharness/cases/sheet-audit.uit
#
# The fixture's data is A1:C5; columns J and K are clear. `cell` reports the
# rules that flag a cell (`flags`, named as `<ignoredError>` names them): the
# cells the grid draws the green corner on.

test an error and a number stored as text are flagged
  open copy:../fixtures/basic.xlsx
  click J1
  type =1/0
  key enter
  click K1
  type '123
  key enter
  call cell {"cell":"J1"}
  assert reply.flagged is true
  assert reply.flags.0 is evalError
  call cell {"cell":"K1"}
  assert reply.flagged is true
  assert reply.flags.0 is numberStoredAsText
  call cell {"cell":"A1"}
  assert reply.flagged is false

test the smart tag on an error names it and offers its commands
  open copy:../fixtures/basic.xlsx
  click J1
  type =1/0
  key enter
  click J1
  call menu-open {"target":{"grid":"error-check"}}
  call menu-read {}
  assert reply.target.grid is error-check
  assert reply.items.0.heading is Divide by Zero Error
  assert reply.items.1.id is error-help
  assert reply.items.2.id is show-steps
  assert reply.items.4.id is ignore-error
  assert reply.items.5.id is edit-in-formula-bar
  call menu-close {}

test the smart tag on a number stored as text converts it, and undo brings the text back
  open copy:../fixtures/basic.xlsx
  click K1
  type '123
  key enter
  click K1
  call menu-open {"target":{"grid":"error-check"}}
  call menu-read {}
  assert reply.items.0.heading is Number Stored as Text
  assert reply.items.1.id is convert-to-number
  call menu-click {"label":"Convert to Number"}
  assert cell K1 is 123
  call cell {"cell":"K1"}
  assert reply.flagged is false
  key ctrl+z
  call cell {"cell":"K1"}
  assert reply.flagged is true
  assert reply.flags.0 is numberStoredAsText

test Ignore Error stops the flag on that cell only, and undo restores it
  open copy:../fixtures/basic.xlsx
  click J1
  type =1/0
  key enter
  click J2
  type =1/0
  key enter
  click J1
  call menu-open {"target":{"grid":"error-check"}}
  call menu-click {"label":"Ignore Error"}
  call cell {"cell":"J1"}
  assert reply.flagged is false
  call cell {"cell":"J2"}
  assert reply.flagged is true
  call-error menu-open {"target":{"grid":"error-check"}} => no error indicator is showing on the selected cell
  key ctrl+z
  call cell {"cell":"J1"}
  assert reply.flagged is true

test the smart tag opens only on a flagged cell
  open copy:../fixtures/basic.xlsx
  click A1
  call-error menu-open {"target":{"grid":"error-check"}} => no error indicator is showing on the selected cell

test Error Checking shows each flagged cell after the active one, row by row
  open copy:../fixtures/basic.xlsx
  click J1
  type =1/0
  key enter
  click K1
  type '123
  key enter
  click L2
  type =NA()
  key enter
  click A1
  call ribbon-click {"tab":"Formulas","command":"Error Checking"}
  assert dialog is error-checking
  assert sel is J1
  call dialog-read {}
  assert reply.title is Error Checking
  assert reply.buttons.4.label is Previous
  assert reply.buttons.4.enabled is false
  call dialog-click {"button":"Next"}
  assert sel is K1
  call dialog-click {"button":"Next"}
  assert sel is L2
  call dialog-click {"button":"Previous"}
  assert sel is K1
  call dialog-click {"button":"Close"}
  assert dialog is none

test Error Checking skips an ignored error and ends with its message
  open copy:../fixtures/basic.xlsx
  click J1
  type =1/0
  key enter
  click K1
  type '123
  key enter
  click J1
  call menu-open {"target":{"grid":"error-check"}}
  call menu-click {"label":"Ignore Error"}
  click A1
  call ribbon-click {"tab":"Formulas","command":"Error Checking"}
  assert dialog is error-checking
  assert sel is K1
  call dialog-click {"button":"Ignore Error"}
  assert dialog is error-check-done
  call dialog-read {}
  assert reply.text is The error check is complete for the entire sheet.
  call dialog-click {"button":"OK"}
  assert dialog is none

test Error Checking on a clean sheet says the check is complete
  open copy:../fixtures/basic.xlsx
  call ribbon-click {"tab":"Formulas","command":"Error Checking"}
  assert dialog is error-check-done
  call dialog-click {"button":"OK"}
  assert dialog is none

# The columns hold J1 = 3, J2 = J1*2, J3 = SUM(J1:J2)+1, so J3 reads the range
# J1:J2 (and through J2, J1), and J1 is read by J2 and J3.

test Trace Precedents draws one level per press, a range as a box, and Remove Arrows clears them
  open copy:../fixtures/basic.xlsx
  click J1
  type 3
  key enter
  type =J1*2
  key enter
  type =SUM(J1:J2)+1
  key enter
  click J3
  call ribbon-click {"tab":"Formulas","command":"Trace Precedents"}
  call trace-read {}
  assert reply.count is 1
  assert reply.arrows.0.from is J1:J2
  assert reply.arrows.0.to is J3
  assert reply.arrows.0.kind is trace
  assert reply.arrows.0.off_sheet is false
  call ribbon-click {"tab":"Formulas","command":"Trace Precedents"}
  call trace-read {}
  assert reply.count is 2
  assert reply.arrows.1.from is J1
  assert reply.arrows.1.to is J2
  call ribbon-click {"tab":"Formulas","command":"Remove Arrows"}
  call trace-read {}
  assert reply.count is 0

test Trace Dependents draws from the cell to the formulas that read it, one level per press
  open copy:../fixtures/basic.xlsx
  click J1
  type 3
  key enter
  type =J1*2
  key enter
  type =J2+1
  key enter
  click J1
  call ribbon-click {"tab":"Formulas","command":"Trace Dependents"}
  call trace-read {}
  assert reply.count is 1
  assert reply.arrows.0.from is J1
  assert reply.arrows.0.to is J2
  call ribbon-click {"tab":"Formulas","command":"Trace Dependents"}
  call trace-read {}
  assert reply.count is 2
  assert reply.arrows.1.from is J2
  assert reply.arrows.1.to is J3

test Trace Error draws red from the cell the error starts in
  open copy:../fixtures/basic.xlsx
  click J1
  type =1/0
  key enter
  type =J1+1
  key enter
  click J2
  call ribbon-click {"tab":"Formulas","command":"Trace Error"}
  call trace-read {}
  assert reply.count is 1
  assert reply.arrows.0.from is J1
  assert reply.arrows.0.to is J2
  assert reply.arrows.0.kind is error

test a trace with nothing to draw says why, and an edit takes the arrows away
  open copy:../fixtures/basic.xlsx
  click J1
  type 3
  key enter
  type =J1*2
  key enter
  click J1
  call ribbon-click {"tab":"Formulas","command":"Trace Precedents"}
  call status-read {}
  assert reply.items.1.text is The Trace Precedents command requires that the active cell contain a formula which refers to other cells.
  click J2
  call ribbon-click {"tab":"Formulas","command":"Trace Precedents"}
  call trace-read {}
  assert reply.count is 1
  click K1
  type 9
  key enter
  call trace-read {}
  assert reply.count is 0

test Ctrl+[ selects the direct precedents, Ctrl+Shift+{ every level, Ctrl+] the direct dependents
  open copy:../fixtures/basic.xlsx
  click J1
  type 3
  key enter
  type =J1*2
  key enter
  type =SUM(J1:J2)+1
  key enter
  click J3
  key ctrl+[
  assert range is J1:J2
  click J3
  key ctrl+shift+[
  assert range is J1:J2
  click J1
  key ctrl+]
  assert range is J2:J3
  click J1
  key ctrl+shift+]
  assert range is J2:J3
  click J3
  key ctrl+]
  call status-read {}
  assert reply.items.1.text is No cells were found.


# Evaluate Formula takes a formula apart in Excel's order. The dialog's
# `evaluation` label holds the formula with a combining low line after each
# character of the part to calculate next; `next` holds that part alone.

test Evaluate Formula underlines the next part and steps to the value
  open copy:../fixtures/basic.xlsx
  click J1
  type 3
  key enter
  type 4
  key enter
  type =SUM(J1:J2)*2
  key enter
  click J3
  call ribbon-click {"tab":"Formulas","command":"Evaluate Formula"}
  assert dialog is evaluate-formula
  call dialog-read {}
  assert reply.controls.0.text is Sheet1!$J$3
  assert reply.controls.2.text is J1:J2
  call dialog-click {"button":"Evaluate"}
  call dialog-read {}
  assert reply.controls.2.text is SUM({3;4})
  call dialog-click {"button":"Evaluate"}
  call dialog-read {}
  assert reply.controls.2.text is 7*2
  call dialog-click {"button":"Evaluate"}
  call dialog-read {}
  assert reply.controls.1.text is 14
  call dialog-click {"button":"Restart"}
  call dialog-read {}
  assert reply.controls.2.text is J1:J2
  call dialog-click {"button":"Close"}
  assert dialog is none

test Step In shows the referenced formula and Step Out puts its value back
  open copy:../fixtures/basic.xlsx
  click J1
  type 2
  key enter
  type =J1*10
  key enter
  type =J2+1
  key enter
  click J3
  call ribbon-click {"tab":"Formulas","command":"Evaluate Formula"}
  call dialog-click {"button":"Step In"}
  call dialog-read {}
  assert reply.controls.0.text is Sheet1!$J$2
  call dialog-click {"button":"Step Out"}
  call dialog-read {}
  assert reply.controls.0.text is Sheet1!$J$3
  call dialog-click {"button":"Close"}

test Show Calculation Steps on an error opens Evaluate Formula over Error Checking
  open copy:../fixtures/basic.xlsx
  click J1
  type =1/0
  key enter
  click J1
  call menu-open {"target":{"grid":"error-check"}}
  call menu-click {"label":"Show Calculation Steps…"}
  assert dialog is evaluate-formula
  call dialog-click {"button":"Evaluate"}
  call dialog-read {}
  assert reply.controls.1.text is "#DIV/0!"
  call dialog-click {"button":"Close"}
  assert dialog is none
