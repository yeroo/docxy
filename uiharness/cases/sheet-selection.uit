# The regressions that reached an installer because nothing but a person
# looking at a window could have caught them. Run with:
#
#   cargo run -p uiharness -- run uiharness/cases/sheet-selection.uit
#
# The fixture is the harness's own; nothing here reads a user document.

# ---------------------------------------------------------------------------
# 1. A drag over cells selects them. It does not fill them, and it does not
#    arm a fill — the auto-fill-on-sweep regression.
# ---------------------------------------------------------------------------
test drag-to-select does not fill
  open ../fixtures/basic.xlsx
  click A1
  snapshot A1:C5
  drag A1 -> C5
  assert range is A1:C5
  assert no fill preview
  assert dragging is false
  assert cells unchanged
  shot cell:A1:C5

# ---------------------------------------------------------------------------
# 2. The same sweep's border is SOLID. Dashes mean point mode — the grid is
#    picking cells into a formula — and an ordinary selection wearing them was
#    the second regression.
# ---------------------------------------------------------------------------
test a swept selection is solid, not dashed
  open ../fixtures/basic.xlsx
  click A1
  drag A1 -> C5
  assert picking is false
  assert border A1:C5 solid teal

# ---------------------------------------------------------------------------
# 3. A range that really is being pointed at DOES dash. The pair is the point:
#    a harness that only checked case 2 would pass with the dashes removed
#    altogether.
#
#    "Pointing" is a REFERENCE FIELD holding the keyboard — the chart panel's
#    or an entry bar's — not a formula being typed into a cell. See the note
#    under this case in the plan: a half-typed `=SUM(` picks its cells too, but
#    the grid marks those with the blue reference wash, not with dashes.
# ---------------------------------------------------------------------------
test a pointed range dashes
  open ../fixtures/basic.xlsx
  select chart 0
  focus chart-range
  assert picking is true
  drag A1 -> B4
  assert range_preview is A1:B4
  assert border A1:B4 dashed teal
  key escape

# ---------------------------------------------------------------------------
# 4. Typing a formula and dragging out its argument is the OTHER kind of
#    pointing, and it looks different on purpose: the reference wears the
#    formula's own colour, solid, and the cells under it are washed with it.
#    Recorded as a case because the first draft of case 3 asserted dashes here
#    and was wrong about the app rather than the app being wrong.
# ---------------------------------------------------------------------------
test a formula reference is washed, not dashed
  open ../fixtures/basic.xlsx
  click E2
  type =SUM(
  assert editing is true
  drag A1 -> B4
  assert picking is false
  assert border A1:B4 solid #2f6fdb
  key escape

# ---------------------------------------------------------------------------
# 5. One selection at a time. Selecting a chart while a cell is being edited
#    must end the edit — the invisible caret that stayed behind the card and
#    swallowed every keystroke — and the keyboard must then reach the chart,
#    which Escape proves by deselecting it.
# ---------------------------------------------------------------------------
test one selection at a time
  open ../fixtures/basic.xlsx
  click E2
  type 99
  assert editing is true
  select chart 0
  assert editing is false
  assert chart_sel is 0
  key escape
  assert chart_sel is nothing

# ---------------------------------------------------------------------------
# #670: multi-area selections and dragging cells by the selection's border.
# ---------------------------------------------------------------------------
test ctrl+click adds areas and shift extends only the active one
  open ../fixtures/basic.xlsx
  click A1
  click C3 ctrl
  assert areas.0 is A1
  assert areas.1 is C3
  click D5 shift
  assert areas.1 is C3:D5
  drag F1 -> F2 ctrl
  assert areas.2 is F1:F2
  click B2
  assert areas is ["B2"]

test delete clears every area and a multi-area cut is refused
  open ../fixtures/basic.xlsx
  click B2
  click B4 ctrl
  key delete
  assert cell B2 is nothing
  assert cell B4 is nothing
  assert cell B3 is 20
  key ctrl+x
  assert status is This action won't work on multiple selections.

test a multi-area copy needs shared rows or columns
  open ../fixtures/basic.xlsx
  click A2
  click A3 shift
  click C2 ctrl
  click C3 shift
  key ctrl+c
  click J2
  key ctrl+v
  assert cell J2 is North
  assert cell K2 is 14
  click A2
  click C4 ctrl
  key ctrl+c
  assert status is This action won't work on multiple selections.

test dragging the selection by its border moves it and ctrl copies
  open ../fixtures/basic.xlsx
  call border-drag {"from":"B2:B3","to":"J2"}
  assert cell J2 is 10
  assert cell B2 is nothing
  key ctrl+z
  assert cell B2 is 10
  call border-drag {"from":"B2","to":"J3","ctrl":true}
  assert cell J3 is 10
  assert cell B2 is 10
  call border-drag {"from":"B2","to":"A2"}
  assert dialog is drop-replace
  call dialog-click {"button":"Cancel"}
  assert cell A2 is North
  call border-drag {"from":"C2","to":"K5","right":true,"choice":"Copy Here as Values Only"}
  assert cell K5 is 14
