# See qa/inputs-typing.md.

test doc insert-table: matches the catalogue
  open ../fixtures/basic.docx
  call ribbon-click {"tab":"Insert","command":"table"}
  call menu-click {"label":"Insert Table..."}
  assert dialog is insert-table
  call dialog-catalog-check {}
  call real-key {"key":"escape"}

test doc insert-table/cols: focus by click
  open ../fixtures/basic.docx
  call ribbon-click {"tab":"Insert","command":"table"}
  call menu-click {"label":"Insert Table..."}
  assert dialog is insert-table
  call dialog-catalog-check {}
  call pointer-click {"dialog-field":"cols"}
  call field-read {"dialog-field":"cols"}
  assert reply.focused is true
  call real-key {"key":"escape"}

test doc insert-table/cols: focus by Tab
  open ../fixtures/basic.docx
  call ribbon-click {"tab":"Insert","command":"table"}
  call menu-click {"label":"Insert Table..."}
  assert dialog is insert-table
