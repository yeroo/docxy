test doc convert-text-to-table/other: edits
  open ../fixtures/basic.docx
  type one	two
  key home shift+end
  call ribbon-click {"tab":"Insert","command":"table"}
  call menu-click {"label":"Convert Text to Table..."}
  assert dialog is convert-text-to-table
  call dialog-catalog-check {}
  call real-key {"key":"tab","to-field":"sep"}
  call real-key {"key":"down","times":2}
  call pointer-click {"dialog-field":"other"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"abcd"}
  call real-key {"key":"backspace"}
  call field-read {"dialog-field":"other"}
  assert reply.value is abc
  call real-key {"key":"home"}
  call field-read {"dialog-field":"other"}
  assert reply.caret is 0
  call real-key {"key":"right"}
  call real-key {"key":"delete"}
  call field-read {"dialog-field":"other"}
  assert reply.value is ac
  call real-key {"key":"end"}
  call real-key {"key":"left"}
  call field-read {"dialog-field":"other"}
  assert reply.caret is 1
  call real-type {"text":"X"}
  call field-read {"dialog-field":"other"}
  assert reply.value is aXc
  assert reply.caret is 2
  call real-key {"key":"escape"}

test doc convert-text-to-table/other: select-all replaces
  open ../fixtures/basic.docx
