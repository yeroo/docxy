  call real-key {"key":"enter"}
  assert dialog is not convert-text-to-table
  assert table.cells.0.0.0 is one⇥two

test doc convert-text-to-table/other: Escape cancels
  open ../fixtures/basic.docx
  type one	two
  key home shift+end
  call ribbon-click {"tab":"Insert","command":"table"}
  call menu-click {"label":"Convert Text to Table..."}
  assert dialog is convert-text-to-table
  call dialog-catalog-check {}
  call real-key {"key":"tab","to-field":"sep"}
  call real-key {"key":"down","times":2}
  call pointer-click {"dialog-field":"other"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"Esc9"}
  call real-key {"key":"escape"}
  assert dialog is not convert-text-to-table
  type one	two
  key home shift+end
  call ribbon-click {"tab":"Insert","command":"table"}
  call menu-click {"label":"Convert Text to Table..."}
  assert dialog is convert-text-to-table
  call dialog-catalog-check {}
  call real-key {"key":"tab","to-field":"sep"}
  call real-key {"key":"down","times":2}
  call field-read {"dialog-field":"other"}
  assert reply.value is not Esc9
  call real-key {"key":"escape"}
