test backstage info-title: Enter applies
  open copy:../fixtures/basic.docx
  call backstage {"action":"open"}
  call backstage-page {"page":"info"}
  call pointer-click {"input":"info-title"}
  call real-type {"text":"Report"}
  call real-key {"key":"enter"}
  assert dirty is true
  call field-read {"input":"info-title"}
  assert reply.focused is false
  assert reply.value is Report

