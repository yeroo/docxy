# #1533: every Project entry-table heading has an AutoFilter arrow
# (`project-heading-arrow:<Name>`, or `menu-open {"target":{"filter":<Name>}}`).
# It opens Project's popup under the arrow (#1607; a `project-filter-menu`
# dialog drawn as a popup, no title): Sort items, a disabled Group by, No Group
# and Filters, `Clear Filter from <Field>` (enabled only while that column is
# filtered), the value checklist (a Year > Month > Day tree on a date column),
# then OK / Cancel; `menu-read` reports the rows as `items` in that order. A filtered heading draws a funnel,
# the status bar says `AutoFilter Applied`, and `rows` reports the live
# filter and sort. project-filter.xml finishes Plan on 1/12, Build on 3/2,
# Test on 3/17 and Ship on 4/6.

test project the arrow opens the menu and Finish sorts latest first
  open copy:../fixtures/project-filter.xml
  # The default table pane cuts Finish off, so the arrow press is on Name's.
  shot window
  call pointer-click {"region":"project-heading-arrow:Name"}
  assert dialog is project-filter-menu
  shot window
  call dialog-read {}
  assert reply.popup is true
  assert reply.buttons.0.label is Sort A to Z
  assert reply.buttons.1.label is Sort Z to A
  assert reply.buttons.4.label is Clear Filter from Name
  assert reply.buttons.4.enabled is false
  call dialog-click {"button":"Cancel"}
  assert dialog is none
  # Finish is opened as its arrow would open it (menu-open works scrolled out).
  call menu-open {"target":{"filter":"Finish"}}
  shot window
  call menu-read {}
  assert reply.open is true
  assert reply.target is filter
  assert reply.items.0.label is Sort Earliest to Latest
  assert reply.items.0.icon is sort-az
  assert reply.items.1.label is Sort Latest to Earliest
  assert reply.items.2.label is Group by
  assert reply.items.2.enabled is false
  assert reply.items.2.submenu is true
  assert reply.items.2.separator is true
  assert reply.items.3.label is No Group
  assert reply.items.3.enabled is false
  assert reply.items.4.label is Clear Filter from Finish
  assert reply.items.4.enabled is false
  assert reply.items.4.separator is true
  assert reply.items.5.label is Filters
  assert reply.items.5.enabled is false
  assert reply.items.5.submenu is true
  assert reply.controls.0.items.0 is (Select All)
  assert reply.controls.0.items.1 is 2026
  assert reply.controls.0.items.2 is January
  assert reply.buttons.0.label is OK
  assert reply.buttons.1.label is Cancel
  call dialog-click {"button":"Sort Latest to Earliest"}
  assert dialog is none
  call rows {}
  assert reply.sort is Finish
  assert reply.sort_descending is true
  assert reply.rows.0.cells.2 is Ship
  assert reply.rows.3.cells.2 is Plan

test project Escape closes the popup and changes nothing
  open copy:../fixtures/project-filter.xml
  call menu-open {"target":{"filter":"Finish"}}
  shot window
  assert dialog is project-filter-menu
  call real-key {"key":"escape"}
  assert dialog is none
  call rows {}
  assert reply.filter is All Tasks
  assert reply.count is 4

test project filtering Finish to one month leaves its rows and Clear Filter restores them
  open copy:../fixtures/project-filter.xml
  shot window
  call menu-open {"target":{"filter":"Finish"}}
  assert dialog is project-filter-menu
  call dialog-set {"control":"values","value":false}
  call dialog-set {"control":"values","item":"March","checked":true}
  call dialog-click {"button":"OK"}
  assert dialog is none
  assert status is Filtered by Finish
  call rows {}
  assert reply.filter is AutoFilter
  assert reply.count is 2
  assert reply.rows.0.cells.2 is Build
  assert reply.rows.1.cells.2 is Test
  assert reply.filters.0.column is Finish
  # Clear Filter is enabled on the filtered column only.
  call menu-open {"target":{"filter":"Finish"}}
  assert reply.buttons.4.enabled is true
  call dialog-click {"button":"Clear Filter from Finish"}
  assert dialog is none
  call rows {}
  assert reply.filter is All Tasks
  assert reply.count is 4

test project filters on two columns and together
  open copy:../fixtures/project-filter.xml
  shot window
  call menu-open {"target":{"filter":"Finish"}}
  call dialog-set {"control":"values","value":false}
  call dialog-set {"control":"values","item":"March","checked":true}
  call dialog-click {"button":"OK"}
  call menu-open {"target":{"filter":"Name"}}
  call dialog-set {"control":"values","value":["Test"]}
  call dialog-click {"button":"OK"}
  call rows {}
  assert reply.count is 1
  assert reply.rows.0.cells.2 is Test
  assert reply.filters.1.column is Name

test project an arrow press does not select the column or resize it
  open copy:../fixtures/project-filter.xml
  shot window
  call pointer-click {"region":"project-heading-arrow:Duration"}
  assert dialog is project-filter-menu
  call dialog-click {"button":"Cancel"}
  assert dialog is none
  assert selection is none
  call rows {}
  assert reply.widths.Duration is 90
  call-error menu-open {"target":{"filter":"Nope"}} => no Project column 'Nope'
