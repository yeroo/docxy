# #397: menus through the harness. `menu-open` calls the opener a right-click
# or a split button's arrow calls, `menu-click` the item's own click handler.

test a task row's menu is Project's and Insert Task puts a blank row above
  open ../fixtures/gantt-summary.xml
  assert menu is nothing
  call menu-read {}
  assert reply.open is false
  call menu-open {"target":{"row":2}}
  assert reply.open is true
  assert reply.target.row is 2
  assert selected_name is Task 2
  assert menu.target.row is 2
  shot window
  assert reply.items.0.label is Cut
  assert reply.items.1.label is Copy
  assert reply.items.2.label is Paste
  assert reply.items.3.label is Paste Special...
  assert reply.items.3.enabled is false
  assert reply.items.4.separator is true
  assert reply.items.5.label is Scroll to Task
  assert reply.items.7.label is Insert Task
  assert reply.items.8.label is Delete Task
  assert reply.items.8.enabled is true
  assert reply.items.9.label is Inactivate Task
  assert reply.items.9.checked is false
  assert reply.items.11.label is Manually Schedule
  assert reply.items.12.label is Auto Schedule
  assert reply.items.12.checked is true
  assert reply.items.14.label is Assign Resources...
  assert reply.items.16.label is Text Styles...
  assert reply.items.17.separator is true
  assert reply.items.18.label is Information...
  assert reply.items.19.label is Notes...
  assert reply.items.19.enabled is true
  assert reply.items.20.label is Add to Timeline
  assert reply.items.20.enabled is false
  assert reply.items.21.separator is true
  assert reply.items.22.label is Link
  assert reply.items.22.enabled is true
  assert reply.items.23 is nothing
  # The mini formatting toolbar above the items (#1537).
  assert reply.toolbar.0.label is Font
  assert reply.toolbar.0.kind is combo
  assert reply.toolbar.0.value is Calibri
  assert reply.toolbar.1.label is Size
  assert reply.toolbar.1.value is 11
  assert reply.toolbar.2.label is Bold
  assert reply.toolbar.2.kind is button
  assert reply.toolbar.3.label is Italic
  assert reply.toolbar.4.label is Fill Color
  assert reply.toolbar.5.label is Font Color
  assert reply.toolbar.6.label is Link Tasks
  assert reply.toolbar.7.label is Unlink Tasks
  assert reply.toolbar.8.label is Outdent
  assert reply.toolbar.9.label is Indent
  assert reply.toolbar.10.label is Task Details
  assert reply.toolbar.10.kind is arrow
  assert reply.toolbar.11 is nothing
  call menu-read {}
  assert reply.items.7.label is Insert Task
  call-error menu-click {"label":"Text Styles..."} => menu item 'Text Styles...' is disabled
  call-error menu-click {"label":"Font..."} => no menu item 'Font...'
  call-error menu-click {"label":"Fill Down"} => no menu item 'Fill Down'
  call-error menu-click {"label":"Clear Contents"} => no menu item 'Clear Contents'
  call menu-click {"label":"Insert Task"}
  assert reply.menu is nothing
  assert menu is nothing
  assert tasks is 4
  call rows {}
  assert reply.rows.1.kind is blank
  assert cell C3 is Task 2
  call-error menu-click {"label":"Insert Task"} => no menu is open

test the document's Bold menu never opens on a Project, and Esc closes the row menu
  open ../fixtures/gantt-summary.xml
  call-error menu-open {"target":"document"} => does not open on a Project tab
  call-error menu-open {"target":{"cell":"C3"}} => the cell menu opens on a sheet tab
  call-error menu-open {"target":{"row":99}} => no task with uid 99
  call menu-open {"target":{"row":1}}
  call-error menu-click {"label":"Underline"} => no menu item 'Underline'
  key escape
  assert menu is nothing
  assert selected_name is Task 1
  assert prompt is none
  assert tasks is 3
  call-error menu-close {} => no menu is open
  # A task under a collapsed summary has no row to right-click.
  click A1
  key alt+shift+-
  call-error menu-open {"target":{"row":2}} => hidden under a collapsed summary

test Delete Task on a row's menu deletes from any column and asks for a summary
  open ../fixtures/gantt-summary.xml
  click C3
  assert cell is Name
  call menu-open {"target":{"row":3}}
  call menu-click {"label":"Delete Task"}
  assert tasks is 2
  assert dialog is none
  call menu-open {"target":{"row":1}}
  call menu-click {"label":"Delete Task"}
  assert dialog is delete-summary
  call dialog-click {"button":"No"}
  assert tasks is 2

test Set Baseline's split menu sets and clears the baseline
  open ../fixtures/gantt-summary.xml
  call menu-open {"target":{"ribbon":["Project","Schedule","Set Baseline"]}}
  assert ribbon_tab is Project
  assert reply.target.ribbon.2 is Set Baseline
  assert reply.items.0.label is Set Baseline...
  assert reply.items.0.key_tip is B
  assert reply.items.1.label is Clear Baseline...
  assert reply.items.1.key_tip is L
  shot window
  call menu-click {"label":"Set Baseline..."}
  assert status is Baseline set — baseline bars now show under the current bars
  call menu-open {"target":{"ribbon":["Project","Schedule","Set Baseline"]}}
  call menu-click {"label":"Clear Baseline..."}
  assert status is Baseline cleared
  call-error menu-open {"target":{"ribbon":["Project","Schedule","Calculate Project"]}} => 'Calculate Project' has no menu
  # The ribbon still takes both by name and by KeyTip.
  call ribbon-click {"tab":"Project","command":"Set Baseline"}
  assert status is Baseline set — baseline bars now show under the current bars
  call ribbon-click {"tab":"Project","command":"Clear Baseline"}
  assert status is Baseline cleared
  key alt p b l
  assert status is No baseline to clear
  call ribbon-read {}
  assert reply.tabs.4.groups.0.commands.1.label is Set Baseline
  assert reply.tabs.4.groups.0.commands.1.enabled is true
  assert reply.tabs.4.groups.0.commands.3.label is Clear Baseline...
  assert reply.tabs.4.groups.0.commands.3.menu is pr-baseline
  # menu-close closes as Esc does. With the tab drawn, the menu drops
  # below the whole button, where the pointer's press on the arrow drops it.
  call menu-open {"target":{"ribbon":["Project","Schedule","Set Baseline"]}}
  shot window
  call menu-close {}
  assert reply.menu is nothing

test the document menu opens on a document through the right-click's opener
  open copy:../fixtures/basic.docx
  type hello
  call-error menu-open {"target":{"row":1}} => a row menu needs a Project tab
  call menu-open {"target":"document"}
  assert reply.target is document
  assert reply.items.0.label is Cut
  assert reply.items.3.label is Keep Source Formatting
  assert reply.items.4.label is Keep Text Only
  assert reply.items.5.label is Paste Special…
  assert reply.items.7.label is Bold
  assert reply.items.11.label is New Comment
  assert menu.target is document
  key escape
  assert menu is nothing
  assert text is hello

test a press outside a menu, another tab or a command closes it first
  open copy:../fixtures/gantt-summary.xml
  call menu-open {"target":{"row":3}}
  assert selected_name is Task 3
  # The click goes on after closing the menu, as the backdrop lets it.
  click C2
  call menu-read {}
  assert reply.open is false
  assert menu is nothing
  assert selected_name is Task 2
  call-error menu-click {"label":"Delete Task"} => no menu is open
  assert tasks is 3
  call menu-open {"target":{"row":3}}
  call ribbon-click {"tab":"Project","command":"Calculate Project"}
  assert menu is nothing
  # A second tab: the menu belongs to the tab it opened on.
  open copy:../fixtures/basic.docx
  call menu-open {"target":"document"}
  assert menu.target is document
  call title-tab {"action":"prev"}
  assert title is gantt-summary.xml
  assert menu is nothing
  call-error menu-click {"label":"Bold"} => no menu is open
  call-error menu-close {} => no menu is open

test a key under an open menu is swallowed and goes no further
  open copy:../fixtures/basic.docx
  type hello
  call menu-open {"target":"document"}
  # A letter that matches no item's key tip stays in the menu and is
  # swallowed: no x is typed (#591).
  type x
  assert menu.target is document
  assert text is hello
  key escape
  assert menu is nothing
  assert text is hello
  open copy:../fixtures/gantt-summary.xml
  click C2
  assert cell is Name
  call menu-open {"target":{"row":3}}
  assert cell is Name
  # Tab would move the cursor a column; under the menu it only closes it.
  key tab
  assert menu is nothing
  assert cell is Name
  assert selected_name is Task 3

test no menu opens or runs while File or the more-tabs list covers the tab
  open copy:../fixtures/gantt-summary.xml
  call backstage {"action":"open"}
  call-error menu-open {"target":{"row":3}} => File (backstage) is open
  assert selected_name is Task 1
  assert tasks is 3
  call backstage {"action":"close"}
  call menu-open {"target":{"row":3}}
  # Reading the backstage is a read: the menu stays.
  call backstage {"action":"read"}
  assert menu.target.row is 3
  call backstage {"action":"open"}
  assert menu is nothing
  call-error menu-click {"label":"Delete Task"} => File (backstage) is open
  assert tasks is 3

test a control-pipe edit closes an open menu without the harness's press rule
  open copy:../fixtures/gantt-summary.xml
  call menu-open {"target":{"row":3}}
  # A read over the pipe leaves it open.
  call task.list {}
  assert menu.target.row is 3
  # An edit over the pipe drops the menu, as it drops the tab's dialogs.
  call task.set {"uid":2,"duration":"3d"}
  assert menu is nothing
  call-error menu-click {"label":"Delete Task"} => no menu is open
  assert tasks is 3

test the entry row's menu is the row menu for no task
  open copy:../fixtures/gantt-summary.xml
  call menu-open {"target":{"row":null}}
  assert reply.target.row is nothing
  assert menu.target.row is nothing
  assert selected_name is empty
  assert reply.items.7.label is Insert Task
  assert reply.items.7.enabled is true
  assert reply.items.8.label is Delete Task
  assert reply.items.8.enabled is false
  assert reply.items.5.label is Scroll to Task
  assert reply.items.5.enabled is false
  assert reply.toolbar.2.label is Bold
  assert reply.toolbar.2.enabled is false
  assert reply.toolbar.6.enabled is false
  call-error menu-click {"label":"Bold"} => menu item 'Bold' is disabled
  call-error menu-click {"label":"Delete Task"} => menu item 'Delete Task' is disabled
  call menu-click {"label":"Insert Task"}
  assert tasks is 4
  call-error menu-open {"target":{"row":"x"}} => 'row' must be a task uid, or null for the entry row

test the row menu has no Fill Down; Ctrl+D fills the range a right-click inside keeps (#1213, #1537)
  open copy:../fixtures/project-clipboard.xml
  call menu-open {"target":{"row":1}}
  call-error menu-click {"label":"Fill Down"} => no menu item 'Fill Down'
  key escape
  call click-cell {"cell":"C1"}
  key shift+down
  key shift+right
  assert selection is 4
  # A right-click inside the range keeps it, and the cursor with it.
  call menu-open {"target":{"row":1}}
  assert selection is 4
  assert cell_row is 1
  key escape
  key ctrl+d
  call task.list {}
  assert reply.tasks.1.name is A
  assert tasks is 2
  # Ctrl+Z undoes the whole fill.
  key ctrl+z
  call task.list {}
  assert reply.tasks.1.name is B
  # A right-click outside the range is a left click: the range goes.
  call click-cell {"cell":"C1"}
  key shift+right
  assert selection is 2
  call menu-open {"target":{"row":2}}
  assert selection is none
  assert selected_name is B

test the toolbar's Bold styles the kept range in one undo step and its drop-downs open choices (#1537)
  open copy:../fixtures/gantt-summary.xml
  call click-cell {"cell":"C2"}
  key shift+down
  assert selection is 2
  call menu-open {"target":{"row":2}}
  assert selection is 2
  shot window
  call menu-click {"label":"Bold"}
  assert menu is nothing
  assert selection is 2
  call menu-open {"target":{"row":2}}
  assert reply.toolbar.2.checked is true
  key escape
  key ctrl+z
  call menu-open {"target":{"row":2}}
  assert reply.toolbar.2.checked is false
  # A drop-down opens its choices in the menu's place; Esc backs out.
  call menu-click {"label":"Size"}
  call menu-read {}
  assert reply.depth is 1
  call menu-click {"label":"14"}
  assert menu is nothing
  call menu-open {"target":{"row":2}}
  assert reply.toolbar.1.value is 14
  call menu-click {"path":["Font Color","Red"]}
  assert menu is nothing
  call menu-open {"target":{"row":2}}
  call menu-click {"label":"Indent"}
  assert menu is nothing

test a row menu over a kept range is the clicked row's: its task items act on that row (#1213 r1)
  open copy:../fixtures/gantt-summary.xml
  call click-cell {"cell":"C2"}
  key shift+down
  assert selection is 2
  assert selected_name is Task 3
  call menu-open {"target":{"row":2}}
  assert reply.target.row is 2
  assert selection is 2
  assert selected_name is Task 3
  call menu-click {"label":"Delete Task"}
  assert tasks is 2
  assert dialog is none
  call task.list {}
  assert reply.tasks.0.name is Task 1
  assert reply.tasks.1.name is Task 3
  key ctrl+z
  assert tasks is 3
  call click-cell {"cell":"C2"}
  key shift+down
  call menu-open {"target":{"row":2}}
  call menu-click {"label":"Notes..."}
  assert selected_name is Task 2
  assert dialog is task-information
  call dialog-read {}
  assert reply.tab is Notes
  assert selection is none
  key escape
  assert dialog is none
