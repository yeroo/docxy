terminal docxy
# docxy's text prompts typed into with real keys (#1204, the terminal
# editors' slice of #1029). Written by hand, not generated: the dialog
# catalogue's `inputs-typing-*.uit` own that prefix.
#
# The first line runs docxy itself in a pseudo-terminal (uiharness/src/term.rs):
# each `open` starts it afresh on its own copy of the fixture, `real-key` and
# `real-type` write the bytes a terminal sends for each key, and
# `pointer-click {"input":id}` writes a mouse click where the field is drawn.
# Every other `call` is docxy's own control verb, used only to read results;
# `field-read` reads a prompt as it was last drawn. A test is one input and
# one step, named `docxy <input>: <step>`. Expected values follow Word. The
# steps that fail today are in expected-failures.txt. See
# qa/inputs-typing.md.
#
# The vim `:` command line needs `--vim`, so it is typed into by
# terminal-docxy-vim-inputs-typing.uit. The terminal cases do not sandbox
# the OS clipboard: Ctrl+C in the document writes it.

# ---- The Find bar's Find field: Ctrl+F opens it, empty, on the status line.
# Enter is Find Next and changes nothing; no verb reports the selection it
# moves, so Enter commits checks the bar stays open on its text with the
# document untouched, as Word's Find does.
test docxy docxy-find: focus
  open copy:../fixtures/header-inherit.docx
  call real-key {"key":"ctrl+f"}
  call field-read {"input":"docxy-find"}
  assert reply.focused is true
  assert reply.at is not null
  assert reply.value is exactly ""
  assert reply.caret is 0

test docxy docxy-find: focus by click
  open copy:../fixtures/header-inherit.docx
  call real-key {"key":"ctrl+f"}
  call real-key {"key":"tab"}
  call pointer-click {"input":"docxy-find"}
  call field-read {"input":"docxy-find"}
  assert reply.focused is true

test docxy docxy-find: types
  open copy:../fixtures/header-inherit.docx
  call real-key {"key":"ctrl+f"}
  call real-type {"text":"Ab1 "}
  call field-read {"input":"docxy-find"}
  assert reply.focused is true
  assert reply.value is exactly "Ab1 "
  assert reply.caret is 4

test docxy docxy-find: edits
  open copy:../fixtures/header-inherit.docx
  call real-key {"key":"ctrl+f"}
  call real-type {"text":"abcd"}
  call real-key {"key":"backspace"}
  call field-read {"input":"docxy-find"}
  assert reply.value is exactly abc
  call real-key {"key":"home"}
  call field-read {"input":"docxy-find"}
  assert reply.caret is 0
  call real-key {"key":"right"}
  call real-key {"key":"delete"}
  call field-read {"input":"docxy-find"}
  assert reply.value is exactly ac
  call real-key {"key":"end"}
  call real-key {"key":"left"}
  call field-read {"input":"docxy-find"}
  assert reply.caret is 1
  call real-type {"text":"X"}
  call field-read {"input":"docxy-find"}
  assert reply.value is exactly aXc
  assert reply.caret is 2

test docxy docxy-find: select-all replaces
  open copy:../fixtures/header-inherit.docx
  call real-key {"key":"ctrl+f"}
  call real-type {"text":"abcd"}
  call real-key {"key":"ctrl+a"}
  call field-read {"input":"docxy-find"}
  assert reply.focused is true
  assert reply.selection is [0,4]
  call real-type {"text":"X"}
  call field-read {"input":"docxy-find"}
  assert reply.value is exactly X

test docxy docxy-find: copies
  open copy:../fixtures/header-inherit.docx
  call real-key {"key":"ctrl+f"}
  call real-type {"text":"abcd"}
  call real-key {"key":"ctrl+a"}
  call real-key {"key":"ctrl+c"}
  call real-key {"key":"end"}
  call real-key {"key":"backspace","times":10}
  call field-read {"input":"docxy-find"}
  assert reply.value is exactly ""
  call real-key {"key":"ctrl+v"}
  call field-read {"input":"docxy-find"}
  assert reply.value is exactly abcd

test docxy docxy-find: pastes
  open copy:../fixtures/header-inherit.docx
  call real-key {"key":"shift+end"}
  call real-key {"key":"ctrl+c"}
  call real-key {"key":"ctrl+f"}
  call real-key {"key":"ctrl+v"}
  call field-read {"input":"docxy-find"}
  assert reply.focused is true
  assert reply.value is exactly One
  assert reply.caret is 3

test docxy docxy-find: Enter commits
  open copy:../fixtures/header-inherit.docx
  call real-key {"key":"ctrl+f"}
  call real-type {"text":"Two"}
  call real-key {"key":"enter"}
  call field-read {"input":"docxy-find"}
  assert reply.focused is true
  assert reply.value is exactly Two
  call doc.path {}
  assert reply.modified is false

test docxy docxy-find: Escape cancels
  open copy:../fixtures/header-inherit.docx
  call real-key {"key":"ctrl+f"}
  call real-type {"text":"Two"}
  call real-key {"key":"escape"}
  call field-read {"input":"docxy-find"}
  assert reply.value is null
  assert reply.focused is false
  call doc.path {}
  assert reply.modified is false


# ---- The Find bar's Replace field: Ctrl+H opens the bar, the steps find
# "Two" (which the document holds) and Tab to Replace. In Replace mode
# Ctrl+A is Replace All today, so select-all replaces also checks the
# document did not change: Replace All would have edited "Two".
