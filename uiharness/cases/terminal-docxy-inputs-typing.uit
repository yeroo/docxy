test docxy docxy-compare-revised: Enter commits
  open copy:../fixtures/header-inherit.docx
  call real-key {"key":"f9"}
  call real-key {"key":"right","times":4}
  call real-key {"key":"down"}
  call real-key {"key":"right","times":9}
  call real-key {"key":"enter"}
  call real-type {"text":"header-inherit.docx"}
  call real-key {"key":"enter"}
  call doc.path {}
  assert reply.path is exactly Compare Result 1.docx

test docxy docxy-compare-revised: Escape cancels
  open copy:../fixtures/header-inherit.docx
  call real-key {"key":"f9"}
  call real-key {"key":"right","times":4}
  call real-key {"key":"down"}
  call real-key {"key":"right","times":9}
  call real-key {"key":"enter"}
  call real-type {"text":"header-inherit.docx"}
  call real-key {"key":"escape"}
  call field-read {"input":"docxy-compare-revised"}
  assert reply.value is null
  call doc.path {}
  assert reply.path is not Compare Result 1.docx
  assert reply.modified is false


# ---- Backstage Save As's file name (Alt+F, Down x3 to Save As, Enter),
# prefilled with the file's name and the caret at its end. The typing
# steps first empty it with Backspace (40 presses). Enter saves into the
# file's folder; opening the new name there by doc.open proves it was
# written.
test docxy docxy-save-as: focus
  open copy:../fixtures/header-inherit.docx
  call real-key {"key":"alt+f"}
  call real-key {"key":"down","times":3}
  call real-key {"key":"enter"}
  call field-read {"input":"docxy-save-as"}
  assert reply.focused is true
  assert reply.at is not null
  assert reply.value is not null
  assert reply.selection is null

test docxy docxy-save-as: focus by click
  open copy:../fixtures/header-inherit.docx
  call real-key {"key":"alt+f"}
  call real-key {"key":"down","times":3}
  call real-key {"key":"enter"}
  call real-key {"key":"tab"}
  call pointer-click {"input":"docxy-save-as"}
  call field-read {"input":"docxy-save-as"}
  assert reply.focused is true

test docxy docxy-save-as: types
  open copy:../fixtures/header-inherit.docx
  call real-key {"key":"alt+f"}
  call real-key {"key":"down","times":3}
  call real-key {"key":"enter"}
  call real-key {"key":"backspace","times":40}
  call real-type {"text":"Ab1 "}
  call field-read {"input":"docxy-save-as"}
  assert reply.focused is true
  assert reply.value is exactly "Ab1 "
  assert reply.caret is 4

