  call doc.path {}
  assert reply.path is exactly Compare Result 1.docx

test docxy docxy-compare-original: Escape cancels
  open copy:../fixtures/header-inherit.docx
  call real-key {"key":"f9"}
  call real-key {"key":"right","times":4}
  call real-key {"key":"down"}
  call real-key {"key":"right","times":9}
  call real-key {"key":"enter"}
  call real-key {"key":"shift+tab"}
  call real-type {"text":"x"}
  call real-key {"key":"escape"}
