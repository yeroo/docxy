  call real-key {"key":"down"}
  call real-key {"key":"enter"}
  call real-type {"text":"Ab1"}
  call real-key {"key":"escape"}
  call field-read {"input":"docxy-comment"}
  assert reply.value is null
  call doc.comments {}
  assert reply.comments is []
  call doc.path {}
  assert reply.modified is false


# ---- Review > Compare's two paths (F9, Right x4, Down, Right x9, Enter).
# The open document is a saved .docx, so Original opens on its path and
# Revised, empty, has the keyboard; Shift+Tab moves to Original. The
# typing steps first empty Original with Backspace (260 presses, a
# path's most). Enter compares the open file with itself, typed as a
# path relative to its folder (the editor's working directory): a new
# Compare Result document opens.
test docxy docxy-compare-original: focus
  open copy:../fixtures/header-inherit.docx
  call real-key {"key":"f9"}
  call real-key {"key":"right","times":4}
  call real-key {"key":"down"}
  call real-key {"key":"right","times":9}
  call real-key {"key":"enter"}
  call real-key {"key":"shift+tab"}
  call field-read {"input":"docxy-compare-original"}
  assert reply.focused is true
  assert reply.at is not null
  assert reply.value is not null
  assert reply.selection is null

test docxy docxy-compare-original: focus by click
  open copy:../fixtures/header-inherit.docx
  call real-key {"key":"f9"}
  call real-key {"key":"right","times":4}
  call real-key {"key":"down"}
  call real-key {"key":"right","times":9}
  call real-key {"key":"enter"}
  call real-key {"key":"shift+tab"}
  call real-key {"key":"tab"}
  call pointer-click {"input":"docxy-compare-original"}
  call field-read {"input":"docxy-compare-original"}
  assert reply.focused is true

test docxy docxy-compare-original: types
  open copy:../fixtures/header-inherit.docx
  call real-key {"key":"f9"}
  call real-key {"key":"right","times":4}
  call real-key {"key":"down"}
  call real-key {"key":"right","times":9}
  call real-key {"key":"enter"}
  call real-key {"key":"shift+tab"}
  call real-key {"key":"backspace","times":260}
  call real-type {"text":"Ab1 "}
  call field-read {"input":"docxy-compare-original"}
  assert reply.focused is true
  assert reply.value is exactly "Ab1 "
  assert reply.caret is 4

