test docxy docxy-replace: Tab
  open copy:../fixtures/header-inherit.docx
  call real-key {"key":"ctrl+h"}
  call real-type {"text":"Tw"}
  call real-key {"key":"tab"}
  call field-read {"input":"docxy-replace"}
  assert reply.focused is true
  call field-read {"input":"docxy-find"}
  assert reply.focused is false
  call real-key {"key":"tab"}
  call field-read {"input":"docxy-find"}
  assert reply.focused is true
  assert reply.value is exactly Tw


# ---- A new comment's text: select "One" (Shift+Right three times), then
# Review > New by its keys (F9, Right x4, Down, Enter). It is typed on the
# status line.
test docxy docxy-comment: focus
  open copy:../fixtures/header-inherit.docx
  call real-key {"key":"shift+right","times":3}
  call real-key {"key":"f9"}
  call real-key {"key":"right","times":4}
  call real-key {"key":"down"}
  call real-key {"key":"enter"}
  call field-read {"input":"docxy-comment"}
  assert reply.focused is true
  assert reply.at is not null
  assert reply.value is exactly ""
  assert reply.caret is 0

