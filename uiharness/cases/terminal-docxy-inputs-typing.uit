  call real-key {"key":"down"}
  call real-key {"key":"right","times":9}
  call real-key {"key":"enter"}
  call field-read {"input":"docxy-compare-revised"}
  assert reply.focused is true
  call real-key {"key":"shift+tab"}
  call field-read {"input":"docxy-compare-original"}
  assert reply.focused is true
  call field-read {"input":"docxy-compare-revised"}
  assert reply.focused is false
  call real-key {"key":"tab"}
  call field-read {"input":"docxy-compare-revised"}
  assert reply.focused is true


