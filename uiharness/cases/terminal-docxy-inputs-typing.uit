test docxy docxy-compare-revised: pastes
  open copy:../fixtures/header-inherit.docx
  call real-key {"key":"shift+end"}
  call real-key {"key":"ctrl+c"}
  call real-key {"key":"f9"}
  call real-key {"key":"right","times":4}
  call real-key {"key":"down"}
  call real-key {"key":"right","times":9}
  call real-key {"key":"enter"}
  call real-key {"key":"ctrl+v"}
