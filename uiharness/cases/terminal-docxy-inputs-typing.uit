  open copy:../fixtures/header-inherit.docx
  call real-key {"key":"shift+right","times":3}
  call real-key {"key":"f9"}
  call real-key {"key":"right","times":4}
  call real-key {"key":"down"}
  call real-key {"key":"enter"}
  call real-type {"text":"Ab1"}
  call real-key {"key":"enter"}
  call doc.comments {}
  assert reply.comments.0.text is exactly Ab1
  assert reply.comments.0.anchor is exactly One
  call doc.path {}
  assert reply.modified is true

test docxy docxy-comment: Escape cancels
