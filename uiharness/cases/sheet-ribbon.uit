# The sheet ribbon through ribbon-read / ribbon-click (#699). The ribbon is
# drawn from sheet_ribbon::SHEET_RIBBON, the table these verbs read, so what
# they report is what the window shows.

test sheet ribbon read lists the drawn Home tab
  open ../fixtures/basic.xlsx
  call ribbon-read {}
  assert reply.tabs.0.name is File
  assert reply.tabs.1.name is Home
  assert reply.tabs.3.name is Page Layout
  assert reply.tabs.4.name is Formulas
  assert reply.tabs.5.name is Data
  assert reply.tabs.6.name is Review
  assert reply.tabs.7.name is View
  assert reply.tabs.8.name is Help
  assert reply.tab_count is 9
  assert reply.tabs.1.groups.0.title is Clipboard
  assert reply.tabs.1.groups.0.commands.0.id is paste
  assert reply.tabs.1.groups.1.commands.4.id is bold
  assert reply.tabs.1.groups.1.commands.4.checked is false
  assert reply.tabs.1.groups.1.commands.4.enabled is true
  assert reply.tabs.1.groups.1.commands.6.id is underline
  assert reply.tabs.1.groups.1.commands.6.enabled is false

test sheet ribbon click runs the button's own command
  open ../fixtures/basic.xlsx
  click B2
  call ribbon-click {"tab":"Home","command":"Bold"}
  assert dirty is true
  call ribbon-read {}
  assert reply.tabs.1.groups.1.commands.4.checked is true
  call ribbon-click {"tab":"Home","command":"bold"}
  call ribbon-read {}
  assert reply.tabs.1.groups.1.commands.4.checked is false

test sheet ribbon click selects the tab and reads a toggle's current label
  open ../fixtures/basic.xlsx
  click B2
  call ribbon-click {"tab":"View","command":"Freeze Panes"}
  assert ribbon_tab is View
  call ribbon-read {}
  assert reply.tabs.7.groups.0.commands.0.label is Unfreeze Panes
  call ribbon-click {"tab":"View","command":"Unfreeze Panes"}
  call ribbon-read {}
  assert reply.tabs.7.groups.0.commands.0.label is Freeze Panes

test sheet ribbon refuses a placeholder, a missing command and a command with no menu
  open ../fixtures/basic.xlsx
  call-error ribbon-click {"tab":"Review","command":"Spelling"} => 'Spelling' is not implemented
  call-error ribbon-click {"tab":"Home","command":"Spelling"} => command 'Spelling' is not on tab 'Home'
  call-error ribbon-click {"tab":"Table","command":"Bold"} => 'Table' is not a ribbon tab
  call-error menu-open {"target":{"ribbon":["Home","Font","Bold"]}} => sheet command 'Bold' opens no menu

# #707: Paste is a split button; Fill, Clear and Find & Select open menus.
test sheet ribbon menus open through menu-open and the button's own click
  open ../fixtures/basic.xlsx
  call menu-open {"target":{"ribbon":["Home","Clipboard","Paste"]}}
  assert reply.open is true
  assert reply.items.0.label is Paste
  call menu-close {}
  call ribbon-click {"tab":"Home","command":"Fill"}
  call menu-read {}
  assert reply.items.2.label is Up
  call menu-close {}
  call menu-open {"target":{"ribbon":["Home","Editing","Clear"]}}
  assert reply.items.0.label is Clear All
  call menu-close {}
  call menu-open {"target":{"ribbon":["Home","Editing","Find & Select"]}}
  assert reply.items.1.label is Go To Special…

# Excel's Data tab (#696): Sort & Filter, Data Tools and Outline, in Excel's
# order and under Excel's names.
test sheet ribbon data tab lists Excel's groups
  open ../fixtures/basic.xlsx
  call ribbon-read {}
  assert reply.tabs.5.name is Data
  assert reply.tabs.5.groups.0.title is Sort & Filter
  assert reply.tabs.5.groups.1.title is Data Tools
  assert reply.tabs.5.groups.2.title is Outline
  assert reply.tabs.5.groups.3.title is Show Level
  assert reply.tabs.5.groups.0.commands.0.label is Sort A to Z
  assert reply.tabs.5.groups.0.commands.2.label is Sort
  assert reply.tabs.5.groups.0.commands.4.label is Clear
  assert reply.tabs.5.groups.0.commands.4.enabled is true
  assert reply.tabs.5.groups.0.commands.5.label is Reapply
  assert reply.tabs.5.groups.0.commands.5.enabled is true
  assert reply.tabs.5.groups.0.commands.6.label is Advanced
  assert reply.tabs.5.groups.0.commands.6.enabled is true
  assert reply.tabs.5.groups.1.commands.1.label is Flash Fill
  assert reply.tabs.5.groups.1.commands.2.label is Remove Duplicates
  assert reply.tabs.5.groups.1.commands.4.label is Circle Invalid Data
  assert reply.tabs.5.groups.1.commands.6.label is Consolidate
  assert reply.tabs.5.groups.2.commands.0.label is Group
  assert reply.tabs.5.groups.2.commands.4.label is Hide Detail

test sheet ribbon data tab sorts the region by the cursor's column
  open ../fixtures/basic.xlsx
  click A2
  call ribbon-click {"tab":"Data","command":"Sort A to Z"}
  assert ribbon_tab is Data
  assert cell A2 is East
  assert cell B2 is 30
  assert cell A5 is West
  click B2
  call ribbon-click {"tab":"Data","command":"Sort Z to A"}
  assert cell B2 is 40
  assert cell A2 is West

# A copy leaves out the rows a filter hides, so its row count shows the
# filter and Clear taking it off. Filter puts buttons on the list (#690); the
# filter itself is set through a button's drop-down.
test sheet ribbon data tab clears a filter
  open ../fixtures/basic.xlsx
  click B2
  call ribbon-click {"tab":"Data","command":"Filter"}
  shot filter-button:B
  call pointer-click {"region":"filter-button:B"}
  call dialog-set {"control":"typed","value":"Greater Than..."}
  call dialog-click {"button":"Apply Filter"}
  call dialog-set {"control":"val1","value":"20"}
  call dialog-click {"button":"OK"}
  click A1
  click B5 shift
  key ctrl+c
  call clipboard {"action":"read"}
  assert reply.app.rows is 3
  click B4
  call ribbon-click {"tab":"Data","command":"Clear"}
  click A1
  click B5 shift
  key ctrl+c
  call clipboard {"action":"read"}
  assert reply.app.rows is 5

# Clear and Reapply with no filter change no row, so the workbook stays clean.
test sheet ribbon data tab clear with no filter leaves the workbook clean
  open ../fixtures/basic.xlsx
  click B2
  call ribbon-click {"tab":"Data","command":"Clear"}
  assert dirty is false
  assert status is There is no filter on this sheet.
  call ribbon-click {"tab":"Data","command":"Reapply"}
  assert dirty is false

test sheet ribbon home tab refuses its placeholders
  open ../fixtures/basic.xlsx
  call-error ribbon-click {"tab":"Home","command":"Format Painter"} => 'Format Painter' is not implemented

# Circle Invalid Data (#689) is view state: a workbook with no rules has none to
# circle and stays clean.
test sheet ribbon data tab circle invalid data changes nothing in a clean workbook
  open ../fixtures/basic.xlsx
  call ribbon-click {"tab":"Data","command":"Circle Invalid Data"}
  assert status is No invalid data
  assert dirty is false
  call ribbon-click {"tab":"Data","command":"Clear Validation Circles"}
  assert dirty is false

# Home > Editing is Excel's (#1018): the AutoSum / Fill / Clear column, one
# large Sort & Filter drop-down holding the sort and filter commands, and Find
# & Select. Remove Duplicates is only on Data > Data Tools.
test sheet Home Editing group matches Excel
  open ../fixtures/basic.xlsx
  call ribbon-read {}
  assert reply.tabs.1.groups.6.title is Editing
  assert reply.tabs.1.groups.6.commands.0.id is autosum
  assert reply.tabs.1.groups.6.commands.1.id is fill
  assert reply.tabs.1.groups.6.commands.2.id is clear
  assert reply.tabs.1.groups.6.commands.3.label is Sort & Filter
  assert reply.tabs.1.groups.6.commands.3.enabled is true
  assert reply.tabs.1.groups.6.commands.4.id is sort-a-z
  assert reply.tabs.1.groups.6.commands.4.menu is sort-filter
  assert reply.tabs.1.groups.6.commands.9.menu is sort-filter
  assert reply.tabs.1.groups.6.commands.5.id is sort-z-a
  assert reply.tabs.1.groups.6.commands.6.id is custom-sort
  assert reply.tabs.1.groups.6.commands.7.id is filter
  assert reply.tabs.1.groups.6.commands.8.label is Clear
  assert reply.tabs.1.groups.6.commands.9.label is Reapply
  assert reply.tabs.1.groups.6.commands.10.label is Find & Select

test sheet Home Sort & Filter drop-down opens and runs Sort A to Z
  open ../fixtures/basic.xlsx
  click A2
  call menu-open {"target":{"ribbon":["Home","Editing","Sort & Filter"]}}
  call menu-read {}
  assert reply.open is true
  assert reply.items.0.label is Sort A to Z
  assert reply.items.2.label is Custom Sort...
  assert reply.items.5.label is Reapply
  call menu-click {"label":"Sort A to Z"}
  assert dirty is true
  assert cell A2 is East

test sheet Home Sort & Filter button opens its menu instead of running a placeholder
  open ../fixtures/basic.xlsx
  call ribbon-click {"tab":"Home","command":"Sort & Filter"}
  call menu-read {}
  assert reply.open is true
  assert reply.items.0.label is Sort A to Z

test sheet Home Sort & Filter menu ticks Filter while the filter is on
  open ../fixtures/basic.xlsx
  click B2
  call menu-open {"target":{"ribbon":["Home","Editing","Sort & Filter"]}}
  call menu-read {}
  assert reply.items.3.label is Filter
  assert reply.items.3.checked is false
  call menu-close {}
  key ctrl+shift+l
  call menu-open {"target":{"ribbon":["Home","Editing","Sort & Filter"]}}
  call menu-read {}
  assert reply.items.3.checked is true
  assert reply.items.0.checked is false

test sheet Home ribbon-click reaches a Sort & Filter menu item by id and by label
  open ../fixtures/basic.xlsx
  click B2
  call ribbon-click {"tab":"Home","command":"Sort Z to A"}
  assert cell B2 is 40
  click A2
  call ribbon-click {"tab":"Home","command":"sort-a-z"}
  assert cell A2 is East

test sheet Home Clear stays the AutoSum column's button
  open ../fixtures/basic.xlsx
  call ribbon-click {"tab":"Home","command":"Clear"}
  call menu-read {}
  assert reply.open is true
  assert reply.items.0.label is Clear All

test sheet Home has no Remove Duplicates and Data keeps it
  open ../fixtures/basic.xlsx
  call-error ribbon-click {"tab":"Home","command":"Remove Duplicates"} => command 'Remove Duplicates' is not on tab 'Home'
  call ribbon-read {}
  assert reply.tabs.5.groups.1.commands.2.label is Remove Duplicates

# The measured guard: each group records where its content landed, and
# ribbon-layout says whether it fits. A fourth button in a column makes
# clipped_v true.
test sheet Home ribbon: no group is clipped vertically
  open ../fixtures/basic.xlsx
  call window-size {"w":1400,"h":800}
  shot window
  call ribbon-layout {}
  assert reply.tab is Home
  assert reply.groups.6.title is Editing
  # Not vacuous: Editing has a column, so its content was measured.
  assert reply.groups.6.content_bounds is not null
  assert reply.any_clipped_v is false

# Excel's Page Layout and Formulas tabs (#1019), between Insert and Data, with
# Excel's KeyTips.
test sheet ribbon lists Excel's tabs
  open ../fixtures/basic.xlsx
  call ribbon-read {}
  assert reply.tab_count is 9
  assert reply.tabs.3.name is Page Layout
  assert reply.tabs.3.key_tip is P
  assert reply.tabs.4.name is Formulas
  assert reply.tabs.4.key_tip is M
  assert reply.tabs.5.name is Data
  assert reply.tabs.3.groups.0.title is Themes
  assert reply.tabs.3.groups.1.title is Page Setup
  assert reply.tabs.3.groups.2.title is Scale to Fit
  assert reply.tabs.3.groups.3.title is Sheet Options
  assert reply.tabs.3.groups.4.title is Arrange
  assert reply.tabs.4.groups.0.title is Function Library
  assert reply.tabs.4.groups.1.title is Defined Names
  assert reply.tabs.4.groups.2.title is Formula Auditing
  assert reply.tabs.4.groups.3.title is Calculation
  # Themes waits for an engine; Margins opens its menu.
  assert reply.tabs.3.groups.0.commands.0.enabled is false
  assert reply.tabs.3.groups.1.commands.0.label is Margins
  assert reply.tabs.3.groups.1.commands.0.enabled is true

test KeyTips open the new tabs
  open ../fixtures/basic.xlsx
  key alt p
  assert ribbon_tab is Page Layout
  shot window
  # The first Escape steps back to the tab KeyTips, the second leaves them.
  key escape
  key escape
  key alt m
  assert ribbon_tab is Formulas
  shot window
  key escape
  key escape

test a wired Page Layout command works from the ribbon
  open copy:"../fixtures/basic.xlsx" as pl.xlsx
  click A1
  click C5 shift
  call ribbon-click {"tab":"Page Layout","command":"Set Print Area"}
  assert ribbon_tab is Page Layout
  assert dirty is true
  key ctrl+z
  call ribbon-click {"tab":"Page Layout","command":"Landscape"}
  call menu-open {"target":{"ribbon":["Page Layout","Page Setup","Orientation"]}}
  assert reply.items.0.label is Portrait
  assert reply.items.0.checked is false
  assert reply.items.1.checked is true
  call menu-close {}

test a Page Layout command that changes nothing leaves the workbook clean
  open copy:"../fixtures/basic.xlsx" as clean.xlsx
  call ribbon-click {"tab":"Page Layout","command":"Clear Print Area"}
  assert dirty is false
  call ribbon-click {"tab":"Page Layout","command":"Portrait"}
  assert dirty is false

test Print Gridlines is a check box that follows the sheet
  open copy:"../fixtures/basic.xlsx" as grid.xlsx
  click B2
  call ribbon-read {}
  assert reply.tabs.3.groups.3.commands.2.id is print-gridlines
  assert reply.tabs.3.groups.3.commands.2.checked is false
  call ribbon-click {"tab":"Page Layout","command":"Print Gridlines"}
  assert dirty is true
  call ribbon-read {}
  assert reply.tabs.3.groups.3.commands.2.checked is true
  key ctrl+z
  call ribbon-read {}
  assert reply.tabs.3.groups.3.commands.2.checked is false

test Scale to Fit Width fits the sheet to pages through its menu
  open copy:"../fixtures/basic.xlsx" as fit.xlsx
  call menu-open {"target":{"ribbon":["Page Layout","Scale to Fit","Width:"]}}
  assert reply.items.0.label is Automatic
  assert reply.items.0.checked is true
  call menu-click {"label":"1 page"}
  assert dirty is true
  call menu-open {"target":{"ribbon":["Page Layout","Scale to Fit","Width:"]}}
  assert reply.items.1.checked is true
  assert reply.items.0.checked is false
  call menu-close {}
  call menu-open {"target":{"ribbon":["Page Layout","Scale to Fit","Scale:"]}}
  call menu-click {"label":"75%"}
  call menu-open {"target":{"ribbon":["Page Layout","Scale to Fit","Width:"]}}
  assert reply.items.0.checked is true
  call menu-close {}

test Page Setup opens from Print Titles and refuses a scale outside 10-400
  open copy:"../fixtures/basic.xlsx" as setup.xlsx
  call ribbon-click {"tab":"Page Layout","command":"Print Titles"}
  call dialog-read {}
  assert reply.title is Page Setup
  # Print Titles opens it on its Sheet tab; OK and Cancel show on every tab.
  call-error dialog-set {"control":"scale","value":"5"} => '% normal size' is on the 'Page' tab; switch with dialog-tab first
  call dialog-tab {"tab":"Page"}
  call dialog-set {"control":"scale","value":"5"}
  call-error dialog-click {"button":"OK"} => scale 5 is outside 10–400
  assert dirty is false
  call dialog-set {"control":"scale","value":"80"}
  call dialog-tab {"tab":"Sheet"}
  call dialog-set {"control":"title-rows","value":"$1:$1"}
  call dialog-click {"button":"OK"}
  assert dirty is true

test an untouched Page Setup OK leaves the workbook clean
  open copy:"../fixtures/basic.xlsx" as untouched.xlsx
  call ribbon-click {"tab":"Page Layout","command":"Custom Margins..."}
  call dialog-read {}
  assert reply.title is Page Setup
  call dialog-click {"button":"OK"}
  assert dirty is false

test Formulas AutoSum and its menu write the function over the run above
  open copy:"../fixtures/basic.xlsx" as sum.xlsx
  click B6
  call ribbon-click {"tab":"Formulas","command":"AutoSum"}
  assert dirty is true
  assert cell B6 is 100
  click C6
  call menu-open {"target":{"ribbon":["Formulas","Function Library","AutoSum"]}}
  assert reply.items.1.label is Average
  call menu-click {"label":"Max"}
  assert cell C6 is 44

test a placeholder on the new tabs is refused as not implemented
  open ../fixtures/basic.xlsx
  call-error ribbon-click {"tab":"Formulas","command":"Trace Precedents"} => 'Trace Precedents' is not implemented
  call-error ribbon-click {"tab":"Page Layout","command":"Themes"} => 'Themes' is not implemented
