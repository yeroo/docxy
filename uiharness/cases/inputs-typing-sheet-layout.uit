test sheet page-setup/scale: copies
  open ../fixtures/basic.xlsx
  call ribbon-click {"tab":"Page Layout","command":"Print Titles"}
  assert dialog is page-setup
  call dialog-catalog-check {}
  call pointer-click {"dialog-tab":"Page"}
  call clipboard {"action":"write","text":"before"}
  call pointer-click {"dialog-field":"scale"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"1234"}
  call real-key {"key":"ctrl+a"}
  call real-key {"key":"ctrl+c"}
  call clipboard {"action":"read"}
  assert reply.text is 1234
  call real-key {"key":"escape"}

test sheet page-setup/scale: OK applies
  open ../fixtures/basic.xlsx
  call ribbon-click {"tab":"Page Layout","command":"Print Titles"}
  assert dialog is page-setup
  call dialog-catalog-check {}
  call pointer-click {"dialog-tab":"Page"}
  call pointer-click {"dialog-field":"scale"}
  call real-key {"key":"ctrl+a"}
  call real-type {"text":"80"}
  call real-key {"key":"enter"}
  assert dialog is not page-setup
  call ribbon-click {"tab":"Page Layout","command":"Print Titles"}
  assert dialog is page-setup
  call dialog-catalog-check {}
  call pointer-click {"dialog-tab":"Page"}
  call field-read {"dialog-field":"scale"}
  assert reply.value is 80
  call real-key {"key":"escape"}

