# UI plugins in the desktop suite (#1532). The `plugin` line copies the test
# fixture (projcore/tests/plugin_fixture, built beside uiharness by
# `cargo build --release -p uiharness -p plugin_fixture`) into the sandbox's
# docxy/plugins before the suite starts. Besides its `.fakeproj` format the
# fixture carries a version target (0.1.*, this host) and the UI symbols
# with one of everything: on the Task tab a group "Fixture" with a large
# button, a toggle and a two-swatch gallery; a row-menu item after Notes...;
# a Task Information page with a multiline and a grid; a dialog the button
# opens; an overlay line between the first two bars; and `fixture.rename`,
# one `task.set` op. Each case opens its own copy of project-clipboard.xml
# (tasks A and B).

plugin yppx_fixture

test app-info lists the fixture as a loaded UI plugin with its commands
  open copy:../fixtures/project-clipboard.xml
  call app-info {}
  assert reply.plugins.loaded.0.formats.0 is fakeproj
  assert reply.plugins.loaded.0.ui is true
  assert reply.plugins.loaded.0.built_against is fixture
  assert reply.plugins.ui.0.commands.0 is fixture.hello
  assert reply.plugins.skipped is []

test the manifest's group is drawn after the Task tab's own, its controls marked plugin
  open copy:../fixtures/project-clipboard.xml
  call ribbon-read {}
  # File, then Task: its last group is the fixture's.
  assert reply.tabs.1.name is Task
  assert reply.tabs.1.groups.-1.title is Fixture
  assert reply.tabs.1.groups.-1.commands.0.id is fixture.hello
  assert reply.tabs.1.groups.-1.commands.0.label is Hello
  assert reply.tabs.1.groups.-1.commands.0.tip.title is Say hello from the fixture
  assert reply.tabs.1.groups.-1.commands.0.key_tip is XH
  assert reply.tabs.1.groups.-1.commands.0.plugin is true
  assert reply.tabs.1.groups.-1.commands.1.id is fixture.flag
  assert reply.tabs.1.groups.-1.commands.1.checked is false
  assert reply.tabs.1.groups.-1.galleries.0.id is fixture.palette
  assert reply.tabs.1.groups.-1.galleries.0.items.0 is Blue
  assert reply.tabs.1.groups.-1.galleries.0.items.1 is Red

test a contributed group goes before the built-in group its manifest names
  # The fixture's "Fixture Format" group asks for `before: Bar Styles` on the
  # Gantt Chart Format tab (#1574); without the hint a new group is appended.
  open copy:../fixtures/project-clipboard.xml
  call ribbon-read {}
  assert reply.tabs.-1.name is Gantt Chart Format
  assert reply.tabs.-1.groups.0.title is Fixture Format
  assert reply.tabs.-1.groups.0.commands.0.id is fixture.format
  assert reply.tabs.-1.groups.0.commands.0.plugin is true
  assert reply.tabs.-1.groups.1.title is Bar Styles
  call ribbon-click {"tab":"Gantt Chart Format","command":"fixture.format"}
  assert status is Fixture: format

test a toggle runs its command and reads back checked as the plugin says
  open copy:../fixtures/project-clipboard.xml
  assert dirty is false
  call ribbon-click {"tab":"Task","command":"fixture.flag"}
  assert status is Fixture: flag on
  call ribbon-read {}
  assert reply.tabs.1.groups.-1.commands.1.checked is true
  # The toggle is a view switch stored in the plan's formatting (#1553): the
  # plan is dirty, the switch survives a save as .yppx and a reload, and undo
  # takes it back.
  assert dirty is true
  call save-as {"path":"flagged","format":"yppx"}
  assert dirty is false
  call proj.reload {}
  call ribbon-read {}
  assert reply.tabs.1.groups.-1.commands.1.checked is true
  call ribbon-click {"tab":"Task","command":"fixture.flag"}
  assert status is Fixture: flag off
  call ribbon-read {}
  assert reply.tabs.1.groups.-1.commands.1.checked is false
  key ctrl+z
  call ribbon-read {}
  assert reply.tabs.1.groups.-1.commands.1.checked is true

test a Bold toggle styles the selected cell and reads its state from the view's cells
  # The view JSON carries the selected cells' styles (#1572): the fixture's
  # Bold writes view.cells and shows checked where the cursor cell is bold.
  open copy:../fixtures/project-clipboard.xml
  click C2
  call ribbon-read {}
  assert reply.tabs.1.groups.-1.commands.-2.id is fixture.bold
  assert reply.tabs.1.groups.-1.commands.-2.checked is false
  call ribbon-click {"tab":"Task","command":"fixture.bold"}
  assert status is Fixture: bold on
  assert dirty is true
  call ribbon-read {}
  assert reply.tabs.1.groups.-1.commands.-2.checked is true
  click C1
  call ribbon-read {}
  assert reply.tabs.1.groups.-1.commands.-2.checked is false
  click C2
  call ribbon-read {}
  assert reply.tabs.1.groups.-1.commands.-2.checked is true
  call ribbon-click {"tab":"Task","command":"fixture.bold"}
  assert status is Fixture: bold off
  call ribbon-read {}
  assert reply.tabs.1.groups.-1.commands.-2.checked is false

test a swatch sets the plan's palette (an edit) and the gallery follows
  open copy:../fixtures/project-clipboard.xml
  assert dirty is false
  call ribbon-read {}
  assert reply.tabs.1.groups.-1.commands.2.id is fixture.palette:Blue
  assert reply.tabs.1.groups.-1.commands.2.checked is true
  call ribbon-click {"tab":"Task","command":"fixture.palette:Red"}
  assert status is Fixture: palette fixture.red
  assert dirty is true
  call ribbon-read {}
  assert reply.tabs.1.groups.-1.commands.3.id is fixture.palette:Red
  assert reply.tabs.1.groups.-1.commands.3.checked is true
  assert reply.tabs.1.groups.-1.commands.2.checked is false

test the button's command opens the plugin's dialog, whose OK sends the values back
  open copy:../fixtures/project-clipboard.xml
  click C1
  call ribbon-click {"tab":"Task","command":"Hello"}
  assert dialog is plugin
  call dialog-read {}
  assert reply.title is Fixture Options
  assert reply.controls.0.name is n
  assert reply.controls.0.kind is number
  assert reply.controls.0.value is 1
  assert reply.controls.0.plugin is true
  assert reply.buttons.0.label is OK
  assert reply.buttons.1.label is Cancel
  assert reply.buttons.2.id is bump
  # The label follows the number: a control change applies the state's
  # labels (#1610), and the task's name from the plan.
  assert reply.controls.1.name is fixture.echo
  assert reply.controls.1.kind is label
  assert reply.controls.1.value is Number 1 for A
  # The grid lists the plan's tasks with the selected one's row selected
  # (the state's name.selected_row).
  assert reply.controls.2.name is fixture.tasks
  assert reply.controls.2.rows.0.0 is A
  assert reply.controls.2.selected_row is 0
  call dialog-set {"control":"n","value":7}
  call dialog-read {}
  assert reply.controls.1.value is Number 7 for A
  # Bump renames the task under the modal dialog: the plan moved, so the
  # state's values apply (the label), while the typed number stays.
  call dialog-click {"button":"Bump"}
  assert dialog is plugin
  assert status is Fixture: bumped task 1
  call dialog-read {}
  assert reply.controls.0.value is 7
  assert reply.controls.1.value is Number 7 for Bumped by fixture
  # The modal dialog's grid shows the renamed task and keeps its row.
  assert reply.controls.2.rows.0.0 is Bumped by fixture
  assert reply.controls.2.selected_row is 0
  call dialog-click {"button":"OK"}
  assert dialog is none
  assert status is Fixture: hello 7
  assert selected_name is Bumped by fixture
  key ctrl+z
  assert selected_name is A
  # Cancel sends nothing.
  call ribbon-click {"tab":"Task","command":"Hello"}
  assert dialog is plugin
  call dialog-click {"button":"Cancel"}
  assert dialog is none
  assert status is Fixture: asking

test the row menu's item comes after Notes..., needs a task and renames it as one undo step
  open copy:../fixtures/project-clipboard.xml
  click C2
  assert selected_name is B
  call menu-open {"target":{"row":2}}
  call menu-read {}
  # After Notes..., before Add to Timeline, as the manifest's `after` says.
  assert reply.items.19.label is Notes...
  assert reply.items.20.label is Rename (fixture)
  assert reply.items.20.plugin is true
  assert reply.items.20.enabled is true
  assert reply.items.21.label is Add to Timeline
  call menu-click {"label":"Rename (fixture)"}
  assert selected_name is Renamed by fixture
  assert status is Fixture: renamed task 2
  # A shift+down range reaches the command whole (#1571): the status counts
  # the two selected tasks, and the range is still there afterwards.
  key ctrl+z
  click C1
  key shift+down
  call menu-open {"target":{"row":1}}
  call menu-click {"label":"Rename (fixture)"}
  assert status is Fixture: renamed task 2 of 2 selected
  call proj.path {}
  assert reply.selection is 2
  assert dirty is true
  key ctrl+z
  assert selected_name is B
  # On the entry row there is no task: the item is disabled.
  click C3
  call menu-open {"target":{"row":null}}
  call menu-read {}
  assert reply.items.20.label is Rename (fixture)
  assert reply.items.20.enabled is false
  key escape

test the chart menu opens beside the bars with Project's unbuilt items greyed
  open copy:../fixtures/project-clipboard.xml
  call menu-open {"target":"chart"}
  call menu-read {}
  assert reply.target is chart
  # #1535: the timescale and zoom dialogs lead the menu and are live.
  assert reply.items.0.label is Timescale...
  assert reply.items.0.enabled is true
  assert reply.items.1.label is Zoom...
  assert reply.items.1.enabled is true
  assert reply.items.5.label is Gridlines...
  assert reply.items.5.enabled is false
  key escape

test Task Information gains the plugin's page, prefilled, with a multiline and a grid
  open copy:../fixtures/project-clipboard.xml
  click C2
  key alt t c
  assert dialog is task-information
  call dialog-read {}
  assert reply.tabs.5 is Fixture
  call dialog-tab {"tab":"Fixture"}
  call dialog-read {}
  # The top row (Name, Duration, Estimated) is on every page, so the page's
  # own controls follow it (#1536).
  assert reply.controls.0.name is name
  assert reply.controls.1.name is duration
  assert reply.controls.2.name is estimated
  assert reply.controls.3.name is fixture.note
  assert reply.controls.3.kind is multiline
  assert reply.controls.3.value is note for task 2
  assert reply.controls.3.plugin is true
  assert reply.controls.4.name is fixture.grid
  assert reply.controls.4.kind is grid
  assert reply.controls.4.columns.1 is Done
  assert reply.controls.4.column_kinds.1 is checkbox
  assert reply.controls.4.rows.1.0 is 2
  assert reply.controls.4.rows.1.1 is true
  # A grid cell by its address, checked against the column's kind.
  call dialog-set {"control":"fixture.grid[1].Done","value":false}
  call dialog-read {}
  assert reply.controls.4.rows.1.1 is false
  call-error dialog-set {"control":"fixture.grid[1].Done","value":"maybe"} => takes true or false
  # The dropdown's items and a greyed control come from the state for this
  # opening (#1556): the manifest's "none" is replaced by the plan's items.
  assert reply.controls.5.name is fixture.pick
  assert reply.controls.5.kind is dropdown
  assert reply.controls.5.items.0 is task
  assert reply.controls.5.items.1 is 2
  assert reply.controls.5.value is 2
  call-error dialog-set {"control":"fixture.pick","value":"none"} => has no item
  call dialog-set {"control":"fixture.pick","value":"task"}
  assert reply.controls.5.value is task
  assert reply.controls.6.name is fixture.locked
  assert reply.controls.6.enabled is false
  # Enter in the multiline is a new line, not OK.
  call pointer-click {"dialog-field":"fixture.note"}
  call real-key {"key":"end"}
  call real-key {"key":"enter"}
  call real-type {"text":"more"}
  assert dialog is task-information
  call field-read {"dialog-field":"fixture.note"}
  assert reply.caret is 20
  # The catalogue check leaves the plugin's controls out.
  call dialog-catalog-check {}
  assert reply.id is task-information
  call dialog-click {"button":"OK"}
  assert dialog is none
  assert status is Fixture: note saved (20 chars)

test the overlay returns the fixture's shapes for the chart
  open copy:../fixtures/project-clipboard.xml
  call project-overlay {}
  assert reply.count is 4
  assert reply.shapes.0.kind is text
  assert reply.shapes.0.text is fixture
  assert reply.shapes.1.kind is polyline
  assert reply.shapes.2.kind is arrow
  # The request carries the selection, and the overlay follows the cursor
  # (#1565): the fixture labels the selected task's bar.
  assert reply.shapes.3.kind is text
  click C2
  call project-overlay {}
  assert reply.count is 4
  assert reply.shapes.3.text is selected 2
  click C1
  call project-overlay {}
  assert reply.shapes.3.text is selected 1

test the overlay follows a collapsed summary
  # The shapes are cached by the plan's revision, the scale, the view's
  # switches and the shown rows: collapsing a summary changes no plan but
  # hides rows, and the overlay is asked again.
  # (The fourth shape is the selected task's label, #1565.)
  open ../fixtures/gantt-summary.xml
  call project-overlay {}
  assert reply.count is 4
  click C1
  call ribbon-click {"tab":"View","command":"Hide Subtasks"}
  call project-overlay {}
  assert reply.count is 2
  assert reply.shapes.0.kind is text
  call ribbon-click {"tab":"View","command":"Show Subtasks"}
  call project-overlay {}
  assert reply.count is 4

test a modeless dialog with a grid and buttons of its own follows the plan and re-asks its state
  # The fixture's Sheet (#1602): no backdrop, so the document under it still
  # takes verbs and presses; its rows follow the plan; a change of its
  # controls asks the plugin's state again (Clear enables with a pick);
  # Apply sends the command with the button's id and stays open; Clear
  # closes from the reply.
  open copy:../fixtures/project-clipboard.xml
  call ribbon-click {"tab":"Task","command":"fixture.sheet"}
  assert dialog is plugin
  assert status is Fixture: sheet
  call dialog-read {}
  assert reply.title is Fixture Sheet
  assert reply.modeless is true
  assert reply.active is true
  assert reply.buttons.0.id is apply
  assert reply.buttons.0.label is Apply
  assert reply.buttons.0.default is true
  assert reply.buttons.1.id is clear
  assert reply.buttons.1.enabled is false
  assert reply.buttons.2.id is close
  assert reply.controls.0.name is fixture.rows
  assert reply.controls.0.kind is grid
  assert reply.controls.0.column_kinds.0 is check
  assert reply.controls.0.column_kinds.2 is number
  assert reply.controls.0.rows.0.1 is A
  assert reply.controls.0.rows.1.1 is B
  assert reply.controls.0.selected_row is null
  # An edit behind the dialog: it stays, and its rows follow the plan.
  call task.set {"uid":1,"name":"Renamed under the sheet"}
  assert dialog is plugin
  call dialog-read {}
  assert reply.controls.0.rows.0.1 is Renamed under the sheet
  # A press in the table takes the keyboard; a dialog verb gives it back.
  click C2
  call dialog-read {}
  assert reply.active is false
  call dialog-select {"control":"fixture.rows","row":1}
  call dialog-read {}
  assert reply.active is true
  assert reply.controls.0.selected_row is 1
  assert reply.buttons.1.enabled is false
  call dialog-set {"control":"fixture.rows[1].Pick","value":true}
  call dialog-read {}
  assert reply.controls.0.rows.1.0 is true
  assert reply.buttons.1.enabled is true
  # Typing into the Units cell: Right twice reaches it, Enter commits.
  call real-key {"key":"right"}
  call real-key {"key":"right"}
  call dialog-read {}
  assert reply.controls.0.column is 2
  call real-type {"text":"50"}
  call dialog-read {}
  assert reply.controls.0.editing is 50
  call real-key {"key":"enter"}
  call dialog-read {}
  assert reply.controls.0.editing is null
  assert reply.controls.0.rows.1.2 is 50
  assert dialog is plugin
  # Space toggles the check cell back and forth.
  call real-key {"key":"left"}
  call real-key {"key":"left"}
  call real-key {"key":"space"}
  call dialog-read {}
  assert reply.controls.0.rows.1.0 is false
  assert reply.buttons.1.enabled is false
  call real-key {"key":"space"}
  # The grid commits through the command (commit_command): a Name cell typed
  # and entered renames the task at once, no button pressed, and the rows
  # follow the plan.
  call dialog-select {"control":"fixture.rows","row":0}
  call real-key {"key":"right"}
  call real-type {"text":"Z"}
  call real-key {"key":"enter"}
  assert dialog is plugin
  assert status is Fixture: renamed row 0
  call task.get {"uid":1}
  assert reply.name is Z
  call dialog-read {}
  assert reply.controls.0.rows.0.1 is Z
  assert reply.controls.0.rows.1.0 is true
  call dialog-select {"control":"fixture.rows","row":1}
  # Apply: the command gets the button and the values; the dialog stays.
  call dialog-click {"button":"apply"}
  assert dialog is plugin
  assert status is Fixture: applied 1 picked, row 1
  # Clear closes it from the reply.
  call dialog-click {"button":"Clear"}
  assert dialog is none
  assert status is Fixture: cleared
