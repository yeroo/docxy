# #1535: the grip under the Timeline sets its height (one band at least, half
# the window at most); a double-click restores the default 84. The height is
# window view state, never saved. Not run on macOS.
# project-timeline.xml.

test project dragging the grip sets the Timeline height and a double-click restores it
  open ../fixtures/project-timeline.xml
  shot window
  assert timeline_h is 84
  call pointer-drag {"from":"project-timeline-grip","to":"project-timeline-grip","offset":[0,40]}
  assert timeline_h is 124
  shot window
  call pointer-drag {"from":"project-timeline-grip","to":"project-timeline-grip","offset":[0,-500]}
  assert timeline_h is 60
  call pointer-click {"region":"project-timeline-grip","double":true}
  assert timeline_h is 84
  assert dirty is false

test project the grip stops at half the window and follows the window's height
  open ../fixtures/project-timeline.xml
  call window-size {"w":1180,"h":800}
  shot window
  call pointer-drag {"from":"project-timeline-grip","to":"project-timeline-grip","offset":[0,3000]}
  assert timeline_h is 400
  shot window
  # A shorter window pulls the pane back to its half.
  call window-size {"w":1180,"h":500}
  shot window
  assert timeline_h is 250
