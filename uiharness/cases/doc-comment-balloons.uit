# Comment balloons, as classic Word's All Markup draws them (#2232).
#
# `fixtures/comments.docx` (generated by `ext_fixture::comments_docx`) has
# five comments by two made-up reviewers: three open (1 by Avery Lane on
# "near", 2 by Robin Hale on "words", the next word on the same short line,
# and 3 by Robin Hale from "range", block 3's last word, to "ends" in block
# 4, its remark long, its reference run in a tracked insertion) and two
# resolved (0 and 4). `comments-plain.docx` is the same text with no
# comment.
#
# `doc`'s `comments` is the markup area as last painted (window px): each
# balloon's painted rect, its painted anchor (the reference mark's
# zero-width span, its line's top) and its connector. `stacked_ok` is
# computed from the painted rects, not from the layout's numbers: a balloon
# sits at its anchor's line top or below the balloon before it (+6 px), and
# none overlaps. `connectors_ok`: each balloon has a painted anchor and a
# connector, which turns on the page's (Print Layout) or the text column's
# (Web Layout) right edge as the ruler probe painted it, with the anchor
# left of that edge and the balloon right of it. A `w:date` is local wall
# time and is shown as written, so the dates do not depend on the zone.
# Each read follows a `shot`, which waits for the frame (balloons are laid
# out from the frame before).
#
# That the text is laid out as without comments (in Print Layout, which the
# markup area does not narrow) depends on the OS's fonts' line breaks:
# `doc-comment-balloons-layout.uit`, Linux only.

test issue 2232 balloons show on open in Web Layout
  open copy:../fixtures/comments.docx
  call window-size {"w":1300,"h":900}
  call theme-set {"theme":"light"}
  assert view.layout is web
  shot window
  call doc {}
  assert reply.view.comments_pane is false
  assert reply.comments.markup is true
  assert reply.comments.view is web
  assert reply.comments.count is 3
  assert reply.comments.resolved_hidden is 2
  assert reply.comments.stacked_ok is true
  assert reply.comments.connectors_ok is true
  assert reply.comments.all_readable is true
  # Body order; the resolved 0 and 4 have none.
  assert reply.comments.balloons.0.id is 1
  assert reply.comments.balloons.0.author is Avery Lane
  assert reply.comments.balloons.0.date is November 17, 2026 at 6:41 PM
  assert reply.comments.balloons.0.text is Is this the right word?
  assert reply.comments.balloons.0.fill is fbe3e3
  assert reply.comments.balloons.0.edge is c00000
  assert reply.comments.balloons.1.id is 2
  assert reply.comments.balloons.1.author is Robin Hale
  assert reply.comments.balloons.1.fill is ddebf7
  assert reply.comments.balloons.2.id is 3
  assert reply.comments.balloons.2.date is November 17, 2026 at 12:10 PM
  # Comment 3's reference run is in a tracked insertion (Word's shape with
  # Track Changes on): the painter draws it, so the balloon is anchored on
  # the reference itself, not on the range's end.
  assert reply.comments.balloons.2.anchor.kind is reference
  assert reply.comments.balloons.0.anchor.kind is reference
  # The first is level with its line; the second, on the same line, is
  # pushed below it.
  assert reply.comments.balloons.0.pushed is false
  assert reply.comments.balloons.1.pushed is true
  # The markup area is inside the scroll, right of the text: no sideways
  # scroll.
  assert reply.scroll.max_scroll_x is 0
  # No glyph in the text: the shaded runs read on their shade.
  assert reply.inks.all_readable is true
  assert reply.flow.layout.paragraphs.2.lines.0.text is Beta near words here.
  call theme-set {"theme":"auto"}

test issue 2232 the last balloon can be scrolled to
  open copy:../fixtures/comments.docx
  call window-size {"w":1300,"h":520}
  call theme-set {"theme":"light"}
  shot window
  call doc {}
  assert reply.comments.count is 3
  assert reply.comments.balloons.2.in_view is false
  call pointer-wheel {"region":"doc-line-start:0","dy":-6000}
  shot window
  call doc {}
  assert reply.comments.balloons.2.in_view is true
  assert reply.comments.stacked_ok is true
  assert reply.comments.connectors_ok is true
  call theme-set {"theme":"auto"}

test issue 2232 balloons show on open in Print Layout
  open copy:../fixtures/comments.docx
  call window-size {"w":1300,"h":900}
  call theme-set {"theme":"light"}
  call ribbon-click {"tab":"View","command":"Print Layout"}
  assert view.layout is print
  shot window
  call doc {}
  assert reply.comments.markup is true
  assert reply.comments.view is print
  assert reply.comments.count is 3
  assert reply.comments.stacked_ok is true
  assert reply.comments.connectors_ok is true
  assert reply.comments.balloons.0.page is 1
  assert reply.comments.balloons.0.pushed is false
  assert reply.comments.balloons.1.pushed is true
  assert reply.comments.balloons.2.anchor.kind is reference
  # The page moves left for the markup area: both are in view.
  assert reply.scroll.page_left_in_view is true
  assert reply.scroll.page_right_in_view is true
  # Scrolled, the balloons keep to their lines.
  call window-size {"w":1300,"h":600}
  call pointer-wheel {"region":"doc-line-start:0","dy":-120}
  shot window
  call doc {}
  assert reply.comments.stacked_ok is true
  assert reply.comments.connectors_ok is true
  call ribbon-click {"tab":"View","command":"Print Layout"}
  assert view.layout is web
  call theme-set {"theme":"auto"}

test issue 2232 a live preview keeps the markup area
  open copy:"../fixtures/comments.docx" as preview.docx
  call window-size {"w":1300,"h":900}
  call theme-set {"theme":"light"}
  call ribbon-click {"tab":"View","command":"Print Layout"}
  assert view.layout is print
  shot window
  call doc {}
  assert reply.comments.count is 3
  # Hovering the Insert Table grid draws the preview: the balloons stay,
  # and the page does not move back.
  call ribbon-click {"tab":"Insert","command":"table"}
  call table-grid {"cols":3,"rows":2}
  shot window
  assert preview.kind is grid
  call doc {}
  assert reply.comments.markup is true
  assert reply.comments.count is 3
  assert reply.comments.stacked_ok is true
  assert reply.comments.connectors_ok is true
  call table-grid {}
  call real-key {"key":"escape"}
  shot window
  assert preview is null
  call ribbon-click {"tab":"View","command":"Print Layout"}
  assert view.layout is web
  call theme-set {"theme":"auto"}

test issue 2232 balloons are All Markup's
  open copy:../fixtures/comments.docx
  call window-size {"w":1300,"h":900}
  shot window
  call ribbon-click {"tab":"Review","command":"markupsimple"}
  shot window
  call doc {}
  assert reply.comments.markup is false
  assert reply.comments.count is 0
  call ribbon-click {"tab":"Review","command":"markupnone"}
  shot window
  call doc {}
  assert reply.comments.markup is false
  call ribbon-click {"tab":"Review","command":"markuporiginal"}
  shot window
  call doc {}
  assert reply.comments.markup is false
  call ribbon-click {"tab":"Review","command":"markupall"}
  shot window
  call doc {}
  assert reply.comments.markup is true
  assert reply.comments.count is 3

test issue 2232 Show Comments hides the balloons of its tab only
  open copy:"../fixtures/comments.docx" as show-a.docx
  call window-size {"w":1300,"h":900}
  shot window
  call ribbon-click {"tab":"Review","command":"showcomments"}
  shot window
  call doc {}
  assert reply.comments.markup is false
  # Another document's balloons show.
  open copy:"../fixtures/comments.docx" as show-b.docx
  shot window
  call doc {}
  assert reply.comments.markup is true
  assert reply.comments.count is 3
  # Back on the first, they stay hidden.
  call tab-select {"tab":"show-a.docx"}
  shot window
  call doc {}
  assert reply.comments.markup is false
  call ribbon-click {"tab":"Review","command":"showcomments"}
  shot window
  call doc {}
  assert reply.comments.markup is true

test issue 2232 a balloon selects its comment, resolves and deletes it
  open copy:../fixtures/comments.docx
  call window-size {"w":1300,"h":900}
  shot window
  call pointer-click {"region":"balloon:2"}
  shot window
  call doc {}
  assert reply.comments.balloons.1.selected is true
  assert reply.comments.balloons.0.selected is false
  assert reply.comments.connectors_ok is true
  # Review > Resolve acts on it: it leaves the margin.
  call ribbon-click {"tab":"Review","command":"resolvecomment"}
  shot window
  call doc {}
  assert reply.comments.count is 2
  assert reply.comments.resolved_hidden is 3
  assert reply.comments.balloons.1.id is 3
  # Its own Resolve button.
  call pointer-click {"region":"balloon-resolve:3"}
  shot window
  call doc {}
  assert reply.comments.count is 1
  # Its own delete button.
  call pointer-click {"region":"balloon-delete:1"}
  shot window
  call doc {}
  assert reply.comments.markup is false
  assert reply.comments.count is 0

test issue 2232 balloons on the dark page
  open copy:../fixtures/comments.docx
  call window-size {"w":1300,"h":900}
  call theme-set {"theme":"dark"}
  assert reply.applied is dark
  shot window
  call doc {}
  assert reply.page_mode is dark
  assert reply.comments.count is 3
  assert reply.comments.all_readable is true
  assert reply.inks.all_readable is true
  assert reply.comments.balloons.0.fill is 5e2d2d
  call ribbon-click {"tab":"View","command":"Print Layout"}
  shot window
  call doc {}
  assert reply.comments.all_readable is true
  assert reply.comments.stacked_ok is true
  assert reply.comments.connectors_ok is true
  call ribbon-click {"tab":"View","command":"Print Layout"}
  call theme-set {"theme":"auto"}
