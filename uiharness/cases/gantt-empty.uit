test empty gantt indent is a no-op
  open ../fixtures/gantt-empty.xml
  assert tasks is 0
  assert dirty is false
  key alt p b
  assert dirty is false
  key tab shift+tab
  assert status is loaded — 0 tasks
  key ctrl+z
  assert status is Nothing to undo
  key ctrl+y
  assert dirty is false
  assert tasks is 0
  assert status is Nothing to redo
  shot window
