// Windows resources for suite.exe. Icon id 1 (the lowest) is what Explorer,
// the taskbar, and Alt-Tab use as the application icon.
1 ICON "assets/docxy.ico"

// File properties (Explorer ▸ Properties ▸ Details).
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS 0x4L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "docxy"
            VALUE "FileDescription", "docxy - desktop document & spreadsheet suite"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "docxy"
            VALUE "OriginalFilename", "suite.exe"
            VALUE "ProductName", "docxy"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
