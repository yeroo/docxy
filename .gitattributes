# Normalize line endings: store LF in the repo on every platform.
* text=auto eol=lf
*.png binary
*.docx binary
*.doc binary
*.pdf binary
*.wmf binary
tools/comshim/docxy-excel.tlb binary
tools/wordshim/docxy-word.tlb binary

# Batch files are run by cmd.exe, which mis-parses multi-line blocks in an
# LF-only file. Check these out with CRLF whatever the global rule says.
*.cmd text eol=crlf
*.bat text eol=crlf

# Word-written import fixtures: keep the bytes Word wrote (CRLF in .rtf/.htm).
corpus/word-import/** -text
# A mail's base64 wrapped at 76 columns with CRLF, as mail clients wrap it (#1880).
docxcore/tests/fixtures/html/cid-message.html -text
# MPXJ-written MPX fixtures (#309): keep the CRLF records MPXJ wrote.
corpus/mpx/**/*.mpx -text
